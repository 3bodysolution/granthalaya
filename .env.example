# These live in Vercel → your project → Settings → Environment Variables.
# Never put real values in this file or in the code.
ADMIN_PASSWORD=choose-a-long-password
GITHUB_TOKEN=github_pat_...        # fine-grained token: only the granthalaya repo, Contents: Read and write
GITHUB_REPO=your-username/granthalaya
# Optional: better film search (free key from themoviedb.org). Without it, films are found via Wikipedia.
TMDB_API_KEY=
