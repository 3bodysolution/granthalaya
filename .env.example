# These live in Vercel → your project → Settings → Environment Variables (and in .env on your computer
# for `npm run dev` and the scripts). Never put real values in this file or in the code.

# Supabase → Connect (or Settings → Data API) and Settings → API Keys
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...            # server only: catalogue, account deletion, reports

# Cloudflare Turnstile (the quiet "are you a person?" check when a new shelf is made). Optional locally.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Film and TV search and posters (free key from themoviedb.org). Without it, films are found via Wikipedia and TV search is off.
TMDB_API_KEY=

# "Behind the film/book" facts, picked by a free AI model. Gemini from aistudio.google.com, or Groq from console.groq.com.
GEMINI_API_KEY=
GROQ_API_KEY=
