---
import Base from '../../../layouts/Base.astro';
import CollectionCard from '../../../components/CollectionCard.astro';
import ShelfStrip from '../../../components/ShelfStrip.astro';
import { openShelf } from '../../../lib/shelfpage';
import { loadShelf, loadCollections } from '../../../lib/data';
export const prerender = false;

const o = await openShelf(Astro, '/collections/');
if (o.out) return o.out;
const { profile, isMe, visible } = o.shelf;
if (!visible) return Astro.redirect(`/@${profile.username}/`);
const sb = Astro.locals.supabase;
const [entries, collections] = await Promise.all([loadShelf(sb, profile), loadCollections(sb, profile)]);
const name = profile.display_name || profile.username;
---
<Base title={isMe ? 'Your collections' : `${name}’s collections`} shelf={profile.username} feed={!profile.is_private} description={`Hand-picked paths through ${name}’s library.`}>
  <div class="art melt settle banner bleed" style="--day: url(/art/threads-day.webp); --night: url(/art/threads-night.webp)" aria-hidden="true"></div>
  <section class="pad head rise">
    <h1 class="title">Collections</h1>
    <p class="lede">Books and films that go well together, in the order {isMe ? 'I’d' : 'they’d'} take them.</p>
    {isMe && (
      <form class="newc" data-new-col>
        <input class="field" name="name" maxlength="120" placeholder="Name a new collection" aria-label="Name a new collection" required />
        <button class="btn primary" type="submit">Make it</button>
      </form>
    )}
  </section>
  <div class="pad rise d1" style="padding-top: 26px"><ShelfStrip shelf={o.shelf} current="collections" /></div>
  {collections.length === 0 && <p class="pad muted" style="padding-top: 32px; font-size: 16px">{isMe ? 'No collections yet. Make one above, or use “Add to a collection” on any film, show, book or essay.' : `${name} hasn’t made any collections yet.`}</p>}
  <section class="pad grid">
    {collections.map((t, i) => <div class="rise" style={`animation-delay: ${(0.15 + i * 0.08).toFixed(2)}s`}><CollectionCard collection={t} entries={entries} /></div>)}
  </section>
</Base>

<style>
  .banner { height: clamp(220px, 27vw, 400px); background-position: center 70%; }
  .head { margin-top: -20px; position: relative; display: flex; flex-direction: column; gap: 12px; }
  .newc { display: flex; gap: 8px; max-width: 480px; margin-top: 8px; }
  .newc .field { height: 44px; }
  .grid { padding-top: 40px; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .grid > div > :global(a) { height: 100%; }
  @media (max-width: 1100px) { .grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 780px) { .banner { height: 190px; } .head { margin-top: -8px; } .grid { grid-template-columns: 1fr; } }
</style>

<script>
  import { navigate } from 'astro:transitions/client';
  document.addEventListener('submit', async (ev) => {
    const f = ev.target as HTMLFormElement;
    if (!f.matches('[data-new-col]')) return;
    ev.preventDefault();
    const name = (f.elements.namedItem('name') as HTMLInputElement).value.trim();
    if (!name) return;
    const b = f.querySelector('button')!;
    b.disabled = true;
    const r = await fetch('/api/collection', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'create', name }) }).then((x) => x.json()).catch(() => ({}));
    if (r.ok) navigate(r.href + '?edit=1'); else b.disabled = false;
  }, true);
</script>
