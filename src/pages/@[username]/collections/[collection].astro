---
import Base from '../../../layouts/Base.astro';
import Cover from '../../../components/Cover.astro';
import CollectionCard from '../../../components/CollectionCard.astro';
import Face from '../../../components/Face.astro';
import { openShelf } from '../../../lib/shelfpage';
import { md } from '../../../lib/md';
import { loadShelf, loadCollections, href, palette, kind, typeColor, minutes, duration, aboutHours, fullTitle, titleAsEntry, type Entry } from '../../../lib/data';
import { titlePageHref } from '../../../lib/catalog/onsite';
export const prerender = false;

const slug = String(Astro.params.collection ?? '');
const o = await openShelf(Astro, `/collections/${slug}/`);
if (o.out) return o.out;
const { profile, isMe, visible } = o.shelf;
if (!visible) return Astro.redirect(`/@${profile.username}/`);
const sb = Astro.locals.supabase;
const [entries, collections] = await Promise.all([loadShelf(sb, profile), loadCollections(sb, profile)]);
const col = collections.find((t) => t.id === slug);
if (!col) { Astro.response.status = 404; return Astro.rewrite('/404'); }
const name = profile.display_name || profile.username;
const bySlug = new Map<string, Entry>();
for (const e of entries) if (!bySlug.has(e.id)) bySlug.set(e.id, e);
// each thing links to the owner's entry when it's on their shelf, otherwise to the film or book's own page
const path = col.data.items.map((i) => {
  const own = bySlug.get(i.slug);
  const e = own ?? titleAsEntry(i.title, profile.username);
  return { ...i, e, link: own ? href(own) : titlePageHref(i.title as any) ?? '#' };
});
const editing = isMe && Astro.url.searchParams.get('edit') === '1';
const n = (t: string) => path.filter((x) => x.e.data.type === t).length;
const plural = (k: number, w: string) => `${k} ${w}${k > 1 ? 's' : ''}`;
const total = path.reduce((s, x) => s + minutes(x.e), 0);
const meta = [plural(path.length, 'thing'), n('film') && plural(n('film'), 'film'), n('book') && plural(n('book'), 'book'), n('tv') && plural(n('tv'), 'TV season'), n('essay') && plural(n('essay'), 'essay'), aboutHours(total)].filter(Boolean).join(' · ');
const fan = path.slice(0, 3).map((x) => palette(x.e));
const others = collections.filter((t) => t.id !== col.id).slice(0, 3);
---
<Base title={`${col.data.title} · @${profile.username}`} shelf={profile.username} description={`A collection by ${name}: ${col.data.title}. ${meta}.`}>
  <section class="pad head">
    <div class="fan" aria-hidden="true">
      {fan[1] && <div class="wash f l" style={`background: ${fan[1].bg}`}></div>}
      {fan[2] && <div class="wash f r" style={`background: ${fan[2].bg}`}></div>}
      {fan[0] && <div class="wash f m" style={`background: ${fan[0].bg}`}><i style={`background: ${fan[0].accent}`}></i><b style={`background: ${fan[0].hill}`}></b></div>}
    </div>
    <a href={`/@${profile.username}/collections/`} class="by rise d2"><Face name={name} src={profile.avatar_url} size={24} /><span>A collection by {isMe ? 'you' : name}</span></a>
    {editing ? (
      <form class="edit-head" data-col-edit={col.uuid}>
        <label class="sr" for="cname">Name</label>
        <input id="cname" class="field serif ename" name="name" value={col.data.title} maxlength="120" required />
        <label class="sr" for="cintro">About this collection</label>
        <textarea id="cintro" class="field" name="intro" rows="3" maxlength="1000" placeholder="What ties these together? (optional)">{col.body}</textarea>
        <div class="row"><span class="saved muted" hidden>Saved</span><button class="btn primary" type="submit">Save name and intro</button></div>
      </form>
    ) : (
      <>
        <h1 class="serif rise d3 tt">{col.data.title}</h1>
        {col.body && <div class="serif rise d4 intro" set:html={md(col.body)} />}
      </>
    )}
    <div class="rise d4 row">
      <span class="num muted" style="font-size: 14px">{meta}</span>
      <button class="btn" data-copy={new URL(Astro.url.pathname, Astro.site).href}>Copy link</button>
      {isMe && (editing
        ? <a class="btn primary" href={Astro.url.pathname}>Done</a>
        : <a class="btn" href={`${Astro.url.pathname}?edit=1`}>Edit</a>)}
    </div>
    {isMe && path.length === 0 && !editing && <p class="muted empty-c">Nothing here yet. Use “Add to a collection” on any film, book or entry.</p>}
  </section>

  <div class="path">
    <div class="line" aria-hidden="true"></div>
    <ol aria-label="Suggested order">
      {path.map((x, i) => (
        <li>
          {editing ? (
            <div class="step edit" data-item={x.titleId}>
              <span class="serif num dot" style={`border-color: ${typeColor(x.e.data.type)}; color: ${typeColor(x.e.data.type)}`}>{i + 1}</span>
              <Cover entry={x.e} variant="swatch" w={56} h={82} />
              <span class="stack body">
                <span class="serif st">{fullTitle(x.e)}</span>
                <input class="field why-in" value={x.why} maxlength="300" placeholder="Why it’s here (optional)" aria-label={`Why ${fullTitle(x.e)} is here`} data-why />
              </span>
              <span class="ctrls">
                <button type="button" class="iconbtn sm" data-move="-1" disabled={i === 0} aria-label="Move up">↑</button>
                <button type="button" class="iconbtn sm" data-move="1" disabled={i === path.length - 1} aria-label="Move down">↓</button>
                <button type="button" class="iconbtn sm" data-drop aria-label={`Remove ${fullTitle(x.e)}`}>×</button>
              </span>
            </div>
          ) : (
          <a href={x.link} class="step rise" style={`animation-delay: ${(0.5 + i * 0.1).toFixed(2)}s`}>
            <span class="serif num dot" style={`border-color: ${typeColor(x.e.data.type)}; color: ${typeColor(x.e.data.type)}`}>{i + 1}</span>
            <Cover entry={x.e} variant="swatch" w={72} h={104} />
            <span class="stack body">
              <span class="k" style={`color: ${typeColor(x.e.data.type)}`}>{kind(x.e)}</span>
              <span class="serif st">{fullTitle(x.e)}</span>
              <span class="muted why">{x.why}</span>
            </span>
            <span class="num muted m">{x.e.data.type === 'film' || x.e.data.type === 'tv' ? duration(minutes(x.e)) : x.e.data.type === 'essay' ? `${minutes(x.e)} min` : `≈ ${duration(minutes(x.e))}`}</span>
          </a>
          )}
        </li>
      ))}
    </ol>
  </div>

  {editing && (
    <section class="pad danger-zone">
      <button type="button" class="btn del" data-col-delete={col.uuid}>Delete this collection</button>
      <span class="muted">The films and books stay on your shelf.</span>
    </section>
  )}

  {others.length > 0 && !editing && (
    <section class="pad more-t">
      <div class="rule"><h2 class="eyebrow">More collections</h2><a href={`/@${profile.username}/collections/`} class="more">All {collections.length} collections →</a></div>
      <div class="grid">{others.map((t) => <CollectionCard collection={t} entries={entries} />)}</div>
    </section>
  )}
</Base>

<style>
  @keyframes fan { from { opacity: 0; transform: translateY(24px) rotate(0); } }
  @keyframes draw { from { transform: scaleY(0); } }
  .head { padding-top: 64px; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 18px; }
  .fan { position: relative; width: 300px; height: 150px; }
  .f { position: absolute; top: 20px; width: 84px; height: 120px; border-radius: 5px; box-shadow: 0 14px 20px -10px var(--shadow); animation: fan 1s var(--spring) backwards; }
  .f.l { left: 40px; transform: rotate(-10deg); animation-delay: .1s; }
  .f.r { right: 40px; transform: rotate(10deg); animation-delay: .2s; }
  .f.m { left: 105px; top: 0; width: 90px; height: 130px; box-shadow: 0 18px 24px -10px var(--shadow); animation-delay: .3s; }
  .f.m i, .f.m b { position: absolute; display: block; }
  .f.m i { width: 60px; height: 60px; border-radius: 50%; right: -14px; top: 30px; opacity: .8; }
  .f.m b { left: -20%; width: 140%; bottom: -8px; height: 44px; border-radius: 50% 50% 0 0; }
  .tt { margin: 0; font-weight: 400; font-size: clamp(44px, 6vw, 64px); line-height: 1; letter-spacing: -.02em; }
  .tt em { color: var(--lat); }
  .intro { max-width: 640px; }
  .intro :global(p) { margin: 0; font-size: 20px; line-height: 1.55; color: var(--muted); }
  .by { display: inline-flex; align-items: center; gap: 8px; font-size: 12px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--lat); }
  .row { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; justify-content: center; margin-top: 6px; }

  .path { position: relative; width: min(880px, calc(100% - 2 * var(--gut))); margin: 56px auto 0; }
  .line { position: absolute; left: 35px; top: 30px; bottom: 30px; width: 2px; background: var(--line); transform-origin: top center; animation: draw 1.8s var(--spring) .4s backwards; }
  ol { position: relative; list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .step { position: relative; display: flex; align-items: center; gap: 26px; padding: 14px 20px 14px 16px; border-radius: 14px; transition: transform .5s var(--spring), background-color .4s ease; }
  .step:hover { transform: translateX(6px); background: var(--card); color: inherit; }
  .dot { flex-shrink: 0; width: 40px; height: 40px; border-radius: 20px; background: var(--bg); border: 2px solid; display: flex; align-items: center; justify-content: center; font-size: 18px; }
  .body { gap: 6px; flex-grow: 1; min-width: 0; }
  .k { font-size: 11px; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; }
  .st { font-size: 24px; line-height: 1.15; }
  .why { font-size: 14px; line-height: 1.5; }
  .m { font-size: 13px; white-space: nowrap; }

  .more-t { padding-top: 72px; display: flex; flex-direction: column; gap: 24px; }
  .edit-head { width: min(640px, 100%); display: flex; flex-direction: column; gap: 10px; }
  .ename { height: 64px; font-size: 32px; text-align: center; }
  .empty-c { margin: 8px 0 0; }
  .step.edit { gap: 16px; background: var(--card); border: 1px solid var(--line); }
  .step.edit:hover { transform: none; }
  .why-in { height: 40px; font-size: 14px; }
  .ctrls { display: flex; gap: 6px; flex: none; }
  .iconbtn.sm { width: 36px; height: 36px; font-size: 16px; }
  .danger-zone { padding-top: 32px; display: flex; align-items: center; justify-content: center; gap: 14px; flex-wrap: wrap; font-size: 14px; }
  .btn.del { border-color: color-mix(in srgb, #B4473B 50%, var(--line)); color: #B4473B; }
  .btn.del:hover { background: #B4473B; color: #fff; border-color: #B4473B; }
  .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  @media (max-width: 1100px) { .grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 780px) {
    .head { padding-top: 36px; }
    .step { gap: 14px; padding: 12px 8px; }
    .step :global(.sw) { width: 52px !important; height: 76px !important; }
    .line { left: 27px; }
    .m { display: none; }
    .st { font-size: 20px; }
    .grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  import { navigate } from 'astro:transitions/client';
  function setup() {
    const head = document.querySelector<HTMLFormElement>('[data-col-edit]:not([data-ready])');
    if (!head) return;
    head.dataset.ready = '1';
    const id = head.dataset.colEdit!;
    const post = (data: Record<string, unknown>) => fetch('/api/collection', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ collection: id, ...data }) }).then((r) => r.json()).catch(() => ({ error: 'Couldn’t reach the site.' }));
    const again = () => navigate(location.pathname + location.search, { history: 'replace' });
    head.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const fd = new FormData(head);
      const r = await post({ action: 'update', name: fd.get('name'), intro: fd.get('intro') });
      const s = head.querySelector<HTMLElement>('.saved')!;
      s.textContent = r.ok ? 'Saved' : r.error || 'Didn’t save'; s.hidden = false; setTimeout(() => (s.hidden = true), 2500);
    });
    document.querySelectorAll<HTMLInputElement>('[data-why]').forEach((input) => input.addEventListener('change', async () => {
      const item = input.closest<HTMLElement>('[data-item]')!.dataset.item;
      await post({ action: 'why', title: item, why: input.value });
    }));
    document.querySelectorAll<HTMLButtonElement>('[data-move]').forEach((b) => b.addEventListener('click', async () => {
      b.disabled = true;
      const r = await post({ action: 'move', title: b.closest<HTMLElement>('[data-item]')!.dataset.item, dir: Number(b.dataset.move) });
      if (r.ok) again(); else b.disabled = false;
    }));
    document.querySelectorAll<HTMLButtonElement>('[data-drop]').forEach((b) => b.addEventListener('click', async () => {
      b.disabled = true;
      const r = await post({ action: 'remove', title: b.closest<HTMLElement>('[data-item]')!.dataset.item });
      if (r.ok) again(); else b.disabled = false;
    }));
    document.querySelector<HTMLButtonElement>('[data-col-delete]')?.addEventListener('click', async (ev) => {
      const b = ev.currentTarget as HTMLButtonElement;
      const d = document.getElementById('confirm-box') as HTMLDialogElement;
      d.querySelector('#confirm-h')!.textContent = 'Delete this collection?';
      d.querySelector('#confirm-p')!.textContent = 'The collection goes, with its intro and the lines about each title. Everything stays on your shelf.';
      d.querySelector('#confirm-ok')!.textContent = 'Delete';
      d.returnValue = '';
      d.showModal();
      d.addEventListener('close', async () => {
        if (d.returnValue !== 'ok') return;
        b.disabled = true;
        const r = await post({ action: 'delete' });
        if (r.ok) navigate(r.href); else b.disabled = false;
      }, { once: true });
    });
  }
  document.addEventListener('astro:page-load', setup);
</script>
