---
import Base from '../../../layouts/Base.astro';
import Tile from '../../../components/Tile.astro';
import ShelfStrip from '../../../components/ShelfStrip.astro';
import { openShelf } from '../../../lib/shelfpage';
import { loadShelf } from '../../../lib/data';
import { KINDS, kindPlural, type Status } from '../../../lib/kinds';
export const prerender = false;

const o = await openShelf(Astro, '/library/');
if (o.out) return o.out;
const { profile, isMe, visible } = o.shelf;
if (!visible) return Astro.redirect(`/@${profile.username}/`);
const all = await loadShelf(Astro.locals.supabase, profile);
const name = profile.display_name || profile.username;

const years = [...new Set(all.map((e) => e.data.date.getUTCFullYear()))].sort((a, b) => b - a);
const byYear = years.map((y) => ({ y, items: all.filter((e) => e.data.date.getUTCFullYear() === y) }));
const tabs = [{ key: 'all', label: 'All', n: all.length }, ...KINDS.map((k) => ({ key: k, label: kindPlural[k], n: all.filter((e) => e.data.type === k).length })).filter((t) => t.n > 0)];
const STATUS_FILTERS: [string, string, (s: Status) => boolean][] = [
  ['done', 'Finished', (s) => s === 'done'],
  ['now', 'In progress', (s) => s === 'reading' || s === 'watching'],
  ['want', 'Want to', (s) => s === 'want'],
  ['paused', 'Paused', (s) => s === 'paused'],
  ['dnf', 'Didn’t finish', (s) => s === 'dnf' || s === 'dropped'],
];
const filters = STATUS_FILTERS.map(([k, label, f]) => ({ k, label, n: all.filter((e) => f(e.data.status)).length })).filter((f) => f.n > 0);
const group = (s: Status) => (s === 'reading' || s === 'watching' ? 'now' : s === 'dropped' ? 'dnf' : s);
---
<Base title={isMe ? 'Your library' : `${name}’s library`} shelf={profile.username} description={`Everything on ${name}’s shelf, by year.`}>
  <div class="art melt settle banner bleed" style="--day: url(/art/library-day.webp); --night: url(/art/library-night.webp)" aria-hidden="true"></div>

  <div id="lib" data-type="all" data-status="all">
    <section class="pad head rise">
      <div class="stack" style="gap: 6px">
        <h1 class="title">{isMe ? 'Your library' : 'Library'}</h1>
      </div>
    </section>

    <div class="pad rise d1 top"><ShelfStrip shelf={o.shelf} current="library" /></div>

    {all.length === 0 ? (
      <section class="pad empty">
        <p class="serif">{isMe ? 'Nothing here yet.' : `${name} hasn’t added anything yet.`}</p>
        {isMe && <a href="/add/" class="btn primary">Add your first book or film</a>}
      </section>
    ) : (
      <>
        <div class="pad rise d1">
          <div class="tabs" role="tablist" aria-label="Type">
            {tabs.map((t, i) => (
              <button role="tab" data-type-btn={t.key} aria-selected={i === 0 ? 'true' : 'false'}>{t.label} <span class="num">{t.n}</span></button>
            ))}
          </div>
          {filters.length > 1 && (
            <div class="filters" role="group" aria-label="Filter by status">
              <button class="gchip" data-status-btn="all" aria-pressed="true">All</button>
              {filters.map((f) => <button class="gchip" data-status-btn={f.k} aria-pressed="false">{f.label}</button>)}
              <span class="count" aria-live="polite"></span>
            </div>
          )}
        </div>

        {byYear.map(({ y, items }, i) => (
          <section class:list={['pad year rise', i === 0 ? 'd2' : 'd3']}>
            <details open={i < 2} class="yr">
              <summary>
                <span class="serif yn">{y}</span>
                <span class="more toggle" style="color: var(--lat)" aria-hidden="true"><span class="o">Show ↓</span><span class="c">Hide ↑</span></span>
              </summary>
              <div class="shelf grid">
                {items.map((e) => <div class="cell" data-type={e.data.type} data-status={group(e.data.status)}><Tile entry={e} vt /></div>)}
              </div>
              <p class="none muted">Nothing like that in {y}.</p>
            </details>
          </section>
        ))}
      </>
    )}
  </div>
</Base>

<style>
  .banner { height: clamp(200px, 24vw, 340px); background-position: center 62%; }
  .head { margin-top: -28px; position: relative; display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; }
  .top { margin-top: 26px; }
  .tabs { margin-top: 18px; display: flex; gap: 32px; border-bottom: 1px solid var(--line); overflow-x: auto; scrollbar-width: none; }
  .tabs button { height: 50px; padding: 0; background: transparent; border: 0; border-bottom: 2px solid transparent; color: var(--muted); font-size: 13px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; cursor: pointer; white-space: nowrap; transition: color .3s ease, border-color .3s ease; }
  .tabs button span { color: var(--muted); font-weight: 500; margin-left: 4px; }
  .tabs button[aria-selected="true"] { color: var(--ink); border-bottom-color: var(--lat); }
  .tabs button:hover { color: var(--ink); }
  .filters { margin-top: 16px; display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .count { margin-left: 6px; font-size: 13px; color: var(--muted); }

  .year { padding-top: 32px; }
  .yr summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-bottom: 22px; }
  .yr summary::-webkit-details-marker { display: none; }
  .yn { font-size: 32px; }
  .yr[open] .o, .yr:not([open]) .c { display: none; }
  .yr:not([open]) summary { background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 16px 24px; box-shadow: 0 12px 24px -16px var(--shadow); margin-bottom: 0; }
  .yr[open] > .grid, .yr[open] > .list { animation: rise .7s var(--spring) backwards; }
  .cell > :global(.tile) { height: 100%; }


  .none { display: none; margin: 0; font-size: 15px; }
  :global(.is-hidden) { display: none; }
  .yr.empty .none { display: block; }
  .empty { padding-top: 48px; display: flex; flex-direction: column; align-items: flex-start; gap: 16px; }
  .empty p { margin: 0; font-size: 24px; }

  @media (max-width: 780px) {
    .head { margin-top: -12px; }
    .tabs { gap: 22px; }
  }
</style>

<script>
  function setup() {
    const lib = document.getElementById('lib');
    if (!lib || lib.dataset.ready) return;
    lib.dataset.ready = '1';
    const count = lib.querySelector<HTMLElement>('.count');
    const apply = (push = true) => {
      const t = lib.dataset.type!, st = lib.dataset.status!;
      let total = 0;
      lib.querySelectorAll<HTMLElement>('.yr').forEach((yr) => {
        let shown = 0;
        yr.querySelectorAll<HTMLElement>('.cell').forEach((el) => {
          const ok = (t === 'all' || el.dataset.type === t) && (st === 'all' || el.dataset.status === st);
          el.classList.toggle('is-hidden', !ok);
          if (ok) shown++;
        });
        total += shown;
        yr.classList.toggle('empty', shown === 0);
        if (shown && (t !== 'all' || st !== 'all')) (yr as HTMLDetailsElement).open = true;
      });
      if (count) count.textContent = t === 'all' && st === 'all' ? '' : `${total} shown`;
      if (push) {
        const u = new URL(location.href);
        t === 'all' ? u.searchParams.delete('type') : u.searchParams.set('type', t);
        st === 'all' ? u.searchParams.delete('status') : u.searchParams.set('status', st);
        history.replaceState(history.state, '', u);
      }
    };
    const setType = (t: string, push = true) => {
      lib.dataset.type = t;
      lib.querySelectorAll<HTMLElement>('[data-type-btn]').forEach((b) => b.setAttribute('aria-selected', String(b.dataset.typeBtn === t)));
      apply(push);
    };
    const setStatus = (s: string, push = true) => {
      lib.dataset.status = s;
      lib.querySelectorAll<HTMLElement>('[data-status-btn]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.statusBtn === s)));
      apply(push);
    };
    lib.addEventListener('click', (ev) => {
      const el = ev.target as Element;
      const t = el.closest<HTMLElement>('[data-type-btn]');
      if (t) setType(t.dataset.typeBtn!);
      const s = el.closest<HTMLElement>('[data-status-btn]');
      if (s) setStatus(s.dataset.statusBtn!);
    });
    const q = new URLSearchParams(location.search);
    const qt = q.get('type'), qs = q.get('status');
    if (qt && lib.querySelector(`[data-type-btn="${qt}"]`)) setType(qt, false);
    if (qs) {
      lib.dataset.status = qs;
      lib.querySelectorAll<HTMLElement>('[data-status-btn]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.statusBtn === qs)));
      apply(false);
    }
  }
  document.addEventListener('astro:page-load', setup);
</script>
