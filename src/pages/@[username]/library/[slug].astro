---
import Base from '../../../layouts/Base.astro';
import Cover from '../../../components/Cover.astro';
import Face from '../../../components/Face.astro';
import PersonMenu from '../../../components/PersonMenu.astro';
import Eye from '@tabler/icons/outline/eye.svg';
import BookOpen from '@tabler/icons/outline/book-2.svg';
import Play from '@tabler/icons/outline/player-play.svg';
import Pause from '@tabler/icons/outline/player-pause.svg';
import Check from '@tabler/icons/outline/circle-check.svg';
import XIcon from '@tabler/icons/outline/circle-x.svg';
import Calendar from '@tabler/icons/outline/calendar.svg';
import Notes from '@tabler/icons/outline/notes.svg';
import Repeat from '@tabler/icons/outline/repeat.svg';
import Share from '@tabler/icons/outline/share.svg';
import Plus from '@tabler/icons/outline/plus.svg';
import Lock from '@tabler/icons/outline/lock.svg';
import Route from '@tabler/icons/outline/route.svg';
import Mark from '../../../components/ui/Mark.astro';
import { openShelf } from '../../../lib/shelfpage';
import { md } from '../../../lib/md';
import {
  loadShelf, loadCollections, loadVisits, href, palette, coverSrc, stars, starsLabel, long, ticketDate, timesWord,
  minutes, duration, kind, collectionsFor, excerpt, fullTitle, collectionHref, linesHref, pickLine, type Entry,
} from '../../../lib/data';
import { STATUSES, statusLabel, type Status } from '../../../lib/kinds';
import { titlePageHref } from '../../../lib/catalog/onsite';
import { isBareEntry } from '../../../lib/saved';
import Stack from '@tabler/icons/outline/stack-2.svg';
export const prerender = false;

const slug = String(Astro.params.slug ?? '');
const o = await openShelf(Astro, `/library/${slug}/`);
if (o.out) return o.out;
const { profile, details, isMe, visible } = o.shelf;
if (!visible) return Astro.redirect(`/@${profile.username}/`);
const sb = Astro.locals.supabase;
const me = Astro.locals.me;
const visits = await loadVisits(sb, profile, slug);
if (!visits.length) { Astro.response.status = 404; return Astro.rewrite('/404'); }
const entry = visits[0];
const d = entry.data;
const [all, collections] = await Promise.all([loadShelf(sb, profile), loadCollections(sb, profile)]);
const inCols = collectionsFor(entry, collections);
const p = palette(entry);
const cover = coverSrc(entry);
const tname = `cover-${entry.id.replace(/[^a-z0-9-]/gi, '')}`;
const bySlug = new Map(all.map((e) => [e.id, e]));
const name = profile.display_name || profile.username;
const isFilm = d.type === 'film' || d.type === 'tv';

// "Sits well next to": neighbours from the same collections, then the same kind
const related: Entry[] = [];
for (const t of inCols) for (const it of t.items) {
  const e = bySlug.get(it.slug);
  if (e && e.id !== entry.id && !related.includes(e)) related.push(e);
}
for (const e of all) if (related.length < 6 && e.id !== entry.id && e.data.type === d.type && !related.includes(e)) related.push(e);
const rel = related.slice(0, 6);

// film number this year, for the ticket
const year = d.date.getUTCFullYear();
const filmNo = d.type === 'film' && d.status === 'done' ? all.filter((e) => e.data.type === 'film' && e.data.status === 'done' && e.data.date.getUTCFullYear() === year)
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime()).findIndex((e) => e.logId === entry.logId) + 1 : 0;

// the film or book's own page (cast, where to watch, what others thought)
const about = titlePageHref({ kind: d.type, slug: entry.id, title: d.title, tmdb_id: d.tmdbId ?? null, ol_key: d.olKey ?? null, link: d.link ?? null });
const aboutLabel = d.type === 'tv' ? 'About the show' : isFilm ? 'About the film' : 'About the book';

const s = stars(entry);
const mins = minutes(entry);
const done = d.status === 'done';
// a plain save can be taken back with the same tap that made it; the page is gone afterwards, so the message keeps an Undo
const bare = isMe && me ? await isBareEntry(sb, me.id, entry.logId!) : false;
const off = (k: string) => ({ 'data-bare': bare ? '1' : '0', 'data-unsave-go': `/@${profile.username}/library/`, 'data-redo': JSON.stringify({ title: entry.titleId, status: k }) });
const nav = inCols[0];
const prev = nav && nav.pos > 1 ? bySlug.get(nav.items[nav.pos - 2].slug) : undefined;
const next = nav && nav.pos < nav.of ? bySlug.get(nav.items[nav.pos].slug) : undefined;
const desc = excerpt(entry, 150) || `${d.title} by ${d.creator}`;
const notes = md(entry.body);
const sLabel = statusLabel(d.type, d.status);

// everyone's counts for this title (only shelves the visitor may see are counted)
const [{ count: seen }, { count: wanted }] = await Promise.all([
  sb.from('logs').select('id', { count: 'exact', head: true }).eq('title_id', entry.titleId).eq('status', 'done'),
  sb.from('logs').select('id', { count: 'exact', head: true }).eq('title_id', entry.titleId).eq('status', 'want'),
]);

// the log panel: your own entry, or what this title is on YOUR shelf
const ICON: Record<Status, any> = { want: null, reading: BookOpen, watching: Play, done: Check, paused: Pause, dnf: XIcon, dropped: XIcon };
let mine: Entry[] = [];
if (me && !isMe) mine = await loadVisits(sb, me, slug);
const dateRow = d.status === 'want' ? `Added ${long(d.date)}` : d.status === 'done' ? `${d.type === 'film' || d.type === 'tv' ? 'Watched' : 'Finished'} ${long(d.finished ?? d.date)}` : `Started ${long(d.started ?? d.date)}`;
const againWord = isFilm ? 'Watch it again' : 'Read it again';
const verb = isFilm ? 'watch' : 'read';
const link = new URL(href(entry), Astro.url).href;
const shown = pickLine(all, details, name);
const line = shown ? { text: shown.text, by: shown.by, source: shown.source } : undefined;
const pinnedId = shown?.pinned ? shown.id : null;
---
<Base title={`${fullTitle(entry)} | @${profile.username}`} shelf={profile.username} description={desc} line={line} noindex={d.private}>
  {d.type !== 'essay' ? (
    <>
      <div class="art melt under-header banner settle bleed" style="--day: url(/art/library-day.webp); --night: url(/art/library-night.webp)" aria-hidden="true"></div>

      <section class="pad top">
        <div class="side">
          {isFilm ? (
            <div class="hero-film" transition:name={tname}>
              <div class:list={['hc', cover ? 'real' : 'wash']} style={`background: ${p.bg}`}>
                {cover && <img class="pic" src={cover} alt={`${d.title} poster`} decoding="async" draggable="false" referrerpolicy="no-referrer" onerror="this.closest('.real')?.classList.replace('real','wash');this.remove()" />}
                <i class="sun" style={`background: ${p.accent}`}></i><i class="hill" style={`background: ${p.hill}`}></i>
                <span class="hk">{kind(entry)}{d.year ? ` | ${d.year}` : ''}</span>
                <span class="serif ht">{d.title}</span>
              </div>
              <div class="type stub lg ticket">
                <div class="tr"><b>{d.type === 'tv' ? 'NOW SHOWING' : 'ADMIT ONE'}</b>{filmNo > 0 && <span class="num">FILM {filmNo} / {year}</span>}{d.type === 'tv' && d.season && <span class="num">SEASON {d.season}</span>}</div>
                <span>{ticketDate(d.date)}{d.where ? ` | ${d.where.toUpperCase()}` : ''}</span>
              </div>
            </div>
          ) : (
            <div class:list={['hc hero-book', cover ? 'real' : 'wash']} style={`background: ${p.bg}`} transition:name={tname}>
              {cover && <img class="pic" src={cover} alt={`${d.title} cover`} decoding="async" draggable="false" referrerpolicy="no-referrer" onerror="this.closest('.real')?.classList.replace('real','wash');this.remove()" />}
              <i class="spine"></i><i class="sun" style={`background: ${p.accent}`}></i><i class="hill" style={`background: ${p.hill}`}></i>
              <span class="hk">Book{d.year ? ` | ${d.year}` : ''}</span>
              <span class="bt"><span class="serif ht">{d.title}</span><span class="hb">{d.creator}</span></span>
            </div>
          )}
          <div class="counts" aria-label="On Granthalaya">
            <span title={`${isFilm ? 'Watched' : 'Read'} by ${seen ?? 0} ${seen === 1 ? 'person' : 'people'} here`}><Eye />{seen ?? 0}</span>
            <span title={`Saved by ${wanted ?? 0} ${wanted === 1 ? 'person' : 'people'} here`}><Mark solid size={15} />{wanted ?? 0}</span>
            {inCols.length > 0 && <span title={`In ${inCols.length} of ${name}’s collections`}><Route />{inCols.length}</span>}
          </div>
          {about && <a href={about} class="btn about rise d5">{aboutLabel} <span aria-hidden="true">→</span></a>}
        </div>

        <div class="main">
          <a href={`/@${profile.username}/library/`} class="owner rise d2"><Face name={name} src={profile.avatar_url} size={24} />{isMe ? 'Your library' : `${name}’s library`}</a>
          <h1 class="title bigtitle rise d3">{fullTitle(entry)}</h1>
          <p class="rise d3 meta">
            {isFilm
              ? [d.year, d.type === 'tv' ? (d.creator ? `Created by ${d.creator}` : '') : `Directed by ${d.creator}`].filter(Boolean).join(' | ')
              : [d.creator, d.year].filter(Boolean).join(' | ')}
          </p>
          <div class="stats rise d4 num">
            <div class="stat"><span class="sub">{done ? 'Rating' : 'Status'}</span>
              {done ? <span class="bigstars" role="img" aria-label={starsLabel(entry)}>{s || 'Not rated'}</span> : <b>{sLabel}</b>}
            </div>
            <div class="stat"><span class="sub">{d.status === 'want' ? 'Added' : done ? (isFilm ? 'Watched' : 'Finished') : 'Started'}</span><b>{long(done ? (d.finished ?? d.date) : (d.started ?? d.date))}</b></div>
            <div class="stat"><span class="sub">{isFilm ? 'Runtime' : 'Reading time'}</span><b>{isFilm ? duration(mins) : `≈ ${duration(mins)}`}</b></div>
            <div class="stat"><span class="sub">{isFilm ? 'Times seen' : 'Times read'}</span><b>{d.again && d.times === 1 ? (isFilm ? 'A rewatch' : 'A re-read') : timesWord(d.times, isFilm ? 'watch' : 'read')}</b></div>
          </div>
          {d.private && <span class="priv"><Lock width="15" height="15" /> Only you can see this entry</span>}
          {notes && (
            <div class="mynotes rise d5">
              <p class="eyebrow">{isMe ? 'My notes' : `${name}’s notes`}</p>
              <div class="note" set:html={notes} />
            </div>
          )}
          {inCols.length > 0 && (
            <div class="chips rise d6">
              <span class="sub" style="margin-right: 4px">In collections</span>
              {inCols.map((t, i) => <a href={collectionHref(t)} class:list={['chip', i === 0 && 'on']}>{t.title} | {t.pos} of {t.of}</a>)}
            </div>
          )}
          {visits.length > 1 && (
            <div class="stack rise d6" style="gap: 10px; margin-top: 8px">
              <p class="sub">Every time</p>
              <ol class="visits">
                {visits.map((v) => (
                  <li><span class="num">{long(v.data.date)}</span><span>{statusLabel(v.data.type, v.data.status)}{v.data.again ? ' | again' : ''}{stars(v) ? ` | ${stars(v)}` : ''}</span><span class="muted">{excerpt(v, 80)}</span></li>
                ))}
              </ol>
            </div>
          )}
        </div>

        <aside class="logpanel rise d4" aria-label={isMe ? 'Your log' : 'Your shelf'}>
          {isMe ? (
            <>
              <p class="lp-head">Your log</p>
              <div class="toggles" role="group" aria-label="Status">
                {STATUSES[d.type].map(([k, label]) => {
                  const I = ICON[k];
                  return <button class="tg" type="button" aria-pressed={k === d.status ? 'true' : 'false'} data-set-status={JSON.stringify({ id: entry.logId, status: k })} {...off(k)}>{I ? <I aria-hidden="true" /> : <Mark size={24} />}<span>{label}</span></button>;
                })}
              </div>
              <a class="lrow2" href={`/add/?log=${entry.logId}`}><Calendar /><span>{dateRow}</span></a>
              <a class="lrow2" href={`/add/?log=${entry.logId}`}><Notes /><span>Edit rating, notes and lines</span></a>
              {done && <a class="lrow2" href={`/add/?title=${entry.titleId}&again=1`}><Repeat /><span>{againWord}</span></a>}
              <button class="lrow2" type="button" data-collect={JSON.stringify({ title: entry.titleId, what: d.title })}><Stack /><span>Add to a collection</span></button>
              <button class="lrow2" type="button" data-copy={link}><Share /><span>Copy link</span></button>
            </>
          ) : me ? (
            <>
              <p class="lp-head">Your shelf</p>
              {mine.length ? (
                <>
                  <p class="lp-note">It’s on your shelf: <b>{statusLabel(mine[0].data.type, mine[0].data.status)}</b>{stars(mine[0]) ? ` | ${stars(mine[0])}` : ''}.</p>
                  <a class="lrow2" href={href(mine[0])}><Eye /><span>Open your entry</span></a>
                  {mine[0].data.status === 'done' && <a class="lrow2" href={`/add/?title=${entry.titleId}&again=1`}><Repeat /><span>{againWord}</span></a>}
                </>
              ) : (
                <>
                  <button class="lrow2 save" type="button" data-quick-add={JSON.stringify({ title: entry.titleId, status: 'want' })} data-saved-label="Saved to your shelf"><Mark /><span data-label>{statusLabel(d.type, 'want')}</span></button>
                  <a class="lrow2" href={`/add/?title=${entry.titleId}`}><Plus /><span>Log it on your shelf</span></a>
                </>
              )}
              <button class="lrow2" type="button" data-copy={link}><Share /><span>Copy link</span></button>
              <button class="lrow2 quiet" type="button" data-report={JSON.stringify({ user: profile.id, log: entry.logId, who: profile.username })}><span>Report this entry</span></button>
              <button class="lrow2 quiet" type="button" data-block={JSON.stringify({ id: profile.id, who: profile.username, blocked: false })}><span>Block @{profile.username}</span></button>
            </>
          ) : (
            <>
              <p class="lp-head">Keep your own shelf</p>
              <p class="lp-note">Log what you {verb}, keep the lines that stayed with you.</p>
              <a class="lrow2" href={`/signin/?next=${encodeURIComponent(Astro.url.pathname)}`} data-astro-prefetch="false"><Plus /><span>Sign in to add this</span></a>
              <button class="lrow2" type="button" data-copy={link}><Share /><span>Copy link</span></button>
            </>
          )}
        </aside>
      </section>

      {d.highlights.length > 0 && (
        <section class="pad block rise d6">
          <div class="rule"><h2 class="eyebrow">{d.highlights.every((h) => h.mine) ? (isMe ? 'Lines I wrote' : 'Their lines') : (isMe ? 'Lines I underlined' : 'Lines they underlined')}</h2><a href={linesHref(profile.username)} class="more">All lines →</a></div>
          <div class="hl">
            {d.highlights.map((h) => (
              <article class="card lift hlc">
                {isMe && (
                  <button type="button" class:list={['pinbtn', pinnedId === h.id && 'on']} data-pin={JSON.stringify({ id: h.id, on: pinnedId !== h.id })} aria-pressed={pinnedId === h.id ? 'true' : 'false'}
                    title={pinnedId === h.id ? 'Pinned to your profile' : 'Pin to your profile'}><Mark size={14} /><span>{pinnedId === h.id ? 'Pinned' : 'Pin to profile'}</span></button>
                )}
                <p class:list={['serif q', h.mine && 'own']}>{h.mine ? h.text : `“${h.text}”`}</p>
                {h.note && <p class="soft-note"><span class="sub">My note</span>{h.note}</p>}
                {h.where && <span class="num muted" style="margin-top: auto; font-size: 12px">{h.where}</span>}
              </article>
            ))}
          </div>
        </section>
      )}

      {d.trivia.length > 0 && (
        <section class="pad block rise d6">
          <div class="rule">
            <h2 class="eyebrow">{isFilm ? (d.type === 'tv' ? 'Behind the show' : 'Behind the film') : 'Behind the book'}</h2>
            {d.triviaSource && <a href={d.triviaSource} class="more" target="_blank" rel="noopener">From Wikipedia ↗</a>}
          </div>
          <ol class="trivia">
            {d.trivia.map((t, i) => (
              <li class="card"><span class="serif tn num">{String(i + 1).padStart(2, '0')}</span><p>{t}</p></li>
            ))}
          </ol>
        </section>
      )}
    </>
  ) : (
    <article class="essay-page">
      <a href={`/@${profile.username}/library/`} class="owner rise"><Face name={name} src={profile.avatar_url} size={24} />{isMe ? 'Your library' : `${name}’s library`}</a>
      <p class="sub rise d1" style="color: var(--moss)">Essay | {d.source ?? 'on the web'} | {d.creator}</p>
      <h1 class="serif rise d2 et" transition:name={tname}>{d.title}</h1>
      <p class="rise d2 num muted" style="margin: 0; font-size: 15px">
        {mins}-minute read | {d.status === 'want' ? 'saved for later' : 'read'} {long(d.date)}{s && <> | <span style="color: var(--lat)">{s}</span></>}
      </p>
      <div class="rise d3 inline">
        {d.link && <a href={d.link} class="btn primary big" target="_blank" rel="noopener">Read the original on {d.source ?? new URL(d.link).hostname} <span aria-hidden="true">↗</span></a>}
        {d.link && <button class="btn big" data-copy={d.link}>Copy link</button>}
      </div>
      {(notes || isMe) && (
        <section class="card rise d4 why">
          <p class="eyebrow">{isMe ? 'Why I saved it' : `Why ${name} saved it`}</p>
          {notes ? <div class="note essay-note" set:html={notes} /> : <p class="muted" style="margin: 0">No note yet. <a href={`/add/?log=${entry.logId}`} class="accent">Add one</a>.</p>}
          <p class="muted" style="margin: 0; font-size: 14px">The essay itself lives on {d.source ?? 'its own site'}. This page only keeps the link and the note.</p>
        </section>
      )}
      <div class="rise d4 inline">
        {isMe ? (
          <>
            {STATUSES.essay.map(([k, label]) => <button class="chip" type="button" aria-pressed={k === d.status ? 'true' : 'false'} data-set-status={JSON.stringify({ id: entry.logId, status: k })} {...off(k)}>{label}</button>)}
            <a class="chip" href={`/add/?log=${entry.logId}`}>Edit</a>
            <button class="chip" type="button" data-collect={JSON.stringify({ title: entry.titleId, what: d.title })}>Add to a collection</button>
          </>
        ) : me ? (
          mine.length ? <a class="chip" href={href(mine[0])}>On your shelf | {statusLabel('essay', mine[0].data.status)}</a>
            : <button class="chip" type="button" data-quick-add={JSON.stringify({ title: entry.titleId, status: 'want' })} data-saved-label="Saved"><Mark size={15} /><span data-label>Save for later</span></button>
        ) : (
          <a class="chip" href={`/signin/?next=${encodeURIComponent(Astro.url.pathname)}`} data-astro-prefetch="false">Sign in to save it</a>
        )}
        {!isMe && me && <PersonMenu username={profile.username} id={profile.id} isMe={false} signedIn={true} blocked={false} logId={entry.logId} />}
      </div>
      {inCols.length > 0 && (
        <div class="chips rise d5">
          <span class="sub" style="margin-right: 4px">In collections</span>
          {inCols.map((t, i) => <a href={collectionHref(t)} class:list={['chip', i === 0 && 'on']}>{t.title} | {t.pos} of {t.of}</a>)}
        </div>
      )}
      {(prev || next) && (
        <div class="pn rise d5">
          {prev ? <a href={href(prev)} class="stack" style="gap: 4px"><span class="sub" style="font-size: 11px">← Previous in collection</span><span class="serif" style="font-size: 18px">{prev.data.title}</span></a> : <span></span>}
          {next && <a href={href(next)} class="stack" style="gap: 4px; text-align: right"><span class="sub" style="font-size: 11px">Next in collection →</span><span class="serif" style="font-size: 18px">{next.data.title}</span></a>}
        </div>
      )}
    </article>
  )}

  {rel.length > 0 && (
    <section class="pad block rise d6">
      <div class="rule"><h2 class="eyebrow">Sits well next to</h2>{inCols[0] ? <a href={collectionHref(inCols[0])} class="more">Open the collection →</a> : <a href={`/@${profile.username}/library/`} class="more">The library →</a>}</div>
      <div class="rel">
        {rel.map((e) => (
          <a href={href(e)} class="lift stack" style="gap: 10px">
            <Cover entry={e} variant="mini" />
            <span class="muted" style="font-size: 12px">{kind(e)} | {e.data.creator}</span>
          </a>
        ))}
      </div>
    </section>
  )}
</Base>

<style>
  @keyframes hero { from { opacity: .4; transform: translateY(40px) scale(.9); } to { opacity: 1; transform: none; } }
  .banner { height: 280px; background-position: center 62%; }
  .top { position: relative; margin-top: -170px; display: flex; gap: 56px; align-items: flex-start; }
  .side { flex-shrink: 0; width: 260px; display: flex; flex-direction: column; gap: 12px; }
  .hero-film, .hero-book { animation: hero .95s var(--spring) backwards; }
  .hero-film { display: flex; flex-direction: column; filter: drop-shadow(0 22px 22px var(--shadow)); }
  .hc { color: #F6EEDF; display: flex; flex-direction: column; justify-content: space-between; box-sizing: border-box; }
  .hc > * { position: relative; }
  .hc.real { position: relative; overflow: hidden; }
  .hc .pic { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 30%; }
  .hc.real > :not(.pic):not(.spine) { visibility: hidden; }
  .hc.real .spine { z-index: 1; }
  .hc .sun, .hc .hill, .hc .spine { position: absolute; display: block; }
  .hc .sun { width: 170px; height: 170px; border-radius: 50%; right: -40px; top: 90px; opacity: .78; }
  .hc .hill { left: -20%; width: 140%; bottom: -12px; height: 125px; border-radius: 50% 50% 0 0; }
  .hc .spine { left: 0; top: 0; bottom: 0; width: 16px; background: linear-gradient(90deg, rgba(0,0,0,.32), rgba(255,255,255,.08) 70%, rgba(0,0,0,0)); }
  .hero-film .hc { height: 330px; border-radius: 8px 8px 0 0; padding: 20px; }
  .hero-book { height: 375px; border-radius: 3px 8px 8px 3px; padding: 22px 20px 22px 30px; box-shadow: 4px 4px 0 -1px var(--card), 5px 5px 0 -1px var(--line), 8px 8px 0 -2px var(--card), 9px 9px 0 -2px var(--line), 12px 22px 30px -10px var(--shadow); }
  .hk { font-size: 11px; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; opacity: .85; }
  .ht { font-size: 34px; line-height: 1.02; overflow-wrap: anywhere; }
  .bt { display: flex; flex-direction: column; gap: 6px; }
  .hb { font-size: 12px; opacity: .85; }
  .ticket { background: var(--card); border-top: 2px dashed var(--line); border-radius: 0 0 8px 8px; padding: 16px 20px; display: flex; flex-direction: column; gap: 4px; }
  .ticket .tr { display: flex; justify-content: space-between; gap: 8px; }
  .ticket b { font-size: 14px; letter-spacing: .22em; color: var(--lat); }
  .ticket span { font-size: 12px; color: var(--muted); }
  .about { margin-top: 14px; justify-content: space-between; }

  .main { flex: 1; min-width: 0; padding-top: 176px; display: flex; flex-direction: column; gap: 18px; }
