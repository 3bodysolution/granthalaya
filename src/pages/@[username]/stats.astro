---
import Base from '../../layouts/Base.astro';
import ShelfStrip from '../../components/ShelfStrip.astro';
import { openShelf } from '../../lib/shelfpage';
import { yearOg } from '../../lib/share';
import YearShelf, { type ShelfItem } from '../../components/YearShelf.astro';
import { fillCoverColors } from '../../lib/catalog/covercolor';
import { loadShelf, monthNames, href, fullTitle, coverSrc, palette, type Entry } from '../../lib/data';
export const prerender = false;

const o = await openShelf(Astro, '/stats/');
if (o.out) return o.out;
const { profile, isMe, visible } = o.shelf;
if (!visible) return Astro.redirect(`/@${profile.username}/`);
const sb = Astro.locals.supabase;
const shelf = await loadShelf(sb, profile, { byShow: false });
const name = profile.display_name || profile.username;
// stats count finished things only; TV counts with films
const all = shelf.filter((e) => e.data.status === 'done');
const bucket = (e: Entry) => (e.data.type === 'tv' ? 'film' : e.data.type) as 'book' | 'film' | 'essay';
const yearOf = (e: Entry) => e.data.date.getUTCFullYear();
const today = new Date();
const thisYear = today.getUTCFullYear();
const years = [...new Set(all.map(yearOf))].sort((a, b) => b - a);
const asked = Number(Astro.url.searchParams.get('year'));
const year = years.includes(asked) ? asked : years.includes(thisYear) ? thisYear : (years[0] ?? thisYear);
const inYear = all.filter((e) => yearOf(e) === year);
const count = (t: 'book' | 'film' | 'essay') => inYear.filter((e) => bucket(e) === t).length;
const nBooks = count('book'), nFilms = count('film'), nEssays = count('essay');
const hasTv = inYear.some((e) => e.data.type === 'tv');
const plural = (n: number, one: string, many = one + 's') => `${n} ${n === 1 ? one : many}`;

const DAY = 86400000;
const jan1 = Date.UTC(year, 0, 1);
const endOfPeriod = year === thisYear ? Date.UTC(thisYear, today.getUTCMonth(), today.getUTCDate()) : Date.UTC(year, 11, 31);

// the headline: the numbers, in the book and film colours
const read = [nBooks && plural(nBooks, 'book'), nEssays && plural(nEssays, 'essay')].filter(Boolean) as string[];
const who = isMe ? 'you' : name.split(' ')[0];

// months: how many finished (hours only in the tooltip, and only for titles with a runtime or page count)
const months = monthNames.map((m, i) => {
  const from = Date.UTC(year, i, 1), to = Date.UTC(year, i + 1, 1);
  const list = inYear.filter((e) => { const t = e.data.date.getTime(); return t >= from && t < to; });
  const k = { book: 0, film: 0, essay: 0 };
  for (const e of list) k[bucket(e)]++;
  return { name: m, list, ...k, sum: list.length, future: from > endOfPeriod };
});
const maxMonth = Math.max(4, ...months.map((m) => m.sum));
const BAR = 150;

// tiles
const rated = inYear.filter((e) => e.data.rating != null)
  .sort((a, b) => b.data.rating! - a.data.rating! || Number(b.data.loved) - Number(a.data.loved) || b.data.date.getTime() - a.data.date.getTime());
// a favourite is something you rated well: with only a 2-star film rated, there is none
const fav = rated[0] && (rated[0].data.rating ?? 0) >= 3.5 ? rated[0] : undefined;
const films = inYear.filter((e) => bucket(e) === 'film');
const filmsKnown = films.filter((e) => e.data.runtime);
const filmMin = filmsKnown.reduce((s, e) => s + e.data.runtime!, 0);
const books = inYear.filter((e) => e.data.type === 'book');
const booksKnown = books.filter((e) => e.data.pages);
const pageSum = booksKnown.reduce((s, e) => s + e.data.pages!, 0);
const missing = (all: Entry[], known: Entry[]) => all.length - known.length;
const fmt = (n: number) => n.toLocaleString('en-IN');
const filmHours = Math.round(filmMin / 60);

// days with something finished, streaks and the calendar
const perDay = new Map<number, number>();
for (const e of all) {
  const t = Date.UTC(e.data.date.getUTCFullYear(), e.data.date.getUTCMonth(), e.data.date.getUTCDate());
  perDay.set(t, (perDay.get(t) ?? 0) + 1);
}
let best = 0, run = 0;
for (let t = jan1; t <= endOfPeriod; t += DAY) {
  if (perDay.has(t)) { run++; if (run > best) best = run; } else run = 0;
}
const activeDays = [...perDay.keys()].filter((t) => t >= jan1 && t <= endOfPeriod).length;
const daysSoFar = Math.round((endOfPeriod - jan1) / DAY) + 1;

// top language, only where the title has one saved
const langNames = new Intl.DisplayNames(['en'], { type: 'language' });
const langName = (c: string) => { try { return langNames.of(c) ?? c; } catch { return c; } };
const langCount = new Map<string, number>();
for (const e of inYear) if (e.data.language) langCount.set(e.data.language, (langCount.get(e.data.language) ?? 0) + 1);
const topLang = [...langCount.entries()].sort((a, b) => b[1] - a[1])[0];

// most read author and most watched director, from the saved creator; only when someone comes up more than once
const topOf = (list: Entry[]) => {
  const n = new Map<string, number>();
  for (const e of list) { const c = e.data.creator?.trim(); if (c) n.set(c, (n.get(c) ?? 0) + 1); }
  const t = [...n.entries()].sort((a, b) => b[1] - a[1])[0];
  return t && t[1] > 1 ? t : undefined;
};
const topAuthor = topOf(inYear.filter((e) => e.data.type === 'book' || e.data.type === 'essay'));
const topDirector = topOf(inYear.filter((e) => e.data.type === 'film'));
const opts = [
  topLang && { label: 'Top language', value: langName(topLang[0]), note: `${plural(topLang[1], 'title')}, where a language is saved`, color: 'var(--moss)' },
  topAuthor && { label: 'Most read author', value: topAuthor[0], note: `${plural(topAuthor[1], 'book or essay', 'books and essays')}`, color: 'var(--book)' },
  topDirector && { label: 'Most watched director', value: topDirector[0], note: `${plural(topDirector[1], 'film')}`, color: 'var(--sky)' },
].filter(Boolean) as { label: string; value: string; note: string; color: string }[];

// how you rate: half-star steps
const steps = Array.from({ length: 10 }, (_, i) => (i + 1) / 2);
const rateCount = steps.map((s) => inYear.filter((e) => e.data.rating === s).length);
const maxRate = Math.max(1, ...rateCount);
const stepLabel = (s: number) => (s % 1 ? `${Math.floor(s) || ''}½` : String(s));

// the calendar
const firstMon = jan1 - ((new Date(jan1).getUTCDay() + 6) % 7) * DAY;
const weeks: { t: number; n: number; out: boolean }[][] = [];
for (let w = 0; w < 54; w++) {
  const col = [];
  for (let d = 0; d < 7; d++) {
    const t = firstMon + (w * 7 + d) * DAY;
    col.push({ t, n: perDay.get(t) ?? 0, out: t < jan1 || t > Date.UTC(year, 11, 31) });
  }
  if (col.every((c) => c.out)) break;
  weeks.push(col);
}
const monthLabels = monthNames.map((m, i) => ({ name: m, w: Math.floor((Date.UTC(year, i, 1) - firstMon) / DAY / 7) }));
const LV = [{ c: 'var(--soft)', o: 1 }, { c: 'var(--lat)', o: 0.35 }, { c: 'var(--lat)', o: 0.6 }, { c: 'var(--lat)', o: 0.8 }, { c: 'var(--lat)', o: 1 }];
const label = (t: number) => { const d = new Date(t); return `${monthNames[d.getUTCMonth()]} ${d.getUTCDate()}`; };

// the year in covers: up to three a month, best rated first
const monthCovers = months.filter((m) => m.sum > 0).map((m) => ({
  name: m.name, total: m.sum,
  picks: [...m.list].sort((a, b) => (b.data.rating ?? 0) - (a.data.rating ?? 0) || b.data.date.getTime() - a.data.date.getTime()),
}));
// the year as a shelf: finished things in date order; a show is one box set with the seasons finished this year
const PAPER = '#E9E1CE';
const fresh = await fillCoverColors(inYear.map((e) => ({ id: e.titleId, cover: e.data.cover, known: e.data.coverColor })), Astro.url.origin);
const colorFor = (e: Entry) => fresh.get(e.titleId) ?? e.data.coverColor ?? palette(e).bg;
const seasonsText = (ns: number[]) => {
  const a = [...new Set(ns)].sort((x, y) => x - y);
  if (!a.length) return undefined;
  const parts: string[] = [];
  for (let i = 0; i < a.length; i++) {
    let j = i;
    while (j + 1 < a.length && a[j + 1] === a[j] + 1) j++;
    parts.push(j > i ? `S${a[i]}–${a[j]}` : `S${a[i]}`);
    i = j;
  }
  return parts.join(', ');
};
const byTime = [...inYear].sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
const shelfItems: { at: number; item: ShelfItem }[] = [];
const shows = new Map<string, { at: number; list: Entry[] }>();
for (const e of byTime) {
  const at = e.data.date.getTime();
  if (e.data.type === 'tv') {
    const k = e.showId ?? e.data.title;
    const g = shows.get(k) ?? { at, list: [] };
    g.at = at; g.list.push(e); shows.set(k, g);
  } else {
    shelfItems.push({ at, item: { kind: e.data.type === 'essay' ? 'essay' : e.data.type === 'film' ? 'film' : 'book', title: e.data.title, href: href(e), color: e.data.type === 'essay' ? PAPER : colorFor(e) } });
  }
}
for (const g of shows.values()) {
  const f = g.list[0];
  shelfItems.push({ at: g.at, item: { kind: 'tv', title: f.data.title, href: href(f), color: colorFor(f), seasons: seasonsText(g.list.map((x) => x.data.season).filter((n): n is number => n != null)) } });
}
shelfItems.sort((a, b) => a.at - b.at);
const nShows = shows.size;
const nFilmsOnly = inYear.filter((e) => e.data.type === 'film').length;
const FULL = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
const lastMonth = shelfItems.length ? FULL[new Date(shelfItems[shelfItems.length - 1].at).getUTCMonth()] : '';
const yearUrl = (y: number) => `/@${profile.username}/stats/${y === thisYear ? '' : `?year=${y}`}`;
---
<Base title={isMe ? 'Your stats' : `${name}’s stats`} shelf={profile.username} feed={!profile.is_private}
  description={inYear.length ? `${plural(inYear.length, 'thing')} finished in ${year}.` : `Stats for ${year}.`}
  og={inYear.length && !profile.is_private ? yearOg(name, year, nBooks, nFilms, Math.round(filmMin / 60), fav ? fav.data.title : undefined) : undefined}>
  <section class="pad yearhead">
    <p class="eyebrow yh-eyebrow">Year {year}</p>
    {inYear.length ? (
      <>
        <h1 class="title num yh-sentence">
          In {year} {who} {read.length > 0 && <>read {read.map((r, i) => <>{i > 0 && ' and '}<b class="nb">{r.split(' ')[0]}</b> {r.split(' ').slice(1).join(' ')}</>)}</>}{read.length > 0 && (nFilmsOnly > 0 || nShows > 0) && ', and '}{(nFilmsOnly > 0 || nShows > 0) && <>{read.length > 0 ? '' : ' '}watched {nFilmsOnly > 0 && <><b class="nf">{nFilmsOnly}</b> {nFilmsOnly === 1 ? 'film' : 'films'}</>}{nFilmsOnly > 0 && nShows > 0 && ' and '}{nShows > 0 && <><b class="nf">{nShows}</b> {nShows === 1 ? 'show' : 'shows'}</>}</>}.
        </h1>
        <YearShelf items={shelfItems.map((x) => x.item)} year={year} />
        <div class="yh-months" aria-hidden="true"><span>January</span>{lastMonth && lastMonth !== 'January' && <span>{lastMonth}</span>}</div>
      </>
    ) : (
      <h1 class="title">Nothing finished in {year} yet.</h1>
    )}
  </section>

  <section class="pad strip-row rise d1"><ShelfStrip shelf={o.shelf} current="stats" /></section>

  <section class="pad bars-wrap">
    <div class="bars num" role="img" aria-label={`Finished per month in ${year}: ` + months.filter((m) => !m.future).map((m) => `${m.name} ${m.sum}`).join(', ')}>
      {months.map((m, i) => (
        <div class="mcol" title={m.future ? undefined : `${m.name}: ${m.book} books, ${m.film} films and shows, ${m.essay} essays`}>
          {!m.future && m.sum > 0 && <span class="mt">{m.sum}</span>}
          {m.sum > 0 && (
            <div class="stackbar" style={`animation-delay: ${(0.2 + i * 0.05).toFixed(2)}s`}>
              {m.essay > 0 && <div style={`height: ${(m.essay / maxMonth) * BAR}px; background: var(--moss)`}></div>}
              {m.film > 0 && <div style={`height: ${(m.film / maxMonth) * BAR}px; background: var(--sky)`}></div>}
              {m.book > 0 && <div style={`height: ${(m.book / maxMonth) * BAR}px; background: var(--book)`}></div>}
            </div>
          )}
          <span class="mn type">{m.name.slice(0, 1)}</span>
        </div>
      ))}
    </div>
    <div class="keys"><span class="key"><i style="background: var(--book)"></i>Books</span><span class="key"><i style="background: var(--sky)"></i>Films and TV</span><span class="key"><i style="background: var(--moss)"></i>Essays</span>
      {isMe && inYear.length > 0 && <button class="gchip" type="button" data-share={JSON.stringify({ title: `My ${year}`, ref: `year=${profile.username}/${year}`, card: `/@${profile.username}/year.png?year=${year}` })}>Share my year</button>}
      {years.length > 1 && <span class="yrs" aria-label="Year">{years.map((y) => <a class="gchip" href={yearUrl(y)} aria-current={y === year ? 'page' : undefined}>{y}</a>)}</span>}
    </div>
  </section>

  {inYear.length > 0 && (
    <section class="pad tiles num">
      {fav && (
        <a class="card tile fav" href={href(fav)}>
          <span class="eyebrow">Favourite of the year</span>
          <div class="favcover"><div class="pic" style={`--bg: ${palette(fav).bg}; --hill: ${palette(fav).hill}; --ac: ${palette(fav).accent}`}>{coverSrc(fav) ? <img src={coverSrc(fav)} alt="" loading="lazy" decoding="async" draggable="false" referrerpolicy="no-referrer" /> : <span class="serif pt">{fav.data.title}</span>}</div></div>
          <span class="serif favname">{fullTitle(fav)}</span>
          <span class="muted small">{fav.data.rating != null && `${fav.data.rating} stars`}</span>
        </a>
      )}
      <div class:list={['right', !fav && 'alone']}>
        <div class="card tile t1"><span class="eyebrow">Hours of film</span>
          {filmsKnown.length ? <><span class="serif big" style="color: var(--sky)">{filmHours < 1 ? '<1' : fmt(filmHours)}</span><span class="muted small">{missing(films, filmsKnown) ? `About, from ${plural(filmsKnown.length, 'title')} with a runtime` : 'Counted from each runtime'}</span></>
            : <span class="muted small">No runtimes saved for these yet.</span>}</div>
        <div class="card tile t1"><span class="eyebrow">Pages</span>
          {booksKnown.length ? <><span class="serif big" style="color: var(--book)">{fmt(pageSum)}</span><span class="muted small">{missing(books, booksKnown) ? `About, from ${plural(booksKnown.length, 'book')} with a page count` : 'Counted from each book’s pages'}</span></>
            : <span class="muted small">No page counts saved for these yet.</span>}</div>
        <div class="card tile t1 t1last"><span class="eyebrow">Longest streak</span>
          <span class="serif big">{best} {best === 1 ? 'day' : 'days'}</span><span class="muted small">{activeDays} of {daysSoFar} days had something finished</span></div>
        {opts.map((t, i) => (
          <div class:list={['card tile opt', i === opts.length - 1 && opts.length % 2 === 1 && 'oddlast']} style={`--span: ${6 / opts.length}`}>
            <span class="eyebrow">{t.label}</span>
            <span class="serif big lang" style={`color: ${t.color}`}>{t.value}</span>
            <span class="muted small">{t.note}</span>
          </div>
        ))}
        <div class="card tile wide"><span class="eyebrow">How you rate</span>
          {rated.length ? (
            <div class="rate" role="img" aria-label={'Ratings: ' + steps.map((s, i) => `${s} stars ${rateCount[i]}`).join(', ')}>
              {steps.map((s, i) => (
                <div class="rcol">
                  <span class="rn">{rateCount[i] || ''}</span>
                  <div class="rbar" style={`height: ${Math.max(rateCount[i] ? 6 : 2, (rateCount[i] / maxRate) * 96)}px; background: var(--haldi); opacity: ${rateCount[i] ? 1 : .35}`}></div>
                  <span class="rl">{stepLabel(s)}</span>
                </div>
              ))}
            </div>
          ) : <span class="muted small">Nothing rated in {year} yet.</span>}
        </div>
      </div>
    </section>
  )}

  {monthCovers.length > 0 && (
    <section class="pad covers">
      <h2 class="serif">{isMe ? 'Your year in covers' : `${name}’s year in covers`}</h2>
      <div class="cgrid">
        {monthCovers.map((m) => (
          <div class="cmonth">
            <span class="eyebrow">{m.name}{m.total > 3 && <span class="more"> | {m.total}</span>}</span>
            <div class="crow">{m.picks.map((e) => <a href={href(e)} class="ctile" title={fullTitle(e)}><div class="pic" style={`--bg: ${palette(e).bg}; --hill: ${palette(e).hill}; --ac: ${palette(e).accent}`}>{coverSrc(e) ? <img src={coverSrc(e)} alt={fullTitle(e)} loading="lazy" decoding="async" draggable="false" referrerpolicy="no-referrer" /> : <span class="serif pt">{e.data.title}</span>}</div></a>)}</div>
          </div>
        ))}
      </div>
    </section>
  )}

  {inYear.length > 0 && (
    <section class="pad cal">
      <div class="between">
        <h2 class="eyebrow">Day by day</h2>
        <div class="legend">Less {LV.map((l) => <span style={`background: ${l.c}; opacity: ${l.o}`}></span>)} More</div>
      </div>
      <div class="scroller">
        <div class="hgrid">
          <div class="type dl" aria-hidden="true"><span>M</span><span></span><span>W</span><span></span><span>F</span><span></span><span>S</span></div>
          <div role="img" aria-label={`A calendar of ${year}. ${activeDays} of ${daysSoFar} days so far had something finished.`} class="stack" style="gap: 6px">
            <div class="type ml">{monthLabels.map((m) => <span style={`left: ${m.w * 17}px`}>{m.name}</span>)}</div>
            <div class="weeks">
              {weeks.map((wk) => (
                <div class="wk">
                  {wk.map((d) => (
                    <span class:list={['cell', d.out && 'out']}
                          style={d.out ? '' : `background: ${LV[Math.min(d.n, 4)].c}; opacity: ${d.t > endOfPeriod ? 0.35 : LV[Math.min(d.n, 4)].o}`}
                          title={d.out || d.t > endOfPeriod ? undefined : `${label(d.t)} | ${d.n ? `${d.n} finished` : 'nothing'}`}></span>
                  ))}
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <section class="pad foot-note">
    <p class="muted small">Only finished things are counted, and only what you can see here. Hours and pages come from a title’s own runtime or page count; titles without one are left out, never guessed.</p>
  </section>
</Base>

<style>
  .yearhead { display: flex; flex-direction: column; align-items: center; gap: 14px; text-align: center; padding-top: clamp(24px, 3vw, 44px); }
  .yh-eyebrow { color: var(--lat); }
  .yh-sentence { font-size: clamp(24px, 2.8vw, 36px); line-height: 1.16; max-width: 760px; margin: 0 0 14px; }
  .yh-sentence .nb { color: var(--book); font-weight: inherit; }
  .yh-sentence .nf { color: var(--sky); font-weight: inherit; }
  .yh-months { width: 100%; max-width: 900px; padding: 0 14px; display: flex; justify-content: space-between; font-size: 12px; font-weight: 600; letter-spacing: .04em; color: var(--muted); }

  /* the bars rise from where the painting fades into the page */
  .bars-wrap { position: relative; padding-top: 34px; display: flex; flex-direction: column; gap: 14px; }
  .bars { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: clamp(8px, 2vw, 22px); align-items: end; max-width: 760px; margin: 0 auto; width: 100%; }
  .mcol { display: flex; flex-direction: column; align-items: center; justify-content: flex-end; gap: 4px; min-height: 185px; }
  .mt { font-size: 12px; font-weight: 600; color: var(--muted); }
  .mn { font-size: 12px; color: var(--muted); padding-top: 4px; }
  .stackbar { display: flex; flex-direction: column; width: min(100%, 36px); border-radius: 4px 4px 0 0; overflow: hidden; transform-origin: bottom; animation: rise .9s var(--spring) backwards; }
  .stackbar > div + div { border-top: 2px solid var(--bg); }
  @keyframes rise { from { transform: scaleY(0); } }
  .keys { display: flex; gap: 10px 26px; flex-wrap: wrap; justify-content: center; align-items: center; font-size: 13px; }
  .yrs { display: inline-flex; gap: 6px; flex-wrap: wrap; margin-left: 10px; }
  .yrs .gchip[aria-current="page"] { background: var(--lat); color: var(--bg); }
  .strip-row { padding-top: 26px; }

  .tiles { padding-top: 28px; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 3fr); gap: 20px; align-items: stretch; }
  .right { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 20px; align-content: start; min-width: 0; }
  .right.alone { grid-column: 1 / -1; }
  .t1 { grid-column: span 2; }
  .opt { grid-column: span var(--span); }
  .tile { padding: 22px; display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .tile .big { font-size: clamp(38px, 4.4vw, 56px); line-height: 1.05; }
  .tile .big.lang { font-size: clamp(30px, 3.4vw, 42px); }
  .small { font-size: 13px; }
  .fav { gap: 12px; }
  .favcover { width: min(100%, 220px); margin: 4px auto; }
  .pic { position: relative; aspect-ratio: 2 / 3; border-radius: 6px; overflow: hidden; display: flex; align-items: flex-end; padding: 8px; background: linear-gradient(to top, var(--hill) 0 28%, var(--bg) 28%); box-shadow: 0 0 0 1px rgba(0, 0, 0, .12), 0 10px 16px -10px var(--shadow); }
  .pic img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .pt { position: relative; color: #F6EEDF; font-size: 13px; line-height: 1.2; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; }
  .favcover .pt { font-size: 22px; padding: 6px; }
  .favname { font-size: 20px; line-height: 1.2; text-align: center; }
  .fav .small { text-align: center; }
  .wide { grid-column: 1 / -1; }
  .rate { display: grid; grid-template-columns: repeat(10, minmax(0, 1fr)); gap: clamp(6px, 1.2vw, 14px); align-items: end; height: 150px; padding-top: 10px; }
  .rcol { display: flex; flex-direction: column; justify-content: flex-end; align-items: center; gap: 4px; height: 100%; }
  .rbar { width: 100%; max-width: 34px; border-radius: 4px 4px 0 0; }
  .rn { font-size: 12px; color: var(--muted); min-height: 14px; }
  .rl { font-size: 12px; color: var(--muted); }

