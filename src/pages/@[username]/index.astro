---
// A person's shelf: the page at /@username. A row of books and DVD cases you can pull out, with filters above and "so far this year" below.
// The filters, like Films and Books, work through the address (?type=, ?status=, ?sort=), so a filtered shelf can be linked.
import Base from '../../layouts/Base.astro';
import ShelfHead from '../../components/ShelfHead.astro';
import Filters from '../../components/title/Filters.astro';
import Bookshelf, { type ShelfBook } from '../../components/shelf/Bookshelf.astro';
import { openShelf } from '../../lib/shelfpage';
import { loadShelf, loadProfileCard, href, short, excerpt, kind as kindOf, stars, coverSrc, type Entry } from '../../lib/data';
import { kindPlural, statusLabel, type Kind, type Status } from '../../lib/kinds';
import { spineOf } from '../../lib/spine';
import { profileOg } from '../../lib/share';
import { fillCoverColors } from '../../lib/catalog/covercolor';
import { waitUntil } from '@vercel/functions';
export const prerender = false;

const o = await openShelf(Astro);
if (o.out) return o.out;
const { profile, details, isMe, visible, blockedByMe } = o.shelf;
const sb = Astro.locals.supabase;
const name = profile.display_name || profile.username;

// a private shelf (not yours) and a blocked one show nothing of the shelf itself; the database hands back nothing either way
const all: Entry[] = visible && !blockedByMe ? await loadShelf(sb, profile) : [];
const card = visible && !blockedByMe ? await loadProfileCard(sb, profile, details, all) : { favs: [], latest: null };

// spine colours come from each cover's main colour, worked out once and kept on the title: for the ones still missing it, that happens
// after the page has gone out (a few per visit), and the next visit has them
if (all.length) {
  const job = fillCoverColors(all.filter((e) => e.data.type !== 'essay').map((e) => ({ id: e.titleId, cover: e.data.cover, known: e.data.coverColor })), Astro.url.origin).catch(() => undefined);
  try { waitUntil(job); } catch { /* not on Vercel: it finishes on its own */ }
}

// ——— filters, from the address ———
const STATUS_FILTERS: [string, string, (s: Status) => boolean][] = [
  ['want', 'Want to', (s) => s === 'want'],
  ['now', 'In progress', (s) => s === 'reading' || s === 'watching'],
  ['done', 'Finished', (s) => s === 'done'],
  ['paused', 'Paused', (s) => s === 'paused'],
  ['dnf', 'Didn’t finish', (s) => s === 'dnf' || s === 'dropped'],
];
const KIND_ORDER: Kind[] = ['book', 'film', 'tv', 'essay'];
const types = KIND_ORDER.filter((k) => all.some((e) => e.data.type === k));
const statuses = STATUS_FILTERS.filter(([, , f]) => all.some((e) => f(e.data.status)));
const q = Astro.url.searchParams;
// an unknown value (a mistyped address) shows everything
const type = types.find((t) => t === q.get('type')) ?? '';
const status = statuses.find(([k]) => k === q.get('status'))?.[0] ?? '';
const SORTS: [string, string][] = [['', 'Recently added'], ['title', 'Title'], ['rating', 'Your rating']];
const sort = SORTS.find(([k]) => k && k === q.get('sort'))?.[0] ?? '';
const fields = [
  { name: 'type', label: 'Type', value: type, options: [['', 'Any type'], ...types.map((t) => [t, kindPlural[t]])] as [string, string][] },
  { name: 'status', label: 'Status', value: status, options: [['', 'Any status'], ...statuses.map(([k, l]) => [k, l])] as [string, string][] },
  { name: 'sort', label: 'Sort', value: sort, options: SORTS },
];
const inStatus = STATUS_FILTERS.find(([k]) => k === status)?.[2];
let shown = all.filter((e) => (!type || e.data.type === type) && (!inStatus || inStatus(e.data.status)));
if (sort === 'title') shown = [...shown].sort((a, b) => a.data.title.localeCompare(b.data.title));
else if (sort === 'rating') shown = [...shown].sort((a, b) => (b.data.rating ?? -1) - (a.data.rating ?? -1));
const filtered = !!(type || status);
const keep = q.get('year') ? { year: q.get('year')! } : {};

// ——— what each book carries ———
const reviewOf = (e: Entry) => {
  const s = e.data.seasons?.find((x) => x.notes.trim());
  const text = s ? s.notes : e.body, spoiler = s ? s.spoiler : e.data.spoiler;
  if (!text.trim()) return '';
  return spoiler && !isMe ? 'This review gives away the story.' : excerpt({ body: text }, 160);
};
const books: ShelfBook[] = shown.map((e) => {
  const d = e.data;
  const status = statusLabel(d.type, d.status) + (d.progress ? `, ${d.progress.toLowerCase()}` : '');
  const when = short(d.finished ?? d.date);
  return {
    title: d.title, creator: d.creator, kind: d.type, kindLabel: kindOf(e), year: d.year, status, when, stars: stars(e), href: href(e),
    cover: coverSrc(e), review: reviewOf(e), spine: spineOf(e),
    label: `${d.title}, ${kindOf(e).toLowerCase()}${d.creator ? ` by ${d.creator}` : ''}${d.year ? `, ${d.year}` : ''}. ${status}.`,
  };
});

const count = (...t: string[]) => all.filter((e) => t.includes(e.data.type)).length;
const og = visible && !profile.is_private ? profileOg(name, count('book'), count('film', 'tv'), count('essay')) : undefined;
---
<Base title={isMe ? 'Your shelf' : `${name} (@${profile.username})`} description={details?.bio || `${name}’s shelf on Granthalaya.`} shelf={profile.username} feed={!profile.is_private} noindex={profile.is_private} og={og}
  image={profile.is_private ? undefined : `/og/u/${profile.username}.png`}>
  <div class="pad top rise">
    <ShelfHead shelf={o.shelf} current="shelf" heading={`${name}’s shelf`} favs={card.favs} latest={card.latest} tabs={visible && !blockedByMe} />
  </div>

  {!visible ? (
    <section class="pad pt-12">
      <div class="card note">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2" /><path d="M8 11V7a4 4 0 0 1 8 0v4" /></svg>
        <h2 class="serif">This shelf is private</h2>
        <p class="muted">Only {name} can see what’s on it.</p>
      </div>
    </section>
  ) : blockedByMe ? (
    <section class="pad pt-12">
      <div class="card note">
        <h2 class="serif">You blocked @{profile.username}</h2>
        <p class="muted">You can’t see each other’s shelves. Unblock to see it again.</p>
        <button class="btn" type="button" data-block={JSON.stringify({ id: profile.id, who: profile.username, blocked: true })}>Unblock @{profile.username}</button>
      </div>
    </section>
  ) : all.length === 0 ? (
    <section class="pad pt-12">
      <div class="card note">
        {isMe ? (
          <>
            <h2 class="serif">Your shelf is empty, for now</h2>
            <p class="muted">Start with whatever you’re reading or watching this week.</p>
            <a href="/add/" class="btn primary big">Add your first book, film, show or essay</a>
          </>
        ) : (
          <>
            <h2 class="serif">Nothing on this shelf yet</h2>
            <p class="muted">{name} hasn’t added anything so far.</p>
          </>
        )}
      </div>
    </section>
  ) : (
    <>
      <div class="pad rise d1 bar"><Filters fields={fields} keep={keep} /></div>
      <div class="pad rise d2 shelfarea">
        {books.length === 0
          ? <p class="serif none">Nothing on this shelf matches.</p>
          : <Bookshelf books={books} owner={name} mine={isMe} />}
      </div>
    </>
  )}
</Base>

<style>
  .top { padding-top: 28px; }
  .bar { margin-top: 28px; }
  .shelfarea { margin-top: 40px; }
  .none { margin: 0; padding: 60px 0; text-align: center; font-size: 22px; font-style: italic; color: var(--muted); }
  .note { max-width: 560px; margin: 0 auto; padding: 40px 32px; display: flex; flex-direction: column; align-items: center; gap: 10px; text-align: center; }
  .note svg { color: var(--muted); }
  .note h2 { margin: 0; font-weight: 400; font-size: 26px; }
  .note p { margin: 0 0 8px; }
</style>
