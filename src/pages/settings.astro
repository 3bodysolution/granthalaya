---
import Base from '../layouts/Base.astro';
import Face from '../components/Face.astro';
import Cover from '../components/Cover.astro';
import { LINKS } from '../lib/kinds';
import { adminClient } from '../lib/supabase';
import { loadShelf, fullTitle, type Details, type Entry } from '../lib/data';
export const prerender = false;

const me = Astro.locals.me;
if (!me) return Astro.redirect(`/signin/?next=${encodeURIComponent('/settings/')}`);
const sb = Astro.locals.supabase;
const [{ data: det }, shelf] = await Promise.all([
  sb.from('profile_details').select('*').eq('id', me.id).maybeSingle<Details>(),
  loadShelf(sb, me),
]);
const d: Partial<Details> = det ?? {};
// people you've blocked (their profiles are hidden from you, so this looks them up on the server)
let blocked: { id: string; username: string; display_name: string }[] = [];
try {
  const { data: rows } = await sb.from('blocks').select('blocked').eq('blocker', me.id);
  const ids = (rows ?? []).map((r) => r.blocked);
  if (ids.length) {
    const { data: ps } = await adminClient().from('profiles').select('id, username, display_name').in('id', ids);
    blocked = ps ?? [];
  }
} catch (e) { console.error('Settings: the blocked list could not be loaded', e); }
const googlePhoto = Astro.locals.user?.avatar ?? null;
const nextChange = me.username_changed_at ? new Date(new Date(me.username_changed_at).getTime() + 30 * 86400000) : null;
const canRename = !nextChange || nextChange < new Date();

// favourites: chosen from anything on your shelf, one entry per title
const titles = new Map<string, Entry>();
for (const e of shelf) if (!titles.has(e.titleId)) titles.set(e.titleId, e);
const picks = [...titles.values()];
const favs = (d.favourites ?? []).filter((id) => titles.has(id)).slice(0, 4);

const tabs = [['profile', 'Profile'], ['privacy', 'Privacy'], ['data', 'Your data'], ['account', 'Account']] as const;
---
<Base title="Settings" noindex>
  <section class="pad wrap">
    <div class="layout">
      <aside class="side">
        <h1 class="serif h">Settings</h1>
        <div class="sn-list" role="tablist" aria-label="Settings" aria-orientation="vertical">
          {tabs.map(([k, label], i) => <button type="button" role="tab" class="sn" id={`tab-${k}`} aria-controls={k} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-tab={k}>{label}</button>)}
        </div>
        <a href={`/@${me.username}/`} class="sn view">View your profile →</a>
      </aside>

      <div class="panels">
        <!-- said once: notes became public reviews (dismissed in this browser) -->
        <div class="notice reviews-note" id="reviewsnote" hidden>
          <p><b>Notes are now reviews.</b> What you write about a film, show or book now shows on its page for everyone, and people can like it and comment. Entries marked Only me, and everything on a private account, never appear there. Comments and likes you leave on someone else’s public review stay public, even on a private account.</p>
          <button type="button" class="gchip" id="reviewsok">Got it</button>
        </div>
        <!-- ——— Profile ——— -->
        <div class="panel" role="tabpanel" id="profile" aria-labelledby="tab-profile">
          <form class="sec" data-save="profile">
            <div class="head"><h2>Profile</h2><p>How you appear to others.</p></div>
            <div class="photo">
              <Face name={me.display_name || me.username} src={me.avatar_url} size={64} />
              <div class="stack" style="gap: 6px">
                <span class="lbl">Photo</span>
                <span class="hint">{me.avatar_url ? 'From your Google account.' : 'No photo: your first letter shows instead.'}</span>
                <div class="flex gap-2">
                  {me.avatar_url && <button type="button" class="gchip" data-photo="none">Remove photo</button>}
                  {googlePhoto && googlePhoto !== me.avatar_url && <button type="button" class="gchip" data-photo="google">Use my Google photo</button>}
                </div>
              </div>
            </div>
            <div class="two">
              <label class="fld"><span class="lbl">Name</span><input class="field" name="display_name" value={me.display_name} maxlength="60" required /></label>
              <label class="fld">
                <span class="lbl">Username</span>
                <span class="uwrap"><span class="at">@</span><input class="field u" name="username" value={me.username} maxlength="20" autocapitalize="none" spellcheck="false" disabled={!canRename} /><span class="ustate" aria-live="polite"></span></span>
                <span class="hint">{canRename ? 'Change it once every 30 days. Your old address will keep working.' : `You can change it again on ${nextChange!.toLocaleDateString('en-GB', { day: 'numeric', month: 'long' })}.`}</span>
              </label>
            </div>
            <label class="fld"><span class="lbl">One line about you</span><input class="field" name="bio" value={d.bio ?? ''} maxlength="160" placeholder="Books, films and everything I’ve spent time with." /><span class="hint"><span data-count="bio">{(d.bio ?? '').length}</span> of 160</span></label>
            <div class="sfoot"><span class="saved" hidden>Saved</span><button class="btn primary" type="submit">Save changes</button></div>
          </form>

          <div class="sec" id="favourites">
            <div class="head"><h2>Favourites</h2><p>Up to four titles from your shelf, shown large on your profile.</p></div>
            {picks.length === 0 ? (
              <p class="muted" style="margin: 0; font-size: 14px">Add something to your shelf first, then choose your favourites here.</p>
            ) : (
              <>
                <div class="slots" data-favs={JSON.stringify(favs)}>
                  {[0, 1, 2, 3].map((i) => {
                    const e = favs[i] ? titles.get(favs[i]) : undefined;
                    return (
                      <div class="slot" data-slot={i}>
                        {e ? (
                          <>
                            <span class="slot-cover"><Cover entry={e} variant="swatch" w={96} h={144} /></span>
                            <button type="button" class="slot-x" data-unfav={e.titleId} aria-label={`Remove ${fullTitle(e)}`}>×</button>
                          </>
                        ) : (
                          <button type="button" class="slot-add" data-open-picker aria-label="Choose a favourite">+</button>
                        )}
                      </div>
                    );
                  })}
                </div>
                <div class="sfoot"><span class="saved" hidden>Saved</span><button type="button" class="btn" data-open-picker>Choose favourites</button></div>
              </>
            )}
          </div>

          <form class="sec" data-save="links">
            <div class="head"><h2>Links</h2><p>Shown beside your @username. A username or a full link both work.</p></div>
            {LINKS.map((l) => (
              <label class="linkrow"><span class="ln">{l.label}</span><input class="field" name={`link_${l.key}`} value={(d.links ?? {})[l.key] ?? ''} maxlength="200" placeholder={l.base ? 'username' : 'https://'} /></label>
            ))}
            <div class="sfoot"><span class="saved" hidden>Saved</span><button class="btn primary" type="submit">Save links</button></div>
          </form>
        </div>

        <!-- ——— Privacy ——— -->
        <div class="panel" role="tabpanel" id="privacy" aria-labelledby="tab-privacy" hidden>
          <div class="sec">
            <div class="head"><h2>Privacy</h2><p>Who can see your shelf.</p></div>
            <label class="row"><span><b>Private account</b><span>Only you see your shelf, reviews, collections and stats. Others see just your name and photo. Comments and likes you leave on someone else’s public review stay public.</span></span><input type="checkbox" class="onoff" data-flag="is_private" checked={me.is_private} /></label>
            <label class="row"><span><b>Feature my shelf</b><span>Show your shelf to new visitors on the home page.</span></span><input type="checkbox" class="onoff" data-flag="featured" checked={me.featured} disabled={me.is_private} /></label>
            <p class="notice bad" id="flagerr" hidden></p>
          </div>
          <div class="sec">
            <div class="head"><h2>Blocked people</h2><p>{blocked.length ? 'They can’t see your profile, and you won’t see theirs.' : 'No one blocked.'}</p></div>
            {blocked.map((b) => (
              <div class="row blk"><span class="flex items-center gap-3"><Face name={b.display_name || b.username} size={32} /><span>{b.display_name || b.username} <span class="muted">@{b.username}</span></span></span><button type="button" class="btn sm" data-block={JSON.stringify({ id: b.id, who: b.username, blocked: true })}>Unblock</button></div>
            ))}
          </div>
        </div>

        <!-- ——— Your data ——— -->
        <div class="panel" role="tabpanel" id="data" aria-labelledby="tab-data" hidden>
          <div class="sec">
            <div class="head"><h2>Export</h2><p>Everything you’ve added, in files you keep.</p></div>
            <div class="row">
              <span><b>Download your data</b><span>A zip of spreadsheets: your shelf and reviews, the comments and likes you gave, your collections and your profile. They open in Excel, Numbers or Google Sheets.</span></span>
              <a class="btn sm" href="/api/export" download data-astro-reload>Download</a>
            </div>
          </div>
        </div>

        <!-- ——— Account ——— -->
        <div class="panel" role="tabpanel" id="account" aria-labelledby="tab-account" hidden>
          <div class="sec danger">
            <div class="head"><h2>Delete account</h2><p>Removes your profile, shelf, reviews, comments and collections for good. This can’t be undone. You might want to download your data first.</p></div>
            <label class="fld"><span class="lbl">Type your username to confirm</span><input class="field" id="confirmname" placeholder={me.username} autocapitalize="none" spellcheck="false" /></label>
            <p class="notice bad" id="delerr" hidden></p>
            <div><button type="button" class="btn delete" id="deleteme" disabled>Delete my account</button></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {picks.length > 0 && (
    <dialog class="box picker" id="picker" aria-labelledby="picker-h">
      <div class="pk-top">
        <h2 id="picker-h">Choose favourites</h2>
        <span class="muted pk-n" aria-live="polite"></span>
      </div>
      <input class="field" type="search" placeholder="Search your shelf" aria-label="Search your shelf" id="pk-q" autocomplete="off" />
      <ul class="pk-list" role="listbox" aria-multiselectable="true" aria-label="Your shelf">
        {picks.map((e) => (
          <li>
            <button type="button" class="pk-item" role="option" aria-selected={favs.includes(e.titleId) ? 'true' : 'false'} data-pick={e.titleId} data-q={`${e.data.title} ${e.data.creator}`.toLowerCase()}>
              <span class="pk-cover"><Cover entry={e} variant="swatch" w={96} h={144} /></span>
              <span class="pk-t">{fullTitle(e)}</span>
              <span class="pk-c muted">{e.data.creator}</span>
            </button>
          </li>
        ))}
      </ul>
      <div class="row"><button type="button" class="btn primary" data-close-picker>Done</button></div>
    </dialog>
  )}
</Base>

<style>
  .wrap { padding-top: 48px; }
  .layout { max-width: 1040px; margin: 0 auto; display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 40px; align-items: start; }
  .side { position: sticky; top: 24px; display: flex; flex-direction: column; gap: 2px; }
  .h { margin: 0 0 16px; font-weight: 400; font-size: 34px; }
  .sn-list { display: flex; flex-direction: column; gap: 2px; }
  .sn { display: block; width: 100%; padding: 10px 12px; border: 0; border-radius: 10px; background: transparent; text-align: left; font: inherit; font-size: 14px; font-weight: 500; color: var(--muted); cursor: pointer; transition: background-color .2s ease, color .2s ease; }
  .sn:hover { background: var(--soft); color: var(--ink); }
  .sn[aria-selected="true"] { background: var(--soft); color: var(--ink); }
  .sn.view { margin-top: 12px; color: var(--lat); }
  .panels { min-width: 0; }
  .reviews-note { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; margin-bottom: 24px; line-height: 1.55; }
  .reviews-note[hidden] { display: none; }
  .reviews-note p { margin: 0; }
  .panel { display: flex; flex-direction: column; gap: 24px; }
  .panel:not([hidden]) { animation: fadein .2s ease; }
  @keyframes fadein { from { opacity: 0; transform: translateY(4px); } }
  .sec { padding: 26px; display: flex; flex-direction: column; gap: 18px; border-radius: 18px; background: var(--card); border: 1px solid var(--line); }
  .head h2 { margin: 0; font-family: 'Fraunces Fix', Fraunces, Georgia, serif; font-weight: 500; font-size: 21px; }
  .head p { margin: 4px 0 0; font-size: 14px; color: var(--muted); }
  .fld { display: flex; flex-direction: column; gap: 8px; }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .photo { display: flex; align-items: center; gap: 16px; }
  .uwrap { position: relative; display: block; }
  .at { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--muted); }
  .u { padding-left: 30px; padding-right: 110px; }
  .u:disabled { opacity: .6; }
  .ustate { position: absolute; right: 12px; top: 50%; transform: translateY(-50%); font-size: 12.5px; font-weight: 600; color: var(--muted); }
  .ustate.ok { color: var(--moss); }
  .ustate.no { color: #B4473B; }
  .sfoot { display: flex; justify-content: flex-end; align-items: center; gap: 14px; }
  .saved { font-size: 13px; font-weight: 600; color: var(--moss); }
  .linkrow { display: grid; grid-template-columns: 110px 1fr; align-items: center; gap: 12px; }
  .ln { font-size: 14px; font-weight: 600; }
  .row { display: flex; align-items: center; justify-content: space-between; gap: 16px; cursor: pointer; }
  .row.blk { cursor: default; padding-left: 4px; }
  .row b { display: block; font-size: 15px; font-weight: 600; }
  .row > span > span { font-size: 13px; color: var(--muted); }
  .btn.sm { height: 36px; padding: 0 14px; font-size: 13px; }
  .danger { border-color: color-mix(in srgb, #B4473B 40%, var(--line)); }
  .btn.delete { background: #B4473B; border-color: #B4473B; color: #fff; }
  .btn.delete:disabled { opacity: .45; cursor: not-allowed; }

  /* favourites: four slots */
  .slots { display: grid; grid-template-columns: repeat(4, 96px); gap: 16px; }
  .slot { position: relative; width: 96px; height: 144px; }
  .slot-cover :global(.sw) { border-radius: 6px; box-shadow: 0 10px 18px -12px var(--shadow); }
  .slot-add { width: 100%; height: 100%; border-radius: 6px; border: 1.5px dashed var(--line); background: transparent; color: var(--muted); font-size: 30px; cursor: pointer; transition: border-color .2s ease, color .2s ease; }
  .slot-add:hover { border-color: var(--lat); color: var(--lat); }
  .slot-x { position: absolute; top: -8px; right: -8px; width: 28px; height: 28px; border-radius: 50%; border: 1px solid var(--line); background: var(--card); color: var(--ink); font-size: 16px; line-height: 1; cursor: pointer; box-shadow: 0 4px 10px -4px var(--shadow); transition: transform .25s var(--spring), border-color .2s ease; }
  .slot-x:hover { border-color: #B4473B; color: #B4473B; }
  .slot-x:active { transform: scale(.92); }

  /* the picker */
  .picker { width: min(720px, calc(100vw - 32px)); max-height: min(720px, 86vh); display: none; flex-direction: column; gap: 14px; }
  .picker[open] { display: flex; }
  .pk-top { flex: none; display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  .picker > .field { flex: none; }
  .pk-top h2 { margin: 0; }
  .pk-n { font-size: 13px; }
  .pk-list { flex: 1 1 auto; min-height: 0; list-style: none; margin: 0; padding: 4px; overflow-y: auto; display: grid; grid-template-columns: repeat(auto-fill, minmax(104px, 1fr)); gap: 16px 12px; }
  .pk-item { width: 100%; display: flex; flex-direction: column; gap: 6px; padding: 6px; border: 0; border-radius: 10px; background: transparent; color: var(--ink); text-align: left; cursor: pointer; transition: background-color .2s ease; }
  .pk-item:hover { background: var(--soft); }
  .pk-cover { position: relative; display: block; width: 100%; }
  .pk-cover :global(.sw) { width: 100% !important; height: auto !important; aspect-ratio: 2 / 3; border-radius: 6px; transition: box-shadow .2s ease; }
  .pk-item[aria-selected="true"] .pk-cover :global(.sw) { box-shadow: 0 0 0 3px var(--lat); }
  .pk-item[aria-selected="true"] .pk-cover::after { content: "✓"; position: absolute; top: 6px; right: 6px; width: 24px; height: 24px; border-radius: 50%; display: grid; place-items: center; background: var(--lat); color: var(--bg); font-size: 13px; font-weight: 700; }
  .pk-item:disabled { opacity: .45; cursor: not-allowed; }
  .pk-t { font-size: 13px; font-weight: 600; line-height: 1.25; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .pk-c { font-size: 12px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .picker .row { margin-top: 0; }

  @media (max-width: 780px) {
    .wrap { padding-top: 20px; }
    .layout { grid-template-columns: 1fr; gap: 20px; }
    .side { position: static; }
    .sn-list { flex-direction: row; flex-wrap: wrap; }
    .sn { width: auto; }
    .two, .linkrow { grid-template-columns: 1fr; }
    .sec { padding: 20px 16px; }
    .slots { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; }
    .slot { width: 100%; height: auto; aspect-ratio: 2 / 3; }
    .slot-cover :global(.sw) { width: 100% !important; height: 100% !important; }
  }
</style>

<script>
  import { navigate } from 'astro:transitions/client';
  function setup() {
    const root = document.querySelector<HTMLElement>('.panels');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';

    const note = document.getElementById('reviewsnote')!;
    try { note.hidden = localStorage.getItem('reviewsNoteSeen') === '1'; } catch (e) { note.hidden = false; }
    document.getElementById('reviewsok')!.addEventListener('click', () => { note.hidden = true; try { localStorage.setItem('reviewsNoteSeen', '1'); } catch (e) { /* storage */ } });

    // ——— tabs, kept in the address (#privacy) so links and the back button work ———
    const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const show = (k: string, push = true) => {
      if (k === 'links' || k === 'favourites') k = 'profile';
      if (!tabs.some((t) => t.dataset.tab === k)) k = 'profile';
      tabs.forEach((t) => { const on = t.dataset.tab === k; t.setAttribute('aria-selected', String(on)); t.tabIndex = on ? 0 : -1; });
      document.querySelectorAll<HTMLElement>('[role=tabpanel]').forEach((p) => (p.hidden = p.id !== k));
      if (push) history.replaceState(history.state, '', `#${k}`);
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => show(t.dataset.tab!));
      t.addEventListener('keydown', (ev) => {
        const d = ev.key === 'ArrowDown' || ev.key === 'ArrowRight' ? 1 : ev.key === 'ArrowUp' || ev.key === 'ArrowLeft' ? -1 : 0;
        if (!d) return;
        ev.preventDefault();
        const n = tabs[(i + d + tabs.length) % tabs.length];
        n.focus(); show(n.dataset.tab!);
      });
    });
    show(location.hash.slice(1) || 'profile', false);

    const post = async (data: unknown) =>
      fetch('/api/profile', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) }).then((x) => x.json()).catch(() => ({ error: 'Couldn’t reach the site.' }));
    const flash = (box: HTMLElement, msg: string, bad = false) => {
      const s = box.querySelector<HTMLElement>('.saved');
      if (!s) return;
      s.textContent = msg; s.style.color = bad ? '#B4473B' : ''; s.hidden = false;
      setTimeout(() => (s.hidden = true), bad ? 6000 : 2500);
    };
    const busy = (b: HTMLButtonElement, on: boolean) => {
      b.disabled = on;
      if (on) { b.setAttribute('aria-busy', 'true'); b.insertAdjacentHTML('afterbegin', '<span class="ink" aria-hidden="true"></span>'); }
      else { b.removeAttribute('aria-busy'); b.querySelector(':scope > .ink')?.remove(); }
    };

    document.querySelectorAll<HTMLFormElement>('form[data-save]').forEach((form) => form.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const fd = Object.fromEntries(new FormData(form).entries());
      const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
      busy(btn, true);
      const r = await post({ section: form.dataset.save, ...fd });
      busy(btn, false);
      if (r.ok) { flash(form, 'Saved'); if (r.reload) navigate(location.pathname + location.hash, { history: 'replace' }); }
      else flash(form, r.error || 'Didn’t save.', true);
    }));

    // username check
    const u = document.querySelector<HTMLInputElement>('input[name=username]')!;
    const st = document.querySelector<HTMLElement>('.ustate')!;
    const mine = u.value;
    let t = 0;
    u.addEventListener('input', () => {
      clearTimeout(t);
      u.value = u.value.toLowerCase().replace(/^@/, '');
      if (u.value === mine) { st.textContent = ''; return; }
      t = window.setTimeout(async () => {
        const r = await fetch(`/api/username?u=${encodeURIComponent(u.value)}`).then((x) => x.json()).catch(() => null);
        if (!r) return;
        st.textContent = r.ok ? '✓ Available' : r.message; st.className = 'ustate ' + (r.ok ? 'ok' : 'no');
      }, 350);
    });
    const bio = document.querySelector<HTMLInputElement>('input[name=bio]')!;
    bio.addEventListener('input', () => { document.querySelector('[data-count=bio]')!.textContent = String(bio.value.length); });
    document.querySelectorAll<HTMLButtonElement>('[data-photo]').forEach((b) => b.addEventListener('click', async () => {
      busy(b, true);
      const r = await post({ section: 'photo', photo: b.dataset.photo });
      if (r.ok) navigate(location.pathname + location.hash, { history: 'replace' }); else busy(b, false);
    }));

    // privacy switches save straight away
    const flagErr = document.getElementById('flagerr')!;
    document.querySelectorAll<HTMLInputElement>('[data-flag]').forEach((c) => c.addEventListener('change', async () => {
      flagErr.hidden = true;
      const r = await post({ section: 'flag', flag: c.dataset.flag, on: c.checked });
      if (!r.ok) { c.checked = !c.checked; flagErr.textContent = r.error || 'That didn’t save.'; flagErr.hidden = false; return; }
      if (c.dataset.flag === 'is_private') {
        // the server switched Feature off when the account went private; show that without a reload
        const feat = document.querySelector<HTMLInputElement>('[data-flag=featured]');
        if (feat) { if (c.checked) feat.checked = false; feat.disabled = c.checked; }
      }
    }));

    // ——— favourites ———
    const slots = document.querySelector<HTMLElement>('.slots');
    const picker = document.getElementById('picker') as HTMLDialogElement | null;
    if (slots && picker) {
      const favBox = document.getElementById('favourites')!;
      let favs: string[] = JSON.parse(slots.dataset.favs || '[]');
      const items = [...picker.querySelectorAll<HTMLButtonElement>('[data-pick]')];
      const coverOf = (id: string) => [...(picker.querySelector(`[data-pick="${CSS.escape(id)}"] .pk-cover`)?.childNodes ?? [])].map((n) => n.cloneNode(true));
      const titleOf = (id: string) => picker.querySelector(`[data-pick="${CSS.escape(id)}"] .pk-t`)?.textContent ?? '';
      const count = picker.querySelector<HTMLElement>('.pk-n')!;
      const paint = () => {
        slots.querySelectorAll<HTMLElement>('[data-slot]').forEach((s, i) => {
          const id = favs[i];
          // built from DOM pieces, so nothing from a title or an id is ever read as HTML
          const btn = document.createElement('button');
          btn.type = 'button';
          if (id) {
            const cover = document.createElement('span');
            cover.className = 'slot-cover';
            cover.replaceChildren(...coverOf(id));
            btn.className = 'slot-x'; btn.dataset.unfav = id; btn.setAttribute('aria-label', `Remove ${titleOf(id)}`); btn.textContent = '×';
            s.replaceChildren(cover, btn);
          } else {
            btn.className = 'slot-add'; btn.dataset.openPicker = ''; btn.setAttribute('aria-label', 'Choose a favourite'); btn.textContent = '+';
            s.replaceChildren(btn);
          }
        });
        items.forEach((b) => {
          const on = favs.includes(b.dataset.pick!);
          b.setAttribute('aria-selected', String(on));
          b.disabled = !on && favs.length >= 4;
        });
        count.textContent = `${favs.length} of 4 chosen`;
      };
      // Astro scopes styles to its own markup, so copy the scope attribute onto what we draw
      const scope = [...slots.attributes].find((a) => a.name.startsWith('data-astro-cid'))?.name;
      const scoped = () => { if (scope) slots.querySelectorAll('*').forEach((el) => el.setAttribute(scope, '')); };
      let saving: Promise<unknown> = Promise.resolve();
      const save = () => {
        const ids = [...favs];
        saving = saving.then(async () => {
          const r = await post({ section: 'favourites', ids });
          flash(favBox, r.ok ? 'Saved' : r.error || 'Didn’t save.', !r.ok);
        });
      };
      const toggle = (id: string) => {
        favs = favs.includes(id) ? favs.filter((x) => x !== id) : favs.length < 4 ? [...favs, id] : favs;
        paint(); scoped(); save();
      };
      document.addEventListener('click', (ev) => {
        const el = ev.target as Element;
        if (el.closest('[data-open-picker]')) { paint(); scoped(); picker.showModal(); (document.getElementById('pk-q') as HTMLInputElement).focus(); return; }
        if (el.closest('[data-close-picker]') || el === picker) { picker.close(); return; }
        const un = el.closest<HTMLElement>('[data-unfav]');
        if (un) { toggle(un.dataset.unfav!); return; }
        const pick = el.closest<HTMLButtonElement>('[data-pick]');
        if (pick && !pick.disabled) toggle(pick.dataset.pick!);
      });
      document.getElementById('pk-q')!.addEventListener('input', (ev) => {
        const q = (ev.target as HTMLInputElement).value.trim().toLowerCase();
        items.forEach((b) => (b.closest('li')!.hidden = !!q && !b.dataset.q!.includes(q)));
      });
      paint(); scoped();
    }

    // ——— delete account ———
    const confirm = document.getElementById('confirmname') as HTMLInputElement;
    const del = document.getElementById('deleteme') as HTMLButtonElement;
    const delErr = document.getElementById('delerr')!;
    confirm.addEventListener('input', () => { del.disabled = confirm.value.trim().toLowerCase().replace(/^@/, '') !== confirm.placeholder; });
    del.addEventListener('click', async () => {
      busy(del, true);
      const r = await fetch('/api/account', { method: 'DELETE', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ confirm: confirm.value.trim().toLowerCase().replace(/^@/, '') }) }).then((x) => x.json()).catch(() => ({ error: 'Couldn’t reach the site.' }));
      if (r.ok) { location.href = '/?deleted=1'; return; }
      delErr.textContent = r.error || 'That didn’t work.'; delErr.hidden = false; busy(del, false);
    });
  }
  document.addEventListener('astro:page-load', setup);
</script>
