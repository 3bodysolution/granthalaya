---
// One prize or classics list on its own page, for sharing. (On Books and Films the same list opens in place.)
import Base from '../../layouts/Base.astro';
import ListGrid from '../../components/title/ListGrid.astro';
import { getList } from '../../lib/lists';
export const prerender = false;
const list = getList(Astro.params.slug ?? '');
if (!list) return Astro.redirect('/lists/');
---
<Base title={list.title} active={list.kind === 'film' ? 'films' : 'books'} description={list.intro}>
  <section class="pad head">
    <a class="eyebrow back" href="/lists/">Prizes and classics</a>
    <h1 class="title">{list.title}</h1>
    <p class="muted lede">{list.intro}</p>
  </section>
  <section class="pad">
    <ListGrid list={list} />
  </section>
</Base>
<style>
  .head { padding-top: 44px; padding-bottom: 28px; display: flex; flex-direction: column; align-items: flex-start; gap: 12px; }
  .back:hover { color: var(--lat); }
  .lede { margin: 0; max-width: 60ch; font-size: 16px; }
  @media (max-width: 780px) { .head { padding-top: 28px; } }
</style>
