---
// One prize or classics list: a poster grid with the year on each, and the source credited at the bottom.
import Base from '../../layouts/Base.astro';
import PosterTile from '../../components/title/PosterTile.astro';
import { getList, listTile } from '../../lib/lists';
import { markRows } from '../../lib/catalog/rows';
export const prerender = false;
const list = getList(Astro.params.slug ?? '');
if (!list) return Astro.redirect('/lists/');
const tiles = list.items.map((i) => listTile(list, i));
const [marked] = await markRows(Astro.locals.supabase, Astro.locals.me, [{ title: list.title, items: tiles.filter((t) => t.href) }]);
const status = new Map(marked.items.map((t) => [t.href, t.status]));
---
<Base title={list.title} active={list.kind === 'film' ? 'films' : 'books'} description={list.intro}>
  <section class="pad head">
    <a class="eyebrow back" href="/lists/">Prizes and classics</a>
    <h1 class="title">{list.title}</h1>
    <p class="muted lede">{list.intro}</p>
  </section>
  <section class="pad">
    <div class="grid">
      {tiles.map((t, n) => (
        <div class="cell">
          <span class="yr">{list.items[n].circa ? 'c. ' : ''}{list.items[n].year}</span>
          <PosterTile {...t} year={undefined} sub={[t.sub, list.items[n].note].filter(Boolean).join(' · ') || undefined} status={status.get(t.href)} />
        </div>
      ))}
    </div>
    <p class="credit-line">Source: {list.source.url ? <a href={list.source.url} rel="noopener">{list.source.name}</a> : list.source.name}.{list.kind === 'film' ? ' Film data from TMDB.' : ' Book data from Open Library.'}</p>
  </section>
</Base>
<style>
  .head { padding-top: 44px; padding-bottom: 28px; display: flex; flex-direction: column; align-items: flex-start; gap: 12px; }
  .back:hover { color: var(--lat); }
  .lede { margin: 0; max-width: 60ch; font-size: 16px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 28px 20px; }
  .cell { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .yr { font-size: 13px; font-weight: 600; color: var(--muted); font-variant-numeric: tabular-nums; }
  .credit-line { margin: 32px 0 0; font-size: 12px; color: var(--muted); }
  @media (max-width: 780px) { .head { padding-top: 28px; } .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px 12px; } }
</style>
