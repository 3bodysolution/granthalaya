---
// All the prize and classics lists, grouped.
import Base from '../../layouts/Base.astro';
import { GROUPS, getList, listHref } from '../../lib/lists';
export const prerender = false;
const groups = GROUPS.map((g) => ({ name: g.name, lists: g.slugs.map(getList).filter((l) => !!l) }));
---
<Base title="Prizes and classics" active="books" description="Prize winners and classics, as shelves of covers you can save from.">
  <section class="pad head">
    <h1 class="title">Prizes and classics</h1>
    <p class="muted lede">Winners of the big prizes, and books and films worth knowing, each with a cover you can save to your shelf.</p>
  </section>
  <section class="pad groups">
    {groups.map((g) => (
      <div class="grp">
        <h2 class="eyebrow">{g.name}</h2>
        <ul class="ls">
          {g.lists.map((l) => (
            <li><a class="card" href={listHref(l!.slug)}>
              <span class="ct">{l!.title}</span>
              <span class="cs">{l!.kind === 'film' ? 'Films' : 'Books'} | {l!.items.length}</span>
            </a></li>
          ))}
        </ul>
      </div>
    ))}
  </section>
</Base>
<style>
  .head { padding-top: 44px; padding-bottom: 28px; display: flex; flex-direction: column; gap: 12px; }
  .lede { margin: 0; max-width: 56ch; font-size: 16px; }
  .groups { display: flex; flex-direction: column; gap: 40px; padding-bottom: 24px; }
  .grp { display: flex; flex-direction: column; gap: 14px; }
  .ls { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 12px; }
  .card { display: flex; flex-direction: column; gap: 4px; min-height: 64px; padding: 14px 16px; border: 1px solid var(--line); border-radius: 10px; transition: border-color .2s ease, transform .2s ease; }
  .card:hover { border-color: var(--lat); color: inherit; }
  .card:active { transform: scale(.985); }
  .ct { font-weight: 600; font-size: 15px; line-height: 1.3; }
  .cs { font-size: 12.5px; color: var(--muted); font-variant-numeric: tabular-nums; }
  @media (max-width: 780px) { .head { padding-top: 28px; } }
</style>
