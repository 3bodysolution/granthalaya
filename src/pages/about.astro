---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
export const prerender = false;
const swatches = [
  { name: 'Peacock', v: '--lat', note: 'Buttons and links' },
  { name: 'Haldi', v: '--haldi', note: 'Ratings' },
  { name: 'Monsoon sky', v: '--sky', note: 'Films' },
  { name: 'Coffee', v: '--book', note: 'Books' },
  { name: 'Moss', v: '--moss', note: 'Essays' },
];
---
<Base title="About" active="about" description={`What ${site.name} is, and how it works.`}>
  <section class="pad cols">
  <div class="wrap">
    <div class="rise mark" aria-hidden="true">
      <img class="skyL" src="/img/mark-3d-day.webp" alt="" width="42" height="120" draggable="false" />
      <img class="skyD" src="/img/mark-3d-night.webp" alt="" width="42" height="120" draggable="false" />
    </div>
    <p class="eyebrow rise d1" style="color: color-mix(in srgb, var(--lat) 78%, var(--ink))">About</p>
    <h1 class="title rise d2">About Granthalaya</h1>
    <div class="rise d3 prose">
      <p class="serif first"><em>Granthalaya</em> (ग्रंथालय) is Marathi for library. It started as my own shelf: the books, films and essays I’ve spent time with, and what I thought of each. Now anyone can keep one.</p>
      <p>Each person gets a shelf for books, films, TV seasons and essays, with ratings, reviews, collections and a profile that’s public or private. Covers, runtimes and the short facts about how each one was made belong to the title, so everyone who adds it shares them. There are prize and classics lists, Marathi and Hindi books, and essays and stories in English and Marathi.</p>
      <p>The paintings use the colours of old fort walls, monsoon evenings and hills after rain. When a title has no cover, the site paints one from its name.</p>
      <p>Essays aren’t copied here. Each one links to the original, and your shelf keeps only the link and what you thought of it. Reading and watching time is worked out from runtimes, pages and word counts.</p>
      <p>Every film, show and book has its own page, with where to watch it in India and reviews from people here.</p>
      <p>What you write about a film, show or book shows on its page for everyone, and people can like it and comment. Nothing from a private account shows there.</p>
      <p class="muted">It’s free, with no ads and no tracking. Made by {site.maker}.</p>
      <p class="muted credits">This product uses the TMDB API but is not endorsed or certified by TMDB.</p>
    </div>

    <div class="rise d4 sw">
      {swatches.map((s) => (
        <div class="card swc">
          <span class="wash chipc" style={`background: var(${s.v})`}></span>
          <span class="serif" style="font-size: 18px">{s.name}</span>
          <span class="muted" style="font-size: 13px">{s.note}</span>
        </div>
      ))}
    </div>

    <div class="rise d5 links">
      <a href="/join/" class="btn primary" data-astro-prefetch="false">Start your shelf</a>
      <a href={`/@${site.founder}/`} class="btn">Visit {site.maker}’s shelf</a>
      {site.sponsor.enabled && <a href="/sponsor/" class="btn">Sponsor Granthalaya</a>}
    </div>
    <p class="rise d5 muted tip hide-touch">Tip: press <kbd>/</kbd> anywhere (or <kbd>Ctrl K</kbd>, <kbd>⌘K</kbd> on a Mac) to search films, books, essays and people.</p>
  </div>
    <div class="art desk settle d2" style="--day: url(/art/about-day.webp); --night: url(/art/about-night.webp)" aria-hidden="true"></div>
  </section>
</Base>

<style>
  .cols { padding-top: 64px; display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: clamp(32px, 5vw, 72px); align-items: start; }
  .wrap { display: flex; flex-direction: column; gap: 18px; }
  /* the writing desk, a tall painting beside the words */
  .desk { position: sticky; top: 96px; aspect-ratio: 2 / 3; border-radius: 18px; overflow: hidden; box-shadow: 0 24px 40px -24px var(--shadow); }
  .mark { margin-bottom: 8px; height: 120px; }
  .mark img { height: 120px; width: auto; filter: drop-shadow(0 14px 16px var(--shadow)); }
  .prose { display: flex; flex-direction: column; gap: 14px; margin-top: 8px; }
  .prose p { margin: 0; font-size: 17px; line-height: 1.7; }
  .prose .first { font-size: 23px; line-height: 1.55; }
  .prose .credits { font-size: 13.5px; line-height: 1.6; }
  .sw { display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 16px; margin-top: 18px; }
  .swc { padding: 16px; display: flex; flex-direction: column; gap: 6px; }
  .chipc { height: 64px; border-radius: 10px; margin-bottom: 6px; }
  .links { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 18px; }
  .tip { font-size: 14px; margin: 0; }
  kbd { font-family: inherit; font-size: 12px; border: 1px solid var(--line); border-radius: 6px; padding: 1px 6px; background: var(--card); }
  @media (max-width: 780px) {
    .cols { padding-top: 40px; grid-template-columns: 1fr; }
    .desk { position: static; order: -1; aspect-ratio: 4 / 3; background-position: center 70%; }
  }
</style>
