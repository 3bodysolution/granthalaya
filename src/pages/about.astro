---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import { site } from '../data/site';
import { getEntries } from '../lib/data';
const all = await getEntries();
const n = (t: string) => all.filter((e) => e.data.type === t).length;
const swatches = [
  { name: 'Laterite', v: '--lat', note: 'Fort walls, old brick' },
  { name: 'Haldi', v: '--haldi', note: 'Ratings, the sun' },
  { name: 'Monsoon sky', v: '--sky', note: 'Films' },
  { name: 'Moss', v: '--moss', note: 'Essays, the hills' },
];
---
<Base title="About" active="about" description={`What ${site.name} is, and how it works.`}>
  <section class="pad wrap">
    <div class="rise mark"><Logo size={64} /></div>
    <p class="eyebrow rise d1" style="color: var(--lat)">About</p>
    <h1 class="title rise d2">A small library, <em>kept by hand.</em></h1>
    <div class="rise d3 prose">
      <p class="serif first"><em>Granthalaya</em> (ग्रंथालय) is Marathi for library. This one holds everything I read, watch and keep coming back to — books, films and essays — with a few lines about each.</p>
      <p>It’s painted in {site.city}: the laterite of old fort walls, the haldi of a monsoon evening, the green of the hills after rain. Covers are painted from each title, so nothing here is borrowed artwork.</p>
      <p>Essays aren’t copied here. Each one links to the original, and this page only keeps why I saved it. Time spent is worked out on its own — runtime for films, pages for books, word count for essays — so there’s nothing to log.</p>
      <p class="num muted">So far: {n('book')} books · {n('film')} films · {n('essay')} essays.</p>
    </div>

    <div class="rise d4 sw">
      {swatches.map((s) => (
        <div class="card swc">
          <span class="wash chipc" style={`background: var(${s.v})`}></span>
          <span class="serif" style="font-size: 18px">{s.name}</span>
          <span class="muted" style="font-size: 13px">{s.note}</span>
        </div>
      ))}
    </div>

    <div class="rise d5 links">
      <a href="/library/" class="btn primary">Browse the library</a>
      <a href="/rss.xml" class="btn">Follow with RSS</a>
    </div>
    <p class="rise d5 muted tip">Tip: press <kbd>⌘K</kbd> or <kbd>/</kbd> anywhere to search.</p>
  </section>
</Base>

<style>
  .wrap { max-width: 820px; margin: 0 auto; padding-top: 64px; display: flex; flex-direction: column; gap: 18px; }
  .mark { margin-bottom: 8px; }
  .prose { display: flex; flex-direction: column; gap: 14px; margin-top: 8px; }
  .prose p { margin: 0; font-size: 17px; line-height: 1.7; }
  .prose .first { font-size: 23px; line-height: 1.55; }
  .sw { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; margin-top: 18px; }
  .swc { padding: 16px; display: flex; flex-direction: column; gap: 6px; }
  .chipc { height: 64px; border-radius: 10px; margin-bottom: 6px; }
  .links { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 18px; }
  .tip { font-size: 14px; margin: 0; }
  kbd { font-family: inherit; font-size: 12px; border: 1px solid var(--line); border-radius: 6px; padding: 1px 6px; background: var(--card); }
  @media (max-width: 780px) { .wrap { padding-top: 40px; } .sw { grid-template-columns: 1fr 1fr; } }
</style>
