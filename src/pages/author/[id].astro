---
// An author and their books, from Open Library.
import Base from '../../layouts/Base.astro';
import Face from '../../components/Face.astro';
import PosterTile from '../../components/title/PosterTile.astro';
import { author, authorKey, authorHref } from '../../lib/catalog/books';
import { slug } from '../../lib/catalog/fetch';
import { myMarks } from '../../lib/catalog/onsite';
import { savedId } from '../../lib/saved';
import EssayCard from '../../components/title/EssayCard.astro';
import { allEssays } from '../../lib/essays';
import { essayMarks } from '../../lib/catalog/onsite';
import { SourceUnavailable } from '../../lib/catalog/fetch';
export const prerender = false;

const param = String(Astro.params.id ?? '');
const key = authorKey(param);
if (!key) { Astro.response.status = 404; return Astro.rewrite('/404'); }
let a: Awaited<ReturnType<typeof author>>;
try { a = await author(key); }
catch (e) { if (e instanceof SourceUnavailable) return Astro.rewrite('/unavailable'); throw e; } // Open Library failing is not "not found"
if (!a) { Astro.response.status = 404; return Astro.rewrite('/404'); }
if (param !== `${key.toLowerCase()}-${slug(a.name)}` && slug(a.name)) return Astro.redirect(authorHref(key, a.name), 301);
const sb = Astro.locals.supabase;
const marks = sb ? await myMarks(sb, Astro.locals.me, a.books.map((b) => ({ kind: 'book', ol: b.key }))) : new Map();
// essays of theirs that we've picked
const essays = allEssays.filter((e) => e.authorKey === key);
const essayOn = essays.length ? await essayMarks(sb, Astro.locals.me, essays.map((e) => e.link)).catch(() => new Map()) : new Map();
const bioParas = a.bio.split(/\n{2,}/).filter(Boolean);
---
<Base title={a.name} description={a.bio ? a.bio.slice(0, 180) : `Books by ${a.name} on Granthalaya.`} image={a.photo}>
  <div class="art melt under-header settle banner bleed" style="--day: url(/art/library-day.webp); --night: url(/art/library-night.webp)" aria-hidden="true"></div>
  <section class="pad head">
    <div class="ph">{a.photo ? <img src={a.photo} alt="" referrerpolicy="no-referrer" onerror="this.remove()" /> : <Face name={a.name} size={140} />}</div>
    <div class="stack" style="gap: 10px; min-width: 0">
      <p class="eyebrow" style="color: var(--book)">Author</p>
      <h1 class="title">{a.name}</h1>
      {(a.born || a.died) && <p class="muted" style="margin: 0; font-size: 15px">{[a.born, a.died].filter(Boolean).join(' – ')}</p>}
      {bioParas.length > 0 && (
        <details class="bio">
          <summary><span class="bp">{bioParas[0]}</span>{bioParas.length > 1 && <span class="more-b">Read more</span>}</summary>
          {bioParas.slice(1).map((x) => <p>{x}</p>)}
        </details>
      )}
      <p class="links">
        {a.wikipedia && <a href={a.wikipedia} target="_blank" rel="noopener">Wikipedia ↗</a>}
        <a href={`https://openlibrary.org/authors/${a.key}`} target="_blank" rel="noopener">Open Library ↗</a>
      </p>
    </div>
  </section>
  <section class="pad work">
    <div class="rule"><h2 class="eyebrow">Books <span class="num">{a.books.length}</span></h2></div>
    {a.books.length === 0 ? <p class="muted">No books listed yet.</p> : (
      <div class="grid">
        {a.books.map((b) => <PosterTile href={b.href} title={b.title} year={b.year} poster={b.cover} kind="book" status={marks.get(`book:${b.key}`)?.status} logId={savedId(marks.get(`book:${b.key}`))} save={{ kind: 'book', olKey: b.key, title: b.title, creator: a.name, year: b.year, cover: b.cover }} />)}
      </div>
    )}
  </section>
  {essays.length > 0 && (
    <section class="pad work">
      <div class="rule"><h2 class="eyebrow">Essays <span class="num">{essays.length}</span></h2></div>
      <div class="egrid">
        {essays.map((e) => <EssayCard e={e} mark={essayOn.get(e.link)} />)}
      </div>
    </section>
  )}
  <p class="pad credit-line">Book data from Open Library.</p>
</Base>

<style>
  .banner { height: 220px; background-position: center 62%; }
  .head { margin-top: -70px; position: relative; display: grid; grid-template-columns: 160px minmax(0, 1fr); gap: 36px; align-items: start; }
  .ph { width: 160px; aspect-ratio: 3 / 4; border-radius: 10px; overflow: hidden; background: var(--soft); box-shadow: 0 22px 34px -18px var(--shadow); display: grid; place-items: center; }
  .ph img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .head > .stack { padding-top: 76px; }
  .bio { max-width: 680px; }
  .bio summary { list-style: none; cursor: pointer; }
  .bio summary::-webkit-details-marker { display: none; }
  .bio p, .bp { display: block; margin: 0 0 10px; font-size: 15.5px; line-height: 1.65; }
  .bio[open] .more-b { display: none; }
  .more-b { font-size: 13px; font-weight: 600; color: var(--lat); }
  .links { margin: 0; display: flex; gap: 18px; font-size: 13px; font-weight: 600; }
  .work { padding-top: 48px; display: flex; flex-direction: column; gap: 24px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 28px 20px; }
  .egrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); gap: 14px; }
  .credit-line { margin: 40px 0 0; font-size: 12px; color: var(--muted); }
  @media (max-width: 780px) {
    .head { grid-template-columns: 1fr; gap: 16px; margin-top: -40px; }
    .head > .stack { padding-top: 0; }
    .ph { width: 120px; }
    .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px 12px; }
    .egrid { grid-template-columns: 1fr; }
  }
</style>
