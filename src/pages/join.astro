---
// Where "Start your shelf" on the home page leads: what you get, what we take from Google, then the Google button. It is the same button for
// people who already have a shelf. Signed in already: on to `next` if it is safe, else the home page. `next` goes through to Google and back (safeNext keeps it on this site).
import Base from '../layouts/Base.astro';
import GoogleButton from '../components/ui/GoogleButton.astro';
import { safeNext } from '../lib/nav';
import { supabaseReady } from '../lib/supabase';
export const prerender = false;

const next = safeNext(Astro.url.searchParams.get('next'));
if (Astro.locals.me) return Astro.redirect(next);
const error = Astro.url.searchParams.get('error');
const points = [
  'Keep every book, film, show and essay in one place.',
  'Rate what you read and watch, and say what you thought.',
  'Share your shelf as a public profile, or keep it private.',
];
---
<Base title="Start your shelf" noindex>
  <section class="pad wrap">
    <div class="split rise">
      <div class="art paint" style="--day: url(/art/about-day.webp); --night: url(/art/about-night.webp)" aria-hidden="true"></div>
      <div class="side">
        <h1 class="serif h">Start your shelf</h1>
        <ul class="points">
          {points.map((p) => (
            <li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg><span>{p}</span></li>
          ))}
        </ul>
        <p class="privacy">We get your name, email and photo from Google, nothing else.</p>
        {error && <p class="notice bad">{error === 'setup' || !supabaseReady() ? 'Sign-in isn’t working right now. Please try again later.' : 'Signing in didn’t finish. Please try again.'}</p>}
        <div class="go">
          <GoogleButton next={next} />
          <p class="fine">Already have a shelf? The same button signs you in.</p>
        </div>
        <p class="fine">By continuing you agree to the <a href="/terms/">terms</a> and the <a href="/privacy/">privacy policy</a>.</p>
      </div>
    </div>
  </section>
</Base>
<style>
  .wrap { padding-top: 56px; }
  .split { max-width: 980px; margin: 0 auto; display: grid; grid-template-columns: 1.05fr 1fr; border-radius: 22px; overflow: hidden; background: var(--card); border: 1px solid var(--line); box-shadow: 0 30px 60px -30px var(--shadow); }
  .paint { background-position: center 60%; min-height: 420px; }
  .side { display: flex; flex-direction: column; justify-content: center; gap: 22px; padding: 40px; }
  .h { margin: 0; font-weight: 400; font-size: 36px; line-height: 1.1; }
  .points { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 12px; font-size: 15px; line-height: 1.45; }
  .points li { display: flex; gap: 12px; align-items: flex-start; }
  .points svg { color: var(--lat); flex-shrink: 0; margin-top: 2px; }
  .privacy { margin: 0; font-size: 15px; line-height: 1.45; color: var(--ink); }
  .go { display: flex; flex-direction: column; gap: 10px; }
  .fine { margin: 0; font-size: 12.5px; line-height: 1.5; color: var(--muted); }
  .fine a { text-decoration: underline; text-underline-offset: 2px; }
  @media (max-width: 780px) { .wrap { padding-top: 24px; } .split { grid-template-columns: 1fr; } .paint { height: 200px; min-height: 0; } .side { padding: 28px 22px; } }
</style>
