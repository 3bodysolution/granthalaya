---
import Base from '../../layouts/Base.astro';
import Tile from '../../components/Tile.astro';
import Cover from '../../components/Cover.astro';
import { getEntries, href, stars, starsLabel, short, kind, typeColor } from '../../lib/data';

const all = await getEntries();
const years = [...new Set(all.map((e) => e.data.date.getUTCFullYear()))].sort((a, b) => b - a);
const byYear = years.map((y) => ({ y, items: all.filter((e) => e.data.date.getUTCFullYear() === y) }));
const count = (list: typeof all, t?: string) => (t ? list.filter((e) => e.data.type === t).length : list.length);
const tabs = [
  { key: 'all', label: 'All', n: all.length },
  { key: 'book', label: 'Books', n: count(all, 'book') },
  { key: 'film', label: 'Films', n: count(all, 'film') },
  { key: 'essay', label: 'Essays', n: count(all, 'essay') },
];
---
<Base title="Library" active="library" description="Every book, film and essay, by year.">
  <div class="art melt settle banner bleed" style="--day: url(/art/library-day.webp); --night: url(/art/library-night.webp)" aria-hidden="true"></div>

  <div id="lib" data-view="grid" data-type="all">
    <section class="pad head rise">
      <h1 class="title">Library</h1>
      <div class="seg" role="group" aria-label="Layout">
        <button data-view-btn="grid" aria-pressed="true">Covers</button>
        <button data-view-btn="list" aria-pressed="false">List</button>
      </div>
    </section>

    <div class="pad rise d1">
      <div class="tabs" role="tablist" aria-label="Type">
        {tabs.map((t, i) => (
          <button role="tab" data-type-btn={t.key} aria-selected={i === 0 ? 'true' : 'false'}>{t.label} <span class="num">{t.n}</span></button>
        ))}
      </div>
    </div>

    {byYear.map(({ y, items }, i) => (
      <section class:list={['pad year rise', i === 0 ? 'd2' : 'd3']}>
        <details open={i === 0} class="yr">
          <summary>
            <span class="serif yn">{y}</span>
            <span class="more toggle" style="color: var(--lat)" aria-hidden="true"><span class="o">Show ↓</span><span class="c">Hide ↑</span></span>
          </summary>
          <div class="shelf grid">
            {items.map((e) => <Tile entry={e} vt />)}
          </div>
          <div class="list" role="table" aria-label={`Library ${y}`}>
            <div class="lrow lh" role="row"><span></span><span>Title</span><span>By</span><span>Type</span><span>Rating</span><span style="text-align: right">Date</span></div>
            {items.map((e) => (
              <a href={href(e)} class="lrow" role="row" data-type={e.data.type}>
                <Cover entry={e} variant="swatch" />
                <span class="serif lt">{e.data.title}</span>
                <span class="muted ell">{e.data.creator}</span>
                <span class="lk" style={`color: ${typeColor(e.data.type)}`}>{kind(e)}</span>
                <span class="stars" role="img" aria-label={starsLabel(e)}>{stars(e) || '—'}</span>
                <span class="num muted" style="text-align: right">{short(e.data.date)}</span>
              </a>
            ))}
          </div>
          <p class="none muted">Nothing of this kind in {y}.</p>
        </details>
      </section>
    ))}
  </div>
</Base>

<style>
  .banner { height: clamp(220px, 27vw, 400px); background-position: center 62%; }
  .head { margin-top: -28px; position: relative; display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; }
  .tabs { margin-top: 24px; display: flex; gap: 32px; border-bottom: 1px solid var(--line); overflow-x: auto; scrollbar-width: none; }
  .tabs button { height: 50px; padding: 0; background: transparent; border: 0; border-bottom: 2px solid transparent; color: var(--muted); font-size: 13px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; cursor: pointer; white-space: nowrap; transition: color .3s ease, border-color .3s ease; }
  .tabs button span { color: var(--muted); font-weight: 500; margin-left: 4px; }
  .tabs button[aria-selected="true"] { color: var(--ink); border-bottom-color: var(--lat); }
  .tabs button:hover { color: var(--ink); }

  .year { padding-top: 32px; }
  .yr summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-bottom: 22px; }
  .yr summary::-webkit-details-marker { display: none; }
  .yn { font-size: 32px; }
  .yr[open] .o, .yr:not([open]) .c { display: none; }
  .yr:not([open]) summary { background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 16px 24px; box-shadow: 0 12px 24px -16px var(--shadow); margin-bottom: 0; }
  .yr[open] > .grid, .yr[open] > .list { animation: rise .7s var(--spring) backwards; }

  #lib[data-view="grid"] .list, #lib[data-view="list"] .grid { display: none; }
  .lrow { display: grid; grid-template-columns: 44px minmax(0, 1fr) 180px 90px 120px 80px; align-items: center; gap: 20px; min-height: 68px; padding: 0 16px; border-bottom: 1px solid var(--line); border-radius: 10px; transition: background-color .3s ease; }
  a.lrow:hover { background: var(--card); color: inherit; }
  .lh { min-height: 36px; font-size: 11px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); }
  .lt { font-size: 18px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ell { font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .lk { font-size: 12px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; }
  .lrow .num { font-size: 13px; }
  .lrow :global(.sw) { margin: 10px 0; }

  .none { display: none; margin: 0; font-size: 15px; }
  :global(.is-hidden) { display: none !important; }
  .yr.empty .none { display: block; }

  @media (max-width: 780px) {
    .banner { height: 190px; }
    .head { margin-top: -12px; }
    .lrow { grid-template-columns: 40px minmax(0, 1fr) auto; gap: 14px; }
    .lrow > :nth-child(3), .lrow > :nth-child(4), .lrow > :nth-child(6) { display: none; }
    .tabs { gap: 22px; }
  }
</style>

<script>
  function setup() {
    const lib = document.getElementById('lib');
    if (!lib) return;
    const setView = (v: string) => {
      lib.dataset.view = v;
      lib.querySelectorAll<HTMLElement>('[data-view-btn]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.viewBtn === v)));
      try { localStorage.setItem('libView', v); } catch (e) {}
    };
    const setType = (t: string, push = true) => {
      lib.dataset.type = t;
      lib.querySelectorAll<HTMLElement>('[data-type-btn]').forEach((b) => b.setAttribute('aria-selected', String(b.dataset.typeBtn === t)));
      lib.querySelectorAll<HTMLElement>('.yr').forEach((yr) => {
        let shown = 0;
        yr.querySelectorAll<HTMLElement>('.grid > .tile, .list > a.lrow').forEach((el) => {
          const ok = t === 'all' || el.dataset.type === t;
          el.classList.toggle('is-hidden', !ok);
          if (ok && el.classList.contains('tile')) shown++;
        });
        yr.classList.toggle('empty', shown === 0);
      });
      if (push) {
        const u = new URL(location.href);
        t === 'all' ? u.searchParams.delete('type') : u.searchParams.set('type', t);
        history.replaceState(history.state, '', u);
      }
    };
    lib.addEventListener('click', (ev) => {
      const el = ev.target as Element;
      const v = el.closest<HTMLElement>('[data-view-btn]');
      if (v) setView(v.dataset.viewBtn!);
      const t = el.closest<HTMLElement>('[data-type-btn]');
      if (t) setType(t.dataset.typeBtn!);
    });
    let saved = 'grid';
    try { saved = localStorage.getItem('libView') || 'grid'; } catch (e) {}
    setView(saved);
    const q = new URLSearchParams(location.search).get('type');
    if (q && ['book', 'film', 'essay'].includes(q)) setType(q, false);
  }
  document.addEventListener('astro:page-load', setup);
</script>
