---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Cover from '../../components/Cover.astro';
import {
  getEntries, getThreads, href, palette, coverSrc, radius, stars, starsLabel, long, ticketDate, timesWord,
  minutes, duration, kind, threadsFor, excerpt, type Entry,
} from '../../lib/data';

export async function getStaticPaths() {
  const all = await getEntries();
  return all.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props as { entry: Entry };
const d = entry.data;
const { Content } = await render(entry);
const all = await getEntries();
const threads = await getThreads();
const inThreads = threadsFor(entry, threads);
const p = palette(entry);
const cover = coverSrc(entry);
const tname = `cover-${entry.id.replace(/[^a-z0-9-]/gi, '')}`;
const bySlug = new Map(all.map((e) => [e.id, e]));

// "Sits well next to": neighbours from the same threads, then the same kind
const related: Entry[] = [];
for (const t of inThreads) for (const it of t.items) {
  const e = bySlug.get(it.slug);
  if (e && e.id !== entry.id && !related.includes(e)) related.push(e);
}
for (const e of all) if (related.length < 6 && e.id !== entry.id && e.data.type === d.type && !related.includes(e)) related.push(e);
const rel = related.slice(0, 6);

// film number this year, for the ticket
const year = d.date.getUTCFullYear();
const filmNo = all.filter((e) => e.data.type === 'film' && e.data.date.getUTCFullYear() === year)
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime()).findIndex((e) => e.id === entry.id) + 1;

const q = encodeURIComponent(d.title + (d.type === 'book' ? ' ' + d.creator : ''));
const findOn = d.type === 'film'
  ? [{ label: 'Letterboxd', url: `https://letterboxd.com/search/films/${encodeURIComponent(d.title)}/` }, { label: 'IMDb', url: `https://www.imdb.com/find/?q=${encodeURIComponent(d.title + ' ' + (d.year ?? ''))}` }]
  : [{ label: 'Goodreads', url: `https://www.goodreads.com/search?q=${q}` }, { label: 'Open Library', url: `https://openlibrary.org/search?q=${q}` }];
if (d.link && d.type !== 'essay') findOn.unshift({ label: new URL(d.link).hostname.replace('www.', ''), url: d.link });

const s = stars(entry);
const mins = minutes(entry);
const inProgress = d.status !== 'done';
const nav = inThreads[0];
const prev = nav && nav.pos > 1 ? bySlug.get(nav.items[nav.pos - 2].slug) : undefined;
const next = nav && nav.pos < nav.of ? bySlug.get(nav.items[nav.pos].slug) : undefined;
const desc = excerpt(entry, 150) || `${d.title} by ${d.creator}`;
---
<Base title={d.title} active="library" description={desc}>
  {d.type !== 'essay' ? (
    <>
      <div class="art melt banner settle bleed" style="--day: url(/art/library-day.webp); --night: url(/art/library-night.webp)" aria-hidden="true"></div>

      <section class="pad top">
        <div class="side">
          {d.type === 'film' ? (
            <div class="hero-film" transition:name={tname}>
              <div class:list={['hc', cover ? 'real' : 'wash']} style={`background: ${p.bg}`}>
                {cover && <img class="pic" src={cover} alt={`${d.title} poster`} decoding="async" draggable="false" />}
                <i class="sun" style={`background: ${p.accent}`}></i><i class="hill" style={`background: ${p.hill}`}></i>
                <span class="hk">Film{d.year ? ` · ${d.year}` : ''}</span>
                <span class="serif ht">{d.title}</span>
              </div>
              <div class="type stub lg ticket">
                <div class="tr"><b>ADMIT ONE</b>{filmNo > 0 && <span class="num">FILM {filmNo} / {year}</span>}</div>
                <span>{ticketDate(d.date)}{d.where ? ` · ${d.where.toUpperCase()}` : ''}</span>
              </div>
            </div>
          ) : (
            <div class:list={['hc hero-book', cover ? 'real' : 'wash']} style={`background: ${p.bg}`} transition:name={tname}>
              {cover && <img class="pic" src={cover} alt={`${d.title} cover`} decoding="async" draggable="false" />}
              <i class="spine"></i><i class="sun" style={`background: ${p.accent}`}></i><i class="hill" style={`background: ${p.hill}`}></i>
              <span class="hk">Book{d.year ? ` · ${d.year}` : ''}</span>
              <span class="bt"><span class="serif ht">{d.title}</span><span class="hb">{d.creator}</span></span>
            </div>
          )}
          <div class="find rise d5">
            <p class="eyebrow" style="font-size: 11px">Find it on</p>
            {findOn.slice(0, 3).map((f) => <a href={f.url} class="btn" target="_blank" rel="noopener">{f.label} <span aria-hidden="true">↗</span></a>)}
          </div>
        </div>

        <div class="main">
          <a href="/library/" class="more rise d2 muted">← Library</a>
          <h1 class="title bigtitle rise d3">{d.title}</h1>
          <p class="rise d3 meta">
            {d.type === 'film'
              ? [d.year, `Directed by ${d.creator}`].filter(Boolean).join(' · ')
              : [d.creator, d.year, d.pages && `about ${Math.round(d.pages / 10) * 10} pages`].filter(Boolean).join(' · ')}
          </p>
          <div class="stats rise d4 num">
            <div class="stat"><span class="eyebrow">{inProgress ? 'Status' : 'My rating'}</span>
              {inProgress
                ? <b>{d.type === 'book' ? `Reading · ${d.progress ?? 0}%` : 'Watching'}</b>
                : <span class="bigstars" role="img" aria-label={starsLabel(entry)}>{s || '—'}</span>}
            </div>
            <div class="stat"><span class="eyebrow">{d.type === 'film' ? 'Watched' : inProgress ? 'Started' : 'Finished'}</span><b>{long(d.date)}</b></div>
            <div class="stat"><span class="eyebrow">{d.type === 'film' ? 'Runtime' : 'Reading time'}</span><b>{d.type === 'film' ? duration(mins) : `≈ ${duration(d.type === 'book' && inProgress ? Math.round((d.pages ?? 250) * 1.1) : mins)}`}</b></div>
            <div class="stat"><span class="eyebrow">{d.type === 'film' ? 'Times seen' : 'Times read'}</span><b>{timesWord(d.times, d.type === 'film' ? 'watch' : 'read')}</b></div>
          </div>
          <div class="note rise d5"><Content /></div>
          {inThreads.length > 0 && (
            <div class="chips rise d6">
              <span class="eyebrow" style="margin-right: 4px">In threads</span>
              {inThreads.map((t, i) => <a href={`/threads/${t.id}/`} class:list={['chip', i === 0 && 'on']}>{t.title} · {t.pos} of {t.of}</a>)}
              {d.startHere && <a href="/" class="chip">Start here · no. {d.startHere}</a>}
            </div>
          )}
        </div>
      </section>

      {d.highlights.length > 0 && (
        <section class="pad block rise d6">
          <div class="rule"><h2 class="eyebrow">{d.highlights.every((h) => h.mine) ? 'Lines I wrote after' : 'My highlights'}</h2><a href="/notes/" class="more">All in Notes →</a></div>
          <div class="hl">
            {d.highlights.map((h) => (
              <article class="card lift hlc">
                <p class="serif q">{h.mine ? h.text : `“${h.text}”`}</p>
                {h.note && <p class="soft-note"><span class="eyebrow">My note</span>{h.note}</p>}
                {h.where && <span class="num muted" style="margin-top: auto; font-size: 12px">{h.where}</span>}
              </article>
            ))}
          </div>
        </section>
      )}
    </>
  ) : (
    <article class="essay-page">
      <a href="/library/" class="more rise muted">← Library</a>
      <p class="eyebrow rise d1" style="color: var(--moss)">Essay · {d.source ?? 'on the web'} · {d.creator}</p>
      <h1 class="serif rise d2 et" transition:name={tname}>{d.title}</h1>
      <p class="rise d2 num muted" style="margin: 0; font-size: 15px">
        {mins}-minute read · saved {long(d.date)}{s && <> · <span style="color: var(--lat)">{s}</span></>}
      </p>
      <div class="rise d3 inline">
        {d.link && <a href={d.link} class="btn primary big" target="_blank" rel="noopener">Read the original on {d.source ?? new URL(d.link).hostname} <span aria-hidden="true">↗</span></a>}
        {d.link && <button class="btn big" data-copy={d.link}>Copy link</button>}
      </div>
      <section class="card rise d4 why">
        <p class="eyebrow">Why I saved it</p>
        <div class="note essay-note"><Content /></div>
        <p class="muted" style="margin: 0; font-size: 14px">The essay itself lives on {d.source ?? 'its own site'}. This page only keeps the link and what I thought.</p>
      </section>
      {inThreads.length > 0 && (
        <div class="chips rise d5">
          <span class="eyebrow" style="margin-right: 4px">In threads</span>
          {inThreads.map((t, i) => <a href={`/threads/${t.id}/`} class:list={['chip', i === 0 && 'on']}>{t.title} · {t.pos} of {t.of}</a>)}
        </div>
      )}
      {(prev || next) && (
        <div class="pn rise d5">
          {prev ? <a href={href(prev)} class="stack" style="gap: 4px"><span class="eyebrow" style="font-size: 11px">← Previous in thread</span><span class="serif" style="font-size: 18px">{prev.data.title}</span></a> : <span></span>}
          {next && <a href={href(next)} class="stack" style="gap: 4px; text-align: right"><span class="eyebrow" style="font-size: 11px">Next in thread →</span><span class="serif" style="font-size: 18px">{next.data.title}</span></a>}
        </div>
      )}
    </article>
  )}

  {rel.length > 0 && (
    <section class="pad block rise d6">
      <div class="rule"><h2 class="eyebrow">Sits well next to</h2>{inThreads[0] ? <a href={`/threads/${inThreads[0].id}/`} class="more">Open the thread →</a> : <a href="/library/" class="more">The library →</a>}</div>
      <div class="rel">
        {rel.map((e) => (
          <a href={href(e)} class="lift stack" style="gap: 10px">
            <Cover entry={e} variant="mini" />
            <span class="muted" style="font-size: 12px">{kind(e)} · {e.data.creator}</span>
          </a>
        ))}
      </div>
    </section>
  )}
</Base>

<style>
  @keyframes hero { from { opacity: .4; transform: translateY(40px) scale(.9); } to { opacity: 1; transform: none; } }
  .banner { height: 280px; background-position: center 62%; }
  .top { position: relative; margin-top: -170px; display: flex; gap: 56px; align-items: flex-start; }
  .side { flex-shrink: 0; width: 260px; display: flex; flex-direction: column; gap: 12px; }
  .hero-film, .hero-book { animation: hero .95s var(--spring) backwards; }
  .hero-film { display: flex; flex-direction: column; filter: drop-shadow(0 22px 22px var(--shadow)); }
  .hc { color: #F6EEDF; display: flex; flex-direction: column; justify-content: space-between; box-sizing: border-box; }
  .hc > * { position: relative; }
  .hc.real { position: relative; overflow: hidden; }
  .hc .pic { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 30%; }
  .hc.real > :not(.pic):not(.spine) { visibility: hidden; }
  .hc.real .spine { z-index: 1; }
  .hc .sun, .hc .hill, .hc .spine { position: absolute; display: block; }
  .hc .sun { width: 170px; height: 170px; border-radius: 50%; right: -40px; top: 90px; opacity: .78; }
  .hc .hill { left: -20%; width: 140%; bottom: -12px; height: 125px; border-radius: 50% 50% 0 0; }
  .hc .spine { left: 0; top: 0; bottom: 0; width: 16px; background: linear-gradient(90deg, rgba(0,0,0,.32), rgba(255,255,255,.08) 70%, rgba(0,0,0,0)); }
  .hero-film .hc { height: 330px; border-radius: 8px 8px 0 0; padding: 20px; }
  .hero-book { height: 375px; border-radius: 3px 8px 8px 3px; padding: 22px 20px 22px 30px; box-shadow: 4px 4px 0 -1px var(--card), 5px 5px 0 -1px var(--line), 8px 8px 0 -2px var(--card), 9px 9px 0 -2px var(--line), 12px 22px 30px -10px var(--shadow); }
  .hk { font-size: 11px; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; opacity: .85; }
  .ht { font-size: 34px; line-height: 1.02; overflow-wrap: anywhere; }
  .bt { display: flex; flex-direction: column; gap: 6px; }
  .hb { font-size: 12px; opacity: .85; }
  .ticket { background: var(--card); border-top: 2px dashed var(--line); border-radius: 0 0 8px 8px; padding: 16px 20px; display: flex; flex-direction: column; gap: 4px; }
  .ticket .tr { display: flex; justify-content: space-between; gap: 8px; }
  .ticket b { font-size: 14px; letter-spacing: .22em; color: var(--lat); }
  .ticket span { font-size: 12px; color: var(--muted); }
  .find { display: flex; flex-direction: column; gap: 8px; margin-top: 14px; }
  .find .btn { justify-content: space-between; }

  .main { flex: 1; min-width: 0; padding-top: 176px; display: flex; flex-direction: column; gap: 18px; }
  .bigtitle { font-size: clamp(42px, 5.5vw, 64px); line-height: 1; }
  .meta { margin: 0; font-size: 16px; color: var(--muted); }
  .stats { display: flex; flex-wrap: wrap; gap: 20px 48px; padding: 20px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); margin-top: 6px; }
  .stat { display: flex; flex-direction: column; gap: 6px; }
  .stat b { font-weight: 400; font-size: 18px; }
  .bigstars { font-size: 24px; color: var(--haldi); letter-spacing: .06em; }
  .note { max-width: 660px; display: flex; flex-direction: column; gap: 14px; }
  .note :global(p) { margin: 0; font-size: 16px; line-height: 1.7; color: var(--muted); }
  .note :global(p:first-child) { margin-top: 6px; font-family: Fraunces, Georgia, serif; font-size: 23px; line-height: 1.6; color: var(--ink); }
  .note :global(p:first-child::first-letter) { float: left; font-size: 72px; line-height: .85; padding: 6px 10px 0 0; color: var(--lat); }
  .chips { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-top: 6px; }

  .block { padding-top: 64px; display: flex; flex-direction: column; gap: 24px; }
  .hl { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .hlc { padding: 26px; display: flex; flex-direction: column; gap: 16px; }
  .q { margin: 0; font-size: 20px; line-height: 1.5; font-style: italic; }
  .rel { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 28px; }

  .essay-page { width: min(720px, calc(100% - 2 * var(--gut))); margin: 0 auto; padding-top: 64px; display: flex; flex-direction: column; gap: 22px; }
  .et { margin: 0; font-weight: 400; font-size: clamp(40px, 5vw, 56px); line-height: 1.05; letter-spacing: -.02em; }
  .inline { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 6px; }
  .why { margin-top: 22px; padding: 30px; display: flex; flex-direction: column; gap: 14px; }
  .essay-note :global(p:first-child) { font-size: 22px; margin-top: 0; }
  .essay-note :global(p:first-child::first-letter) { float: none; font-size: inherit; padding: 0; color: inherit; }
  .pn { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding-top: 22px; margin-top: 12px; border-top: 1px solid var(--line); }

  @media (max-width: 1100px) {
    .rel { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .hl { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 780px) {
    .banner { height: 200px; }
    .top { flex-direction: column; margin-top: -150px; gap: 28px; }
    .side { width: 100%; align-items: center; }
    .hero-film, .hero-book { width: 220px; }
    .hero-film .hc { height: 280px; }
    .hero-book { height: 320px; }
    .find { width: 100%; }
    .ticket { padding: 14px 16px; }
    .ticket b { font-size: 12px; letter-spacing: .16em; }
    .ticket span { font-size: 11px; }
    .main { padding-top: 0; }
    .stats { gap: 18px 32px; }
    .hl { grid-template-columns: 1fr; }
    .rel { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
    .note :global(p:first-child) { font-size: 20px; }
    .essay-page { padding-top: 36px; }
  }
</style>

