---
// Books. With no filters it's a front page: rows of popular books, then ways to browse. With filters
// (subject, original language, decade, order) it's a grid from Open Library. Every linked year, subject and
// language on a book page comes here.
import Base from '../../layouts/Base.astro';
import PosterTile from '../../components/title/PosterTile.astro';
import Filters from '../../components/title/Filters.astro';
import YearStrip from '../../components/title/YearStrip.astro';
import Pager from '../../components/title/Pager.astro';
import FrontRows from '../../components/title/FrontRows.astro';
import { bookRows, markRows } from '../../lib/catalog/rows';
import { browseBooks, BOOK_LANGUAGES, bookLanguageName } from '../../lib/catalog/books';
import ListGrid from '../../components/title/ListGrid.astro';
import { listsOfKind, pickList, listDecades, listBrowseHref, suggestedLists, type CatalogList } from '../../lib/lists';
import { myMarks } from '../../lib/catalog/onsite';
import { savedId } from '../../lib/saved';
export const prerender = false;

const SUBJECTS: [string, string][] = [
  ['fiction', 'Fiction'], ['literary-fiction', 'Literary fiction'], ['historical-fiction', 'Historical fiction'], ['mystery', 'Mystery'],
  ['thriller', 'Thrillers'], ['science-fiction', 'Science fiction'], ['fantasy', 'Fantasy'], ['romance', 'Romance'], ['horror', 'Horror'],
  ['short-stories', 'Short stories'], ['poetry', 'Poetry'], ['drama', 'Plays'], ['essays', 'Essays'], ['biography', 'Biography'],
  ['autobiography', 'Memoir'], ['history', 'History'], ['philosophy', 'Philosophy'], ['psychology', 'Psychology'], ['self-help', 'Self-help'],
  ['science', 'Science'], ['politics', 'Politics'], ['religion', 'Religion'], ['travel', 'Travel'], ['humor', 'Humour'], ['graphic-novels', 'Graphic novels'],
];
const q = Astro.url.searchParams;
const rawSubject = (q.get('subject') ?? '').toLowerCase();
const subject = /^[a-z0-9]+(-[a-z0-9]+)*$/.test(rawSubject) && rawSubject.length <= 60 ? rawSubject : undefined;
const language = /^[a-z]{3}$/.test(q.get('language') ?? '') ? q.get('language')! : undefined;
const yr = Number(q.get('year')); const year = Number.isInteger(yr) && yr > 0 && yr < 2100 ? yr : undefined;
const dc = parseInt(String(q.get('decade') ?? ''), 10); const decade = !year && Number.isInteger(dc) && dc >= 1000 && dc < 2100 ? dc - (dc % 10) : undefined;
const sort = (['popular', 'top', 'new'] as const).find((s) => s === q.get('sort')) ?? 'popular';
const page = Math.max(1, Math.min(100, Number(q.get('page')) || 1));

// a prize or classics list chosen in the filter bar shows in place; the other filters don't apply to it (Decade does)
const front = [...q.keys()].length === 0;
const sb = Astro.locals.supabase;
const suggestedP = suggestedLists(sb).catch(() => [] as CatalogList[]);
// the rows are started now and waited for further down the page (FrontRows), so the top of the page is sent first
const rowsP = front ? bookRows(suggestedP).then((r) => markRows(sb, Astro.locals.me, r)).catch(() => []) : null;
const suggested = await suggestedP;
const bookLists = [...listsOfKind('book'), ...suggested];
const picked = pickList(q.get('list'), 'book') ?? suggested.find((l) => l.slug === q.get('list'));
const list = front || picked ? { items: [], total: 0, pages: 0 } : await browseBooks({ subject, language, year, decade, sort, page });
const marks = sb && !front && !picked ? await myMarks(sb, Astro.locals.me, list.items.map((b) => ({ kind: 'book', ol: b.key }))) : new Map();

const known = SUBJECTS.find(([s]) => s === subject)?.[1];
const subjectName = subject ? known ?? subject.replace(/-/g, ' ').replace(/^./, (c) => c.toUpperCase()) : '';
const langName = language ? bookLanguageName(language) : '';
let title = subject ? (known ? `${langName ? langName + ' ' : ''}${known.toLowerCase()}` : `${langName ? langName + ' books' : 'Books'} about ${subjectName.toLowerCase()}`) : `${langName ? langName + ' ' : ''}books`;
title += year ? ` from ${year}` : decade ? ` from the ${decade}s` : '';
title = title.replace(/^./, (c) => c.toUpperCase());
if (picked) title = picked.title;

const now = new Date().getUTCFullYear();
const decades: [string, string][] = Array.from({ length: Math.floor((now - 1850) / 10) + 1 }, (_, i) => { const d = Math.floor(now / 10) * 10 - i * 10; return [String(d), `${d}s`]; });
const subjects: [string, string][] = [['', 'Any subject'], ...(subject && !known ? [[subject, subjectName]] as [string, string][] : []), ...SUBJECTS];
const subjectLinks = SUBJECTS.map(([k, n]) => [`/books/?subject=${k}`, n]);
const langLinks = BOOK_LANGUAGES.slice(0, 14).map(([c, n]) => [`/books/?language=${c}`, n]);
const decadeLinks = decades.slice(0, 10).map(([d, n]) => [`/books/?decade=${d}`, n]);
const listDec = picked ? listDecades(picked) : [];
const dcPicked = picked && decade && listDec.some(([d]) => d === String(decade)) ? decade : undefined;
const listNames = ['subject', 'language', 'decade', 'year', 'sort'];
const resets = picked ? ['list'] : undefined; // changing any other filter leaves the list
const fields = [
  { name: 'subject', label: 'Subject', value: picked ? '' : subject ?? '', options: subjects, clears: resets },
  { name: 'language', label: 'Language', value: picked ? '' : language ?? '', options: [['', 'Any language'], ...(language && !BOOK_LANGUAGES.some(([c]) => c === language) ? [[language, langName ?? language]] : []), ...BOOK_LANGUAGES] as [string, string][], clears: resets },
  picked
    ? { name: 'decade', label: 'Year', value: dcPicked ? String(dcPicked) : '', options: [['', 'Any year'], ...listDec] as [string, string][] }
    : { name: 'when', label: 'Year', value: year ? `year=${year}` : decade ? `decade=${decade}` : '', text: year ? String(year) : decade ? `${decade}s` : undefined, options: [['', 'Any year'], ...decades.map(([d, n]) => [`decade=${d}`, n])] as [string, string][] },
  { name: 'list', label: 'Lists', value: picked?.slug ?? '', options: [['', 'Prizes and classics'], ...bookLists.map((l) => [l.slug, l.title] as [string, string])] as [string, string][], clears: listNames },
  { name: 'sort', label: 'Order', value: picked ? '' : sort === 'popular' ? '' : sort, options: [['', 'Popular'], ['top', 'Highest rated'], ['new', 'Newest']] as [string, string][], clears: resets },
];
---
<Base title={title} active="books" description={`${title} on Granthalaya: browse, save and log.`}>
  <section class="pad head">
    {!front && <p class="eyebrow" style="color: var(--book)">Books</p>}
    <h1 class="title">{title}</h1>
    <Filters fields={fields} />
    {!picked && !front && <YearStrip decade={decade} year={year} min={1800} total={list.total} line={`There are ${list.total.toLocaleString('en-US')} ${langName ? langName + ' ' : ''}books${known ? ' in ' + known.toLowerCase() : subject ? ' about ' + subjectName.toLowerCase() : ''} first published in ${year ? year : `the ${decade}s`}.`} />}
  </section>
  {front ? (
    <section class="pad rows">
      <FrontRows rows={rowsP!} />
      <div class="browse">
        <div class="bset"><h2 class="eyebrow">By subject</h2><div class="chips">{subjectLinks.map(([h, n]) => <a class="gchip" href={h}>{n}</a>)}</div></div>
        <div class="bset"><h2 class="eyebrow">By original language</h2><div class="chips">{langLinks.map(([h, n]) => <a class="gchip" href={h}>{n}</a>)}</div></div>
        <div class="bset"><h2 class="eyebrow">By decade</h2><div class="chips">{decadeLinks.map(([h, n]) => <a class="gchip" href={h}>{n}</a>)}</div></div>
        <div class="bset"><h2 class="eyebrow">Prizes and classics</h2><div class="chips">{bookLists.map((l) => <a class="gchip" href={listBrowseHref(l)}>{l.title}</a>)}<a class="gchip" href="/lists/">All lists</a></div></div>
      </div>
      <p class="credit-line">Book data from Open Library.</p>
    </section>
  ) : picked ? (
    <section class="pad">
      <p class="muted lede">{picked.intro}</p>
      <ListGrid list={picked} decade={dcPicked} />
    </section>
  ) : (
  <section class="pad">
    {list.items.length === 0 ? (
      <div class="empty">
        <p class="muted">Nothing matches all of that{language ? ', and Open Library has few books in some Indian languages' : ''}. Try fewer filters.</p>
        <a href="/add/?type=book" class="btn">Add a book by hand</a>
      </div>
    ) : (
      <div class="pgrid">
        {list.items.map((b) => <PosterTile bare href={b.href} title={b.title} year={b.year} poster={b.cover} kind="book" sub={b.author} status={marks.get(`book:${b.key}`)?.status} logId={savedId(marks.get(`book:${b.key}`))} save={{ kind: 'book', olKey: b.key, title: b.title, creator: b.author, year: b.year, cover: b.cover }} />)}
      </div>
    )}
    <Pager page={page} pages={list.pages} />
    <p class="credit-line">Book data from Open Library.</p>
  </section>
  )}
</Base>
<style>
  .head { padding-top: 44px; padding-bottom: 28px; display: flex; flex-direction: column; align-items: flex-start; gap: 14px; }
  .lede { margin: 0 0 28px; max-width: 60ch; font-size: 16px; }
  .empty { display: flex; flex-direction: column; align-items: flex-start; gap: 14px; font-size: 16px; }
  .empty p { margin: 0; }
  .credit-line { margin: 32px 0 0; font-size: 12px; color: var(--muted); }
  .rows { display: flex; flex-direction: column; gap: 48px; padding-bottom: 8px; }
  .browse { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px 48px; padding-top: 8px; }
  .bset { display: flex; flex-direction: column; gap: 12px; }
  .bset:first-child { grid-column: 1 / -1; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .chips .gchip:hover { color: var(--ink); }
  .rows .credit-line { margin-top: -16px; }
  @media (max-width: 780px) { .browse { grid-template-columns: 1fr; } .rows { gap: 36px; } }
  @media (max-width: 780px) { .head { padding-top: 28px; } }
</style>
