---
// Sponsor Granthalaya: a note and a way to pay by UPI. Everything sits straight on the page (no painting band, no card). On a phone, amount
// buttons open the UPI app; on a computer, a QR code framed like a postage stamp and the UPI ID. The footer's valley follows straight after.
import QRCode from 'qrcode';
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
export const prerender = false;

const { upi, payee } = site.support;
const link = (amount?: number) =>
  `upi://pay?pa=${upi}&pn=${encodeURIComponent(payee)}&cu=INR&tn=${encodeURIComponent('Support Granthalaya')}${amount ? `&am=${amount}` : ''}`;
const amounts = [50, 100, 250, 500];

// The stamp: one drawing, a white paper with a perforated edge (a half circle bitten out of each edge, evenly along it) and the code inside.
// The code is always dark on white, so every UPI app can read it, in dark mode too.
const CODE = 208, PAD = 15, SIDE = CODE + PAD * 2, HOLES = 16, R = 4.6;
const qr = (await QRCode.toString(link(), { type: 'svg', margin: 2, width: CODE, color: { dark: '#1F1C18', light: '#FFFFFF' } }))
  .replace('<svg ', `<svg x="${PAD}" y="${PAD}" `);
const cell = SIDE / HOLES;
let edge = `M0 0`;
for (let i = 0; i < HOLES; i++) edge += `H${(i * cell + cell / 2 - R).toFixed(2)}a${R} ${R} 0 0 0 ${2 * R} 0`;
edge += `H${SIDE}`;
for (let i = 0; i < HOLES; i++) edge += `V${(i * cell + cell / 2 - R).toFixed(2)}a${R} ${R} 0 0 0 0 ${2 * R}`;
edge += `V${SIDE}`;
for (let i = HOLES - 1; i >= 0; i--) edge += `H${(i * cell + cell / 2 + R).toFixed(2)}a${R} ${R} 0 0 0 ${-2 * R} 0`;
edge += `H0`;
for (let i = HOLES - 1; i >= 0; i--) edge += `V${(i * cell + cell / 2 + R).toFixed(2)}a${R} ${R} 0 0 0 0 ${-2 * R}`;
edge += 'Z';
---
<Base title="Sponsor Granthalaya">
  <section class="pad wrap sponsor-page">
    <svg class="heart rise d1" width="26" height="26" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21.2 10.6 20C5.4 15.3 2 12.2 2 8.4 2 5.4 4.4 3 7.4 3c1.7 0 3.4.8 4.6 2.1C13.2 3.8 14.9 3 16.6 3 19.6 3 22 5.4 22 8.4c0 3.8-3.4 6.9-8.6 11.6L12 21.2z" fill="#E5484D"/></svg>
    <h1 class="serif h rise d1">Sponsor Granthalaya</h1>
    <p class="note rise d2">Granthalaya is free. Your support helps us pay for hosting and the costs of running the site. It’s entirely optional, and everything on the site stays free.</p>

    <div class="phone rise d3">
      <div class="amounts">
        {amounts.map((a) => <a class="pill" href={link(a)} data-astro-prefetch="false">₹{a}</a>)}
      </div>
      <a class="pill fill" href={link()} data-astro-prefetch="false">Any amount</a>
      <p class="how">Opens your UPI app: GPay, PhonePe, Paytm or BHIM</p>
    </div>

    <div class="desk rise d3">
      <div class="stamp" role="img" aria-label="QR code for the UPI payment">
        <svg viewBox={`0 0 ${SIDE} ${SIDE}`} width={SIDE} height={SIDE} aria-hidden="true">
          <path d={edge} fill="#FFFFFF" />
          <rect x="7" y="7" width={SIDE - 14} height={SIDE - 14} rx="1.5" fill="none" stroke="#E3D3BA" stroke-width="1" />
          <Fragment set:html={qr} />
        </svg>
      </div>
      <p class="scan">Scan with any UPI app</p>
      <div class="id">
        <code>{upi}</code>
        <button type="button" class="btn" data-copy={upi}>Copy</button>
      </div>
    </div>
  </section>
</Base>
<style>
  /* the page is short: the content sits in the middle of whatever room is left, so the valley painting follows without a hole above it */
  :global(body:has(.sponsor-page) main) { display: flex; flex-direction: column; }
  :global(body:has(.sponsor-page) .foot-wrap) { margin-top: 12px; }
  .wrap { max-width: 560px; margin: auto; padding-top: 28px; padding-bottom: 8px; display: flex; flex-direction: column; align-items: center; gap: 18px; text-align: center; }
  .heart { display: block; }
  .h { margin: 0; font-weight: 400; font-size: 40px; line-height: 1.1; letter-spacing: -.02em; }
  .note { margin: 0; font-size: 17px; line-height: 1.6; color: var(--ink); }
  .phone { display: none; width: 100%; flex-direction: column; align-items: stretch; gap: 10px; margin-top: 6px; }
  .amounts { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .pill { display: inline-flex; align-items: center; justify-content: center; height: 52px; padding: 0 20px; border-radius: 26px; border: 1.5px solid var(--lat); background: transparent; color: var(--lat); font-size: 17px; font-weight: 600; font-variant-numeric: tabular-nums lining-nums; transition: transform .15s ease-out, background-color .2s ease, color .2s ease, box-shadow .2s ease; }
  .pill:hover { background: color-mix(in srgb, var(--lat) 10%, transparent); color: var(--lat); }
  .pill:active { transform: scale(.97); transition-duration: .08s; }
  .pill.fill { background: var(--lat); color: var(--on-lat); box-shadow: inset 0 1px 0 rgba(255, 255, 255, .28), 0 4px 10px -4px color-mix(in srgb, var(--lat) 60%, transparent); }
  .pill.fill:hover { background: var(--lat); color: var(--on-lat); }
  .how { margin: 4px 0 0; font-size: 14px; line-height: 1.5; color: var(--muted); }
  .desk { display: flex; flex-direction: column; align-items: center; gap: 14px; margin-top: 10px; }
  /* a postage stamp: perforated edge, tilted a little, a soft warm shadow that follows the edge */
  .stamp { width: 238px; line-height: 0; transform: rotate(2deg); filter: drop-shadow(0 12px 16px var(--shadow)) drop-shadow(0 2px 3px var(--shadow)); margin-bottom: 8px; }
  .stamp svg { display: block; width: 100%; height: auto; }
  .scan { margin: 0; font-size: 14px; color: var(--muted); }
  .id { display: flex; align-items: center; gap: 10px; }
  .id code { font-family: 'Courier Prime', ui-monospace, monospace; font-size: 15px; color: var(--ink); }
  /* a phone (a touch screen) gets the amount buttons, a computer gets the code */
  @media (hover: none) and (pointer: coarse) { .phone { display: flex; } .desk { display: none; } }
  @media (max-width: 780px) { .h { font-size: 32px; } .wrap { padding-top: 20px; } }
  @media (prefers-reduced-motion: reduce) { .pill { transition: none; } .pill:active { transform: none; } }
</style>
<script>
  // Copy the UPI ID; the button says so for a moment
  document.addEventListener('click', async (e) => {
    const b = (e.target as Element).closest<HTMLButtonElement>('[data-copy]');
    if (!b) return;
    try { await navigator.clipboard.writeText(b.dataset.copy!); } catch { return; }
    const was = b.textContent;
    b.textContent = 'Copied';
    setTimeout(() => { b.textContent = was; }, 1600);
  });
</script>
