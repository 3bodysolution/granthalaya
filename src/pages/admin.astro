---
// Reports, the bookshops' books (hide a book or a cover), for the person who runs the site (profiles.is_admin, set by hand in the database).
import Base from '../layouts/Base.astro';
import { adminClient } from '../lib/supabase';
export const prerender = false;

const me = Astro.locals.me;
if (!me?.is_admin) { Astro.response.status = 404; return Astro.rewrite('/404'); }
const show = Astro.url.searchParams.get('show') === 'all' ? 'all' : 'open';
const db = adminClient();
let q = db.from('reports').select('id, reason, details, status, created_at, reporter:profiles!reports_reporter_fkey(username), target:profiles!reports_target_user_fkey(id, username, display_name, avatar_url, featured, is_private), log:logs(id, notes, admin_hidden, title:titles(title, slug)), comment:review_comments(id, body, author:profiles(username), log:logs(title:titles(title, slug), owner:profiles!logs_user_id_fkey(username)))').order('created_at', { ascending: false }).limit(100);
if (show === 'open') q = q.eq('status', 'open');
const { data: reports, error } = await q;
const find = (Astro.url.searchParams.get('shop') ?? '').trim().slice(0, 60).replace(/[%_\,()]/g, ' ').trim();
const SHOP: Record<string, string> = { akshardhara: 'Akshardhara', bookganga: 'BookGanga' };
let shopQ = db.from('shop_books').select('id, shop, url, title, original_title, author, hidden, cover_hidden, cover_src').order('hidden', { ascending: false }).order('title').limit(60);
shopQ = find ? shopQ.or(`title.ilike.%${find}%,original_title.ilike.%${find}%,author.ilike.%${find}%`) : shopQ.eq('hidden', true);
const { data: shopBooks } = await shopQ;
// catalogue titles: find one to remove (only possible when no member has it on their shelf or in a collection)
const findTitle = (Astro.url.searchParams.get('title') ?? '').trim().slice(0, 60).replace(/[%_\,()]/g, ' ').trim();
let catalogue: { id: string; title: string; kind: string; year: number | null; creator: string | null; season: number | null; slug: string; source: string | null; logs: number; items: number }[] = [];
if (findTitle) {
  const { data: found } = await db.from('titles').select('id, title, kind, year, creator, season, slug, source').or(`title.ilike.%${findTitle}%,creator.ilike.%${findTitle}%`).order('title').limit(25);
  const ids = (found ?? []).map((t: any) => t.id);
  const { data: used } = ids.length ? await db.from('logs').select('title_id').in('title_id', ids) : { data: [] };
  const { data: inColl } = ids.length ? await db.from('thread_items').select('title_id').in('title_id', ids) : { data: [] };
  const count = (rows: any[] | null, id: string) => (rows ?? []).filter((r) => r.title_id === id).length;
  catalogue = (found ?? []).map((t: any) => ({ ...t, logs: count(used, t.id), items: count(inColl, t.id) }));
}
const REASON: Record<string, string> = { spam: 'Spam or fake', abuse: 'Harassment', sexual: 'Sexual content', hate: 'Hate', illegal: 'Illegal', other: 'Something else' };
const when = (s: string) => new Date(s).toLocaleString('en-GB', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit', timeZone: 'Asia/Kolkata' });
---
<Base title="Reports" noindex>
  <section class="pad wrap">
    <div class="top">
      <h1 class="title">Reports</h1>
      <div class="flex gap-2"><a class:list={['gchip', show === 'open' && 'on']} href="/admin/">Open</a><a class:list={['gchip', show === 'all' && 'on']} href="/admin/?show=all">All</a></div>
    </div>
    {error && <p class="notice bad">Couldn’t load reports: {error.message}</p>}
    {!error && (reports ?? []).length === 0 && <p class="muted" style="font-size: 16px">No reports waiting.</p>}
    <div class="list">
      {(reports ?? []).map((r: any) => (
        <article class="card rep">
          <div class="between"><b>{REASON[r.reason] ?? r.reason}</b><span class="muted small">{when(r.created_at)} | {r.status}</span></div>
          <p class="small">
            {r.target ? <>About <a class="accent" href={`/@${r.target.username}/`}>@{r.target.username}</a>{r.target.featured ? ' (featured)' : ''}</> : 'About a removed account'}
            {r.log?.title && <> | entry <a class="accent" href={`/@${r.target?.username}/library/${r.log.title.slug}/`}>{r.log.title.title}</a>{r.log.admin_hidden ? ' (hidden)' : ''}</>}
            {' '}| from {r.reporter ? `@${r.reporter.username}` : 'a removed account'}
          </p>
          {r.details && <p class="quote">“{r.details}”</p>}
          {r.log?.notes && <p class="small muted">Their review: {r.log.notes.slice(0, 280)}</p>}
          {r.comment && <p class="small">Comment by @{r.comment.author?.username} on <a class="accent" href={`/@${r.comment.log?.owner?.username}/library/${r.comment.log?.title?.slug}/`}>{r.comment.log?.title?.title}</a>: <span class="muted">{r.comment.body.slice(0, 280)}</span></p>}
          <div class="flex gap-2 flex-wrap">
            {r.status === 'open' && <button class="btn sm" data-admin={JSON.stringify({ id: r.id, action: 'dismiss' })}>Dismiss</button>}
            {r.comment && <button class="btn sm" data-admin={JSON.stringify({ id: r.id, action: 'delete_comment' })}>Delete the comment</button>}
            {r.log && !r.log.admin_hidden && <button class="btn sm" data-admin={JSON.stringify({ id: r.id, action: 'hide_entry' })}>Hide this</button>}
            {r.target?.avatar_url && <button class="btn sm" data-admin={JSON.stringify({ id: r.id, action: 'remove_photo' })}>Remove their photo</button>}
            {r.target?.featured && <button class="btn sm" data-admin={JSON.stringify({ id: r.id, action: 'unfeature' })}>Stop featuring them</button>}
            {r.status === 'open' && <button class="btn sm" data-admin={JSON.stringify({ id: r.id, action: 'done' })}>Mark as dealt with</button>}
          </div>
        </article>
      ))}
    </div>
  </section>
  <section class="pad wrap picks">
    <h2 class="title">Bookshop books</h2>
    <p class="muted small">Books and covers from Akshardhara and BookGanga. If a shop asks, hide the book (no Buy link, no cover) or only its cover. A hidden book is never brought back by a later import.</p>
    <form method="get" class="flex gap-2"><input class="input" type="search" name="shop" value={find} placeholder="Title or author" aria-label="Find a bookshop book" /><button class="btn sm" type="submit">Find</button></form>
    {(shopBooks ?? []).length === 0 && <p class="muted small">{find ? 'No book matches.' : 'Nothing is hidden. Search to find a book.'}</p>}
    <ul class="plist">
      {(shopBooks ?? []).map((k: any) => (
        <li class:list={['pick', k.hidden && 'off']}>
          <span class="pt"><a class="accent" href={k.url} target="_blank" rel="noopener">{k.original_title || k.title}</a><span class="muted"> | {k.author} | {SHOP[k.shop]}{k.hidden ? ' | hidden' : k.cover_hidden ? ' | cover hidden' : ''}</span></span>
          <span class="flex gap-2">
            {!k.hidden && !k.cover_hidden && k.cover_src && <button class="btn sm" data-admin={JSON.stringify({ id: k.id, action: 'hide_cover' })}>Hide cover</button>}
            <button class="btn sm" data-admin={JSON.stringify({ id: k.id, action: k.hidden ? 'show_shop' : 'hide_shop' })}>{k.hidden ? 'Show again' : 'Hide book'}</button>
          </span>
        </li>
      ))}
    </ul>
  </section>
  <section class="pad wrap picks">
    <h2 class="title">Catalogue titles</h2>
    <p class="muted small">Take a title out of the shared catalogue (for a made-up or wrong one). It is refused if any member has it on their shelf or in a collection, and says how many. A TV show goes with its seasons.</p>
    <form method="get" class="flex gap-2"><input class="input" type="search" name="title" value={findTitle} placeholder="Title or author" aria-label="Find a catalogue title" /><button class="btn sm" type="submit">Find</button></form>
    {findTitle && catalogue.length === 0 && <p class="muted small">No title matches.</p>}
    <ul class="plist">
      {catalogue.map((t) => (
        <li class="pick">
          <span class="pt">{t.title}<span class="muted"> | {t.kind}{t.season ? ` season ${t.season}` : ''}{t.year ? ` | ${t.year}` : ''}{t.creator ? ` | ${t.creator}` : ''} | {t.logs} on a shelf{t.items ? `, ${t.items} in collections` : ''}</span></span>
          <button class="btn sm" disabled={t.logs > 0 || t.items > 0} data-confirm={`Remove “${t.title}” from the catalogue for good?`} data-admin={JSON.stringify({ id: t.id, action: 'remove_title' })}>Remove</button>
        </li>
      ))}
    </ul>
    <p class="notice bad small" id="adm-err" hidden></p>
  </section>
</Base>
<style>
  .wrap { padding-top: 48px; max-width: 900px; margin: 0 auto; display: flex; flex-direction: column; gap: 22px; }
  .top { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; }
  .list { display: flex; flex-direction: column; gap: 14px; }
  .rep { padding: 20px; display: flex; flex-direction: column; gap: 10px; }
  .rep p { margin: 0; }
  .between { display: flex; justify-content: space-between; gap: 12px; }
  .small { font-size: 14px; }
  .quote { font-family: 'Fraunces Fix', Fraunces, Georgia, serif; font-style: italic; font-size: 17px; }
  .picks { padding-top: 8px; padding-bottom: 48px; }
  .picks .title { font-size: 28px; }
  .plist { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .pick { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 10px 14px; border: 1px solid var(--line); border-radius: 10px; font-size: 14px; }
  .pick.off { opacity: .55; }
  .btn.sm { height: 34px; padding: 0 12px; font-size: 13px; }
</style>
<script>
  import { navigate } from 'astro:transitions/client';
  document.addEventListener('click', async (ev) => {
    const b = (ev.target as Element).closest<HTMLButtonElement>('[data-admin]');
    if (!b) return;
    if (b.dataset.confirm && !confirm(b.dataset.confirm)) return;
    b.disabled = true;
    const err = document.getElementById('adm-err');
    if (err) err.hidden = true;
    const r = await fetch('/api/admin', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: b.dataset.admin }).then((x) => x.json()).catch(() => ({}));
    if (r.ok) navigate(location.pathname + location.search, { history: 'replace' });
    else { b.disabled = false; if (err && r.error) { err.textContent = r.error; err.hidden = false; } }
  });
</script>
