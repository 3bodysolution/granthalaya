---
// Essays chosen by Granthalaya. Each one links to the original; nothing is copied here.
// Front page: one sideways row per theme. Pick a theme in the filter bar and it becomes a grid of that theme.
import Base from '../../layouts/Base.astro';
import PosterRow from '../../components/title/PosterRow.astro';
import EssayCard from '../../components/title/EssayCard.astro';
import Filters from '../../components/title/Filters.astro';
import { themes, allEssays, total, collection, hakara, hakaraStories, marathi } from '../../lib/essays';
import { essayMarks } from '../../lib/catalog/onsite';
export const prerender = false;
const ROW = 10;
const pick = Astro.url.searchParams.get('theme') ?? '';
const picked = themes.find((t) => t.slug === pick);
const which = Astro.url.searchParams.get('collection');
const showNY = which === collection.slug;      // the See all page of Best of The New Yorker
const showHK = which === hakara.slug;          // the See all page of From Hakara
const showHS = which === hakaraStories.slug;   // the See all page of Stories from Hakara
const inMarathi = Astro.url.searchParams.get('language') === 'mr';   // the Marathi filter: Marathi essays from every theme
const grid = showNY ? collection.items : showHK ? hakara.items : showHS ? hakaraStories.items : inMarathi ? (picked ? picked.items.filter((e) => e.language === 'mr') : marathi) : picked ? picked.items : null;
// which of these are already on your shelf: one lookup for the whole page
const sb = Astro.locals.supabase;
const marks = await essayMarks(sb, Astro.locals.me, (grid ?? allEssays).map((e) => e.link)).catch(() => new Map());
const fields = [
  { name: 'theme', label: 'Theme', value: picked?.slug ?? '', options: [['', 'All themes'], ...themes.map((t) => [t.slug, t.label])] as [string, string][] },
  { name: 'language', label: 'Language', value: inMarathi ? 'mr' : '', options: [['', 'All languages'], ['mr', 'Marathi']] as [string, string][] },
];
const subject = !picked ? '' : picked.name === 'Picks' ? 'Picks' : picked.label.replace('On ', 'on ');
const heading = showNY ? collection.name : showHK ? hakara.name : showHS ? hakaraStories.name : inMarathi ? `Marathi essays and stories${subject && subject !== 'Picks' ? ` ${subject}` : ''}` : !picked ? 'Essays' : picked.name === 'Picks' ? 'Picks' : `Essays ${subject}`;
const NY_ROW = 10;
---
<Base title={heading} active="essays" description="Essays worth reading, each linking to a free copy at the original.">
  <section class="pad head">
    <h1 class="title">{heading}</h1>
    {showNY ? (
      <>
        <p class="muted lede">Curated by <a href={collection.curator.url} target="_blank" rel="noopener noreferrer">{collection.curator.name}</a></p>
        <p class="muted note">Many New Yorker articles need a subscription after a few free reads.</p>
      </>
    ) : showHK ? (
      <p class="muted lede">Marathi essays from <a href={hakara.credit.url} target="_blank" rel="noopener noreferrer">{hakara.credit.name}</a>, listed with their permission. Each opens at its original home.</p>
    ) : showHS ? (
      <p class="muted lede">Marathi stories and long pieces from <a href={hakaraStories.credit.url} target="_blank" rel="noopener noreferrer">{hakaraStories.credit.name}</a>, listed with their permission. Each opens at its original home.</p>
    ) : inMarathi ? (
      <p class="muted lede">{grid!.length} essays and stories in Marathi. Each opens at its original home.</p>
    ) : (
      <p class="muted lede">{picked ? `${picked.items.length} essays` : `${total} essays`} worth an afternoon, chosen by us. Each opens at its original home.</p>
    )}
    <Filters fields={fields} />
  </section>
  {grid ? (
    <section class="pad">
      {grid.length ? (
        <div class="grid">
          {grid.map((e) => <EssayCard e={e} mark={marks.get(e.link)} />)}
        </div>
      ) : <p class="muted">No essays here yet.</p>}
    </section>
  ) : (
    <section class="pad rows">
      {themes.map((t) => (
        <PosterRow title={t.label} tone="essay" href={t.items.length > ROW ? `/essays/?theme=${t.slug}` : undefined} col="min(290px, 80vw)">
          {t.items.slice(0, ROW).map((e) => <li><EssayCard e={e} mark={marks.get(e.link)} /></li>)}
        </PosterRow>
      ))}
      <PosterRow title={collection.name} tone="essay" href={`/essays/?collection=${collection.slug}`} col="min(290px, 80vw)">
        {collection.items.slice(0, NY_ROW).map((e) => <li><EssayCard e={e} mark={marks.get(e.link)} /></li>)}
      </PosterRow>
      <PosterRow title={hakara.name} tone="essay" href={`/essays/?collection=${hakara.slug}`} col="min(290px, 80vw)">
        {hakara.items.slice(0, NY_ROW).map((e) => <li><EssayCard e={e} mark={marks.get(e.link)} /></li>)}
      </PosterRow>
      {hakaraStories.items.length > 0 && (
        <PosterRow title={hakaraStories.name} tone="essay" href={`/essays/?collection=${hakaraStories.slug}`} col="min(290px, 80vw)">
          {hakaraStories.items.slice(0, NY_ROW).map((e) => <li><EssayCard e={e} mark={marks.get(e.link)} /></li>)}
        </PosterRow>
      )}
    </section>
  )}
</Base>
<style>
  .head { padding-top: 44px; padding-bottom: 28px; display: flex; flex-direction: column; align-items: flex-start; gap: 14px; }
  .lede { margin: 0; max-width: 56ch; font-size: 16px; }
  .lede a { color: var(--lat); text-decoration: underline; text-underline-offset: 2px; }
  .note { margin: -6px 0 0; max-width: 56ch; font-size: 13px; }
  .rows { display: flex; flex-direction: column; gap: 48px; padding-bottom: 8px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); gap: 14px; }
  .credit-line { margin: 32px 0 0; font-size: 12px; color: var(--muted); }
  .credit-line a { color: var(--lat); text-decoration: underline; text-underline-offset: 2px; }
  @media (max-width: 780px) { .head { padding-top: 28px; } .rows { gap: 36px; } .grid { grid-template-columns: 1fr; } }
</style>
