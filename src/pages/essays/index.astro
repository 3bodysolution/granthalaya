---
// Essays chosen by Granthalaya. Each one links to the original; nothing is copied here.
// Front page: one sideways row per theme. Pick a theme in the filter bar and it becomes a grid of that theme.
import Base from '../../layouts/Base.astro';
import PosterRow from '../../components/title/PosterRow.astro';
import EssayCard from '../../components/title/EssayCard.astro';
import Filters from '../../components/title/Filters.astro';
import { themes, allEssays, total, source } from '../../lib/essays';
import { essayMarks } from '../../lib/catalog/onsite';
export const prerender = false;
const ROW = 10;
const pick = Astro.url.searchParams.get('theme') ?? '';
const picked = themes.find((t) => t.slug === pick);
// which of these are already on your shelf: one lookup for the whole page
const sb = Astro.locals.supabase;
const marks = await essayMarks(sb, Astro.locals.me, (picked ? picked.items : allEssays).map((e) => e.link)).catch(() => new Map());
const fields = [{ name: 'theme', label: 'Theme', value: picked?.slug ?? '', options: [['', 'All themes'], ...themes.map((t) => [t.slug, t.name])] as [string, string][] }];
const hasPicks = !picked || picked.name === 'Picks';
---
<Base title={picked ? `${picked.name} essays` : 'Essays'} active="essays" description="Essays worth reading, each linking to a free copy at the original.">
  <section class="pad head">
    <h1 class="title">{picked ? `${picked.name} essays` : 'Essays'}</h1>
    <p class="muted lede">{picked ? `${picked.items.length} essays` : `${total} essays`} worth an afternoon, chosen by us. Each opens at its original home.</p>
    <Filters fields={fields} />
  </section>
  {picked ? (
    <section class="pad">
      <div class="grid">
        {picked.items.map((e) => <EssayCard e={e} mark={marks.get(e.link)} />)}
      </div>
    </section>
  ) : (
    <section class="pad rows">
      {themes.map((t) => (
        <PosterRow title={t.name} tone="essay" href={t.items.length > ROW ? `/essays/?theme=${t.slug}` : undefined} col="min(290px, 80vw)">
          {t.items.slice(0, ROW).map((e) => <li><EssayCard e={e} mark={marks.get(e.link)} /></li>)}
        </PosterRow>
      ))}
    </section>
  )}
  {hasPicks && <p class="pad credit-line">Picks were found via <a href={source.url} target="_blank" rel="noopener noreferrer">{source.name}</a>.</p>}
</Base>
<style>
  .head { padding-top: 44px; padding-bottom: 28px; display: flex; flex-direction: column; align-items: flex-start; gap: 14px; }
  .lede { margin: 0; max-width: 56ch; font-size: 16px; }
  .rows { display: flex; flex-direction: column; gap: 48px; padding-bottom: 8px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); gap: 14px; }
  .credit-line { margin: 32px 0 0; font-size: 12px; color: var(--muted); }
  .credit-line a { color: var(--lat); }
  @media (max-width: 780px) { .head { padding-top: 28px; } .rows { gap: 36px; } .grid { grid-template-columns: 1fr; } }
</style>
