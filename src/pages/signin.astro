---
// One sign-in page now: /join. Old links to /signin (and its `next` and `error`) go there.
export const prerender = false;
const to = new URL('/join/', Astro.url);
for (const k of ['next', 'error']) { const v = Astro.url.searchParams.get(k); if (v) to.searchParams.set(k, v); }
return Astro.redirect(to.pathname + to.search);
---
