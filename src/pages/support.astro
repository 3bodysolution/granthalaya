---
// Support Granthalaya: a note and a way to pay by UPI. On a phone, amount buttons open the UPI app; on a computer, a QR code and the UPI ID.
// Nothing else on the page.
import QRCode from 'qrcode';
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
export const prerender = false;

const { upi, payee } = site.support;
const link = (amount?: number) =>
  `upi://pay?pa=${upi}&pn=${encodeURIComponent(payee)}&cu=INR&tn=${encodeURIComponent('Support Granthalaya')}${amount ? `&am=${amount}` : ''}`;
const amounts = [50, 100, 250, 500];
// the code is always dark on white, so every UPI app can read it, in dark mode too
const qr = await QRCode.toString(link(), { type: 'svg', margin: 2, width: 208, color: { dark: '#1F1C18', light: '#FFFFFF' } });
---
<Base title="Support Granthalaya">
  <div class="art melt settle banner bleed" style="--day: url(/art/lotw-day.webp); --night: url(/art/lotw-night.webp)" aria-hidden="true"></div>
  <section class="pad wrap">
    <h1 class="serif h rise d1">Support Granthalaya</h1>
    <p class="note rise d2">Granthalaya is free. Your support helps us pay for hosting and the costs of running the site. It’s entirely optional, and everything on the site stays free.</p>

    <div class="phone rise d3">
      {amounts.map((a) => <a class="btn" href={link(a)} data-astro-prefetch="false">₹{a}</a>)}
      <a class="btn" href={link()} data-astro-prefetch="false">Any amount</a>
    </div>

    <div class="desk rise d3">
      <div class="qr" set:html={qr} role="img" aria-label="QR code for the UPI payment"></div>
      <p class="scan">Scan with any UPI app</p>
      <div class="id">
        <code>{upi}</code>
        <button type="button" class="btn" data-copy={upi}>Copy</button>
      </div>
    </div>
  </section>
</Base>
<style>
  .banner { height: clamp(220px, 27vw, 400px); background-position: center 60%; }
  .wrap { max-width: 560px; margin: -8px auto 0; padding-bottom: 56px; display: flex; flex-direction: column; align-items: center; gap: 20px; text-align: center; }
  .h { margin: 0; font-weight: 400; font-size: 36px; line-height: 1.1; }
  .note { margin: 0; font-size: 17px; line-height: 1.6; color: var(--ink); }
  .phone { display: none; width: 100%; grid-template-columns: 1fr 1fr; gap: 10px; }
  .phone .btn { height: 48px; font-size: 16px; }
  .phone .btn:last-child { grid-column: 1 / -1; }
  .desk { display: flex; flex-direction: column; align-items: center; gap: 12px; }
  .qr { width: 208px; height: 208px; border-radius: 12px; overflow: hidden; border: 1px solid var(--line); background: #fff; line-height: 0; }
  .qr :global(svg) { display: block; width: 100%; height: 100%; }
  .scan { margin: 0; font-size: 14px; color: var(--muted); }
  .id { display: flex; align-items: center; gap: 10px; }
  .id code { font-family: 'Courier Prime', ui-monospace, monospace; font-size: 15px; color: var(--ink); }
  /* a phone (a touch screen) gets the amount buttons, a computer gets the code */
  @media (hover: none) and (pointer: coarse) { .phone { display: grid; } .desk { display: none; } }
  @media (max-width: 780px) { .banner { height: 190px; } .h { font-size: 30px; } }
</style>
<script>
  // Copy the UPI ID; the button says so for a moment
  document.addEventListener('click', async (e) => {
    const b = (e.target as Element).closest<HTMLButtonElement>('[data-copy]');
    if (!b) return;
    try { await navigator.clipboard.writeText(b.dataset.copy!); } catch { return; }
    const was = b.textContent;
    b.textContent = 'Copied';
    setTimeout(() => { b.textContent = was; }, 1600);
  });
</script>
