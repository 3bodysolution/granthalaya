---
// A book: from Open Library (or Google Books when Open Library doesn't have it), with what people here thought.
import Base from '../../layouts/Base.astro';
import TitleLayout from '../../components/title/TitleLayout.astro';
import Poster from '../../components/title/Poster.astro';
import Tabs from '../../components/title/Tabs.astro';
import Reviews from '../../components/title/Reviews.astro';
import OnSiteBox from '../../components/title/OnSiteBox.astro';
import LogPanel from '../../components/LogPanel.astro';
import { olBook, gbBook, bookKey, bookHref, type BookPage } from '../../lib/catalog/books';
import { slug } from '../../lib/catalog/fetch';
import { rowsForBook, rowBySlug, onSite, titlePageHref, healBook, ownRecord, type TitleRow } from '../../lib/catalog/onsite';
import { aboutHours } from '../../lib/data';
import { site as siteConfig } from '../../data/site';
import { SourceUnavailable } from '../../lib/catalog/fetch';
import { pageBits } from '../../lib/cards/titlepage';
import { bookOg } from '../../lib/share';
import { shownYear } from '../../lib/catalog/known-years';
import moved from '../../data/slug-redirects.json';
import { cleanBlurb, savedDescription, describeLater } from '../../lib/catalog/describe';
export const prerender = false;

const param = String(Astro.params.id ?? '');
const sb = Astro.locals.supabase;
const me = Astro.locals.me;
const k = bookKey(param);
let b: BookPage | null = null;
let rows: TitleRow[] = [];
if (!k) { Astro.response.status = 404; return Astro.rewrite('/404'); }
try {
if ('ol' in k) {
  [b, rows] = await Promise.all([olBook(k.ol), sb ? rowsForBook(sb, k.ol) : Promise.resolve([])]);
  if (b && param !== `${k.ol.toLowerCase()}-${slug(b.title)}` && slug(b.title)) return Astro.redirect(bookHref(k.ol, b.title) + Astro.url.search, 301);
} else if ('gb' in k) {
  [b, rows] = await Promise.all([gbBook(k.gb), sb ? rowsForBook(sb, `gb-${k.gb}`) : Promise.resolve([])]);
} else if ((moved as Record<string, string>)[k.slug]) {
  // two rows for one book were merged (scripts/merge-titles.mjs): the old address goes to the row that stayed
  return Astro.redirect(`/book/${(moved as Record<string, string>)[k.slug]}/`, 301);
} else if (sb) {
  // a book in our catalogue by its address name (added by hand, or before it had an Open Library key)
  const row = await rowBySlug(sb, 'book', k.slug);
  if (row && !row.ol_key && !ownRecord(row.source) &&!/books\.google\./.test(row.link ?? '')) {
    const ol = await healBook(row);
    if (ol) return Astro.redirect(bookHref(ol, row.title), 302);
  }
  const home = row ? titlePageHref(row) : null;
  if (row && home && home !== `/book/${k.slug}/`) return Astro.redirect(home, 301);
  if (row) {
    rows = [row];
    b = { kind: 'book', key: row.slug, title: row.title, subtitle: row.original_title ?? undefined, authors: row.creator ? [{ name: row.creator }] : [], year: row.year ?? undefined, languages: [], subjects: [], description: row.note ?? '', cover: row.cover_url ?? undefined, publishers: row.publisher ? [row.publisher] : [], source: 'Open Library', sourceLink: '' };
  }
}
} catch (e) { if (e instanceof SourceUnavailable) return Astro.rewrite('/unavailable'); throw e; } // a catalogue failing is not "not found"
if (!b) { Astro.response.status = 404; return Astro.rewrite('/404'); }
const row = rows[0];
// what the page needs from the database is asked together: our records, the saved description, the shops' rows, the preview bits
const shopQuery = async () => {
  if (!sb || !rows.length) return [];
  const ids = rows.map((r) => r.id);
  let r = await sb.from('shop_books').select('shop, url, isbn, publisher, pages, back_src, cover_src, cover_hidden').in('title_id', ids);
  if (r.error) r = await sb.from('shop_books').select('shop, url, isbn, publisher').in('title_id', ids) as typeof r;   // before 012
  return (r.data ?? []) as unknown[];
};
const [site, saved, shopData, bits] = await Promise.all([
  sb ? onSite(sb, rows, me) : Promise.resolve({ done: 0, saved: 0, average: null, ratings: 0, collections: [], mine: [] }),
  sb && row ? savedDescription(sb, row.id) : Promise.resolve(null),
  shopQuery(),
  pageBits(sb, 'book', param),
]);
// a better description is looked for once, in the background, and only for books already in our catalogue
if (row && saved && !saved.checked) describeLater(row.id);
const description = cleanBlurb(saved?.text ?? b.description);   // saved text too: the cleaner may have learnt something since it was saved
const year = shownYear({ slug: row?.slug, ol: 'ol' in k ? k.ol : undefined }, b.year, saved?.text, saved?.source);   // the first publication, not a later edition's
const credit = saved?.text && saved.source !== 'openlibrary'
  ? { adapted: saved.source?.startsWith('ai-'), from: saved.source?.endsWith('wikipedia') ? 'Wikipedia' : 'Open Library', url: saved.url ?? (saved.source?.endsWith('wikipedia') ? undefined : b.sourceLink) }
  : null;
// the two bookshops (with their permission): where to buy it, and the credit for a cover or details taken from them
const SHOP_NAME: Record<string, string> = { akshardhara: 'Akshardhara', bookganga: 'BookGanga' };
type ShopRow = { shop: string; url: string; isbn: string | null; publisher: string; pages?: number | null; back_src?: string | null; cover_src?: string | null; cover_hidden?: boolean };
const shopRows = shopData as ShopRow[];
const shops = [...new Map(shopRows.map((s) => [s.shop, s])).values()].filter((s) => SHOP_NAME[s.shop]);
const cover = b.cover ?? row?.cover_url ?? undefined;   // an Open Library book with no cover there may have one from a shop
// A shop's details win where it has them (publisher, pages, ISBN: its own edition's); the first-publication year is never the shop's.
const fromShop = shops.length > 0;
const shopHas = (k: 'publisher' | 'pages' | 'isbn') => shopRows.find((s) => s[k])?.[k] ?? undefined;
const publishers = (fromShop && shopHas('publisher') ? [String(shopHas('publisher'))] : b.publishers);
const pagesShown = (fromShop && shopHas('pages')) || b.pages;
const isbnShown = (fromShop && shopHas('isbn')) || b.isbn;
// the "Book data from Open Library" line only when something on the page came from there
const manyEditions = (b.editions ?? 0) >= 2;
// (a year the credited Wikipedia text states itself is Wikipedia's, not Open Library's)
const yearInText = !!year && !!saved?.text && !!saved.source?.endsWith('wikipedia') && saved.text.includes(String(year));
const usedSource = !!b.sourceLink && (!fromShop || [
  year && year === b.year && !yearInText, !saved?.text && b.description, b.subjects.length, b.languages.length, manyEditions,
  b.pages && pagesShown === b.pages, b.publishers.length && publishers === b.publishers, b.isbn && isbnShown === b.isbn,
].some(Boolean));
const coverFromShop = !!cover && (!b.cover || shopRows.some((s) => s.cover_src === cover));   // the cover shown is a shop's
// Akshardhara's back cover, only when the cover shown is the shop's and the shop hasn't asked for it to be hidden
const back = coverFromShop ? shopRows.find((s) => s.back_src && !s.cover_hidden)?.back_src ?? undefined : undefined;
const gbId = 'gb' in k ? k.gb : null;
const hit = {
  kind: 'book', olKey: 'ol' in k ? k.ol : undefined, title: b.title, creator: b.authors[0]?.name, year, pages: b.pages, cover: b.cover,
  link: gbId ? `https://books.google.com/books?id=${gbId}` : b.sourceLink || undefined,
};
const share = new URL(Astro.url.pathname, Astro.site).href;
const q = encodeURIComponent(`${b.title} ${b.authors[0]?.name ?? ''}`.trim());
const find = [
  ...shops.map((s) => ({ label: `Buy at ${SHOP_NAME[s.shop]}`, url: s.url })),
  b.readOnline && { label: 'Borrow or read on Open Library', url: b.readOnline },
  b.source === 'Open Library' && b.sourceLink && !b.readOnline && { label: 'Open Library', url: b.sourceLink },
  b.source === 'Google Books' && { label: 'Google Books', url: b.sourceLink },
  { label: 'Amazon India', url: `https://www.amazon.in/s?k=${q}&i=stripbooks` },
  { label: 'Find it in a library', url: `https://search.worldcat.org/search?q=${q}` },
].filter(Boolean) as { label: string; url: string }[];
const tabs = [{ key: 'details', label: 'Details' }, b.subjects.length && { key: 'subjects', label: 'Subjects' }].filter(Boolean) as { key: string; label: string }[];
const language = row?.language ? new Intl.DisplayNames(['en'], { type: 'language' }).of(row.language) : null;
const og = bookOg({ ...b, year }, bits?.creator ?? b.authors.map((a) => a.name).join(', '), bits?.line);
const paras = description ? description.split(/\n{2,}/) : [];
const reading = pagesShown ? aboutHours(Math.round(pagesShown * siteConfig.minutesPerPage)) : null;
---
<Base title={`${b.title}${b.authors[0] ? ` by ${b.authors[0].name}` : ''}`} line={row?.tagline ? { text: row.tagline, source: b.title } : undefined} description={description ? description.slice(0, 180) : `${b.title} on Granthalaya.`} og={og} image={`/og/book/${param}.png`}>
  <TitleLayout>
    <Poster slot="poster" src={cover} back={back} title={b.title} by={b.authors[0]?.name} kind="book" year={year} />
    <Fragment slot="side">
      <div class="find">
        <p class="f-h">Find it</p>
        {find.map((f) => <a href={f.url} target="_blank" rel="noopener">{f.label} <span aria-hidden="true">↗</span></a>)}
      </div>
    </Fragment>

    <h1 class="title tt">{b.title}</h1>
    {b.subtitle && <p class="sub">{b.subtitle}</p>}
    <p class="meta">
      {b.authors.length > 0 && <span>by {b.authors.map((a, i) => <>{i > 0 && ', '}{a.href ? <a href={a.href} class="ul">{a.name}</a> : a.name}</>)}</span>}
      {year && <span><span class="vbar" aria-hidden="true"></span><a href={`/books/?year=${year}`} class="ul">{year}</a></span>}
    </p>
    {paras.length > 0 && <div class="desc">{paras.map((p) => <p>{p}</p>)}</div>}
    {credit && (
      <p class="from">
        {credit.adapted ? 'Adapted from ' : 'From '}{credit.url ? <a href={credit.url} target="_blank" rel="noopener" class="ul">{credit.from}</a> : credit.from}{credit.from === 'Wikipedia' && <>, <a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener license" class="ul">CC BY-SA</a></>}
      </p>
    )}

    <Fragment slot="more">
      <Tabs id="book" tabs={tabs}>
        <div role="tabpanel" id="book-p-details" aria-labelledby="book-t-details" class="tp">
          <dl class="facts">
            {year && <><dt>First published</dt><dd><a href={`/books/?year=${year}`} class="ul">{year}</a></dd></>}
            {language && <><dt>Language</dt><dd>{language}</dd></>}
            {pagesShown && <><dt>Length</dt><dd>{pagesShown} pages{reading ? `, ${reading} to read` : ''}</dd></>}
            {b.languages.length > 0 && <><dt>Editions in</dt><dd>{b.languages.map((l, i) => <>{i > 0 && ', '}<a href={`/books/?language=${l.code}`} class="ul">{l.name}</a></>)}</dd></>}
            {publishers.length > 0 && <><dt>{publishers.length > 1 ? 'Publishers' : 'Publisher'}</dt><dd>{publishers.join(', ')}</dd></>}
            {manyEditions && <><dt>Editions</dt><dd>{b.editions}</dd></>}
            {isbnShown && <><dt>ISBN</dt><dd class="num">{isbnShown}</dd></>}
          </dl>
        </div>
        {b.subjects.length > 0 && (
          <div role="tabpanel" id="book-p-subjects" aria-labelledby="book-t-subjects" class="tp" hidden>
            <div class="chips">{b.subjects.map((s) => <a href={`/books/?subject=${s.slug}`} class="gchip">{s.name}</a>)}</div>
          </div>
        )}
      </Tabs>
    </Fragment>

    <Fragment slot="panel">
      <LogPanel kind="book" parts={[{ key: 'book', hit, titleId: row?.id, mine: site.mine[0] }]} share={share} what={b.title} />
      <OnSiteBox site={site} film={false} />
    </Fragment>

    <Fragment slot="below">
      <Reviews site={site} rows={rows} facts={row ? { list: row.trivia ?? [], source: row.trivia_source, label: 'Behind the book' } : undefined} />
      {(fromShop || usedSource) && (
        <p class="pad credit-line">
          {fromShop && <>{coverFromShop ? 'Cover and details' : 'Details'} from {shops.map((s, i) => <>{i > 0 && ' and '}<a href={s.url} target="_blank" rel="noopener" class="ul">{SHOP_NAME[s.shop]}</a></>)}, with their permission.</>}
          {fromShop && usedSource && ' '}{usedSource && <>Book data from {b.source}.</>}
        </p>
      )}
    </Fragment>
  </TitleLayout>
</Base>

<style>
  .tt { font-size: clamp(38px, 5vw, 58px); line-height: 1.04; }
  .sub { margin: -8px 0 0; font-family: 'Fraunces Fix', Fraunces, Georgia, serif; font-size: 20px; color: var(--muted); }
  .meta { margin: 0; font-size: 16px; color: var(--muted); }
  .ul { color: var(--ink); text-decoration: underline; text-decoration-color: var(--line); text-underline-offset: 4px; transition: text-decoration-color .2s ease, color .2s ease; }
  .ul:hover { color: var(--lat); text-decoration-color: var(--lat); }
  .desc { max-width: 640px; display: flex; flex-direction: column; gap: 12px; }
  .desc p { margin: 0; font-family: 'Fraunces Fix', Fraunces, Georgia, serif; font-size: 18px; line-height: 1.6; }
  .from { margin: -4px 0 0; font-size: 12.5px; color: var(--muted); }
  .tp { padding-top: 16px; }
  .facts { margin: 0; display: grid; grid-template-columns: 150px minmax(0, 1fr); gap: 10px 18px; font-size: 14.5px; }
  .facts dt { color: var(--muted); font-size: 12px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; padding-top: 2px; }
  .facts dd { margin: 0; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .find { border-radius: 12px; border: 1px solid var(--line); background: var(--card); overflow: hidden; display: flex; flex-direction: column; }
  .f-h { margin: 0; padding: 10px 14px; font-size: 11px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); border-bottom: 1px solid var(--line); }
  .find a { display: flex; justify-content: space-between; padding: 11px 14px; font-size: 13.5px; font-weight: 600; border-bottom: 1px solid var(--line); transition: background-color .2s ease; }
  .find a:last-child { border-bottom: 0; }
  .find a:hover { background: var(--soft); }
  .credit-line { margin: 40px 0 0; font-size: 12px; color: var(--muted); }
  @media (max-width: 780px) { .facts { grid-template-columns: 110px minmax(0, 1fr); } .find { width: 100%; } .desc p { font-size: 17px; } }
</style>
