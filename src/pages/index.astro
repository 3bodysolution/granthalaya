---
import Base from '../layouts/Base.astro';
import Cover from '../components/Cover.astro';
import Tile from '../components/Tile.astro';
import { site } from '../data/site';
import { getEntries, href, short, kind, remaining, duration, excerpt } from '../lib/data';

const all = await getEntries();
const latest = all[0];
const reading = all.find((e) => e.data.type === 'book' && e.data.status === 'reading');
const watching = all.find((e) => e.data.type === 'film' && e.data.status === 'watching') ?? all.find((e) => e.data.type === 'film');
const recent = all.filter((e) => e.data.status === 'done').slice(0, 6);
const start = all.filter((e) => e.data.startHere).sort((a, b) => a.data.startHere! - b.data.startHere!).slice(0, 5);
const otd = all.filter((e) => e.data.status === 'done').map((e) => ({ t: e.data.title, d: e.data.date.toISOString().slice(0, 10), h: href(e), v: e.data.type === 'film' ? 'watched' : 'finished' }));
const hrefs = all.map(href);
const quote = site.lineOfTheWeek;
---
<Base>
  <section class="hero pad">
    <p class="eyebrow rise" style="color: var(--lat)">{site.season}</p>
    <h1 class="title rise d1">Everything I read, watch, and keep <em>coming back to.</em></h1>
  </section>

  <div class="paint settle d2" aria-hidden="true">
    <img class="sky skyL" src="/img/pune-day.webp" alt="" width="2172" height="388" />
    <img class="sky skyD" src="/img/pune-night.webp" alt="" width="2172" height="388" />
  </div>

  <section class="pad block rise d4" style="padding-top: 40px">
    <div class="rule">
      <div class="inline"><h2 class="eyebrow">Now</h2><span class="small muted">Updated {short(latest.data.date)}</span></div>
      <a class="small muted otd" data-otd={JSON.stringify(otd)} hidden></a>
    </div>
    <div class="now">
      {reading && (
        <a href={href(reading)} class="card lift nowcard">
          <Cover entry={reading} variant="swatch" w={84} h={126} />
          <div class="stack grow" style="gap: 6px">
            <p class="eyebrow" style="color: var(--lat)">Reading</p>
            <span class="serif nt">{reading.data.title}</span>
            <span class="small muted">{reading.data.creator}</span>
            <div role="progressbar" aria-label="Reading progress" aria-valuenow={reading.data.progress ?? 0} aria-valuemin="0" aria-valuemax="100" class="bar">
              <div class="growX" style={`animation-delay: 1s; width: ${reading.data.progress ?? 0}%`}></div>
            </div>
            <span class="num tiny muted">{reading.data.progress ?? 0}% · about {duration(remaining(reading), 'words')} left</span>
          </div>
        </a>
      )}
      {watching && (
        <a href={href(watching)} class="card lift nowcard">
          <Cover entry={watching} variant="swatch" w={84} h={126} />
          <div class="stack grow" style="gap: 6px">
            <p class="eyebrow" style="color: var(--sky)">{watching.data.status === 'watching' ? 'Watching' : 'Last watched'}</p>
            <span class="serif nt">{watching.data.title}</span>
            <span class="small muted">{watching.data.creator}{watching.data.year ? ` · ${watching.data.year}` : ''}</span>
            <span class="small muted" style="margin-top: auto; line-height: 1.45">{excerpt(watching, 90)}</span>
          </div>
        </a>
      )}
      <a href="/notes/" class="card lift nowcard stack" style="gap: 10px">
        <p class="eyebrow" style="color: var(--moss)">Thinking about</p>
        <p class="serif" style="margin: 0; font-size: 19px; line-height: 1.45; font-style: italic">“{quote.text}”</p>
        <span class="small muted" style="margin-top: auto">{quote.by.split(' ').slice(-1)}, <em>{quote.source}</em> · in my notes →</span>
      </a>
    </div>
  </section>

  <section class="pad block rise d5">
    <div class="rule"><h2 class="eyebrow">Recently</h2><a href="/library/" class="more">The whole library →</a></div>
    <div class="shelf">
      {recent.map((e, n) => <Tile entry={e} vt cls="rise" delay={`${(0.6 + n * 0.08).toFixed(2)}s`} />)}
    </div>
  </section>

  {start.length > 0 && (
    <section class="pad block rise d6" style="padding-top: 72px">
      <div class="rule start-rule">
        <div class="stack" style="gap: 8px">
          <h2 class="eyebrow" style="color: var(--lat)">Start here</h2>
          <p class="serif" style="margin: 0; font-size: clamp(22px, 2.6vw, 30px); line-height: 1.2">If you’re new, these {start.length === 5 ? 'five' : start.length} explain my taste better than I can.</p>
        </div>
        <div class="inline" style="gap: 10px">
          <button class="btn" data-surprise={JSON.stringify(hrefs)}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M16 3h5v5M4 20L21 3M21 16v5h-5M15 15l6 6M4 4l5 5"/></svg>Surprise me
          </button>
          <a href="/library/" class="btn hide-sm">Everything</a>
        </div>
      </div>
      <div class="starts">
        {start.map((e, i) => (
          <a href={href(e)} class="lift stack" style="gap: 14px">
            <Cover entry={e} variant="poster" n={String(i + 1).padStart(2, '0')} />
            <p class="small muted" style="margin: 0; font-size: 14px; line-height: 1.5">{e.data.startWhy ?? excerpt(e, 70)}</p>
          </a>
        ))}
      </div>
    </section>
  )}
</Base>

<style>
  .hero { padding-top: 60px; display: flex; flex-direction: column; align-items: center; gap: 16px; text-align: center; }
  .hero .title { max-width: 820px; }
  .paint { margin-top: 8px; }
  .block { padding-top: 60px; display: flex; flex-direction: column; gap: 24px; }
  .inline { display: flex; align-items: baseline; gap: 14px; }
  .small { font-size: 13px; }
  .tiny { font-size: 12px; }
  .grow { flex-grow: 1; min-width: 0; }
  .now { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .nowcard { display: flex; gap: 20px; padding: 22px; }
  .nt { font-size: 20px; line-height: 1.2; }
  .bar { margin-top: auto; height: 4px; border-radius: 2px; background: var(--soft); overflow: hidden; }
  .bar div { height: 4px; border-radius: 2px; background: var(--lat); }
  .start-rule { align-items: flex-end; padding-bottom: 16px; }
  .starts { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 32px; }
  .otd em { font-family: Fraunces, Georgia, serif; color: var(--ink); }
  @media (max-width: 1100px) {
    .now { grid-template-columns: 1fr 1fr; }
    .now > :last-child { grid-column: 1 / -1; }
    .starts { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  }
  @media (max-width: 780px) {
    .hero { padding-top: 36px; }
    .block { padding-top: 44px; }
    .now { grid-template-columns: 1fr; }
    .starts { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
    .start-rule { flex-direction: column; align-items: flex-start; }
    .rule .otd { display: none; }
  }
</style>

<script>
  import { navigate } from 'astro:transitions/client';
  // "Surprise me" — any entry, at random
  document.addEventListener('click', (ev) => {
    const b = (ev.target as Element).closest<HTMLElement>('[data-surprise]');
    if (!b) return;
    const list: string[] = JSON.parse(b.dataset.surprise!);
    navigate(list[Math.floor(Math.random() * list.length)]);
  });
  // "On this day" — something finished on today's date in an earlier year
  function onThisDay() {
    const el = document.querySelector<HTMLAnchorElement>('[data-otd]');
    if (!el) return;
    const now = new Date();
    const md = `${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;
    const hits = (JSON.parse(el.dataset.otd!) as { t: string; d: string; h: string; v: string }[])
      .filter((x) => x.d.slice(5) === md && +x.d.slice(0, 4) < now.getFullYear());
    if (!hits.length) return;
    const x = hits[0];
    const yrs = now.getFullYear() - +x.d.slice(0, 4);
    const esc = (s: string) => s.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' })[c]!);
    el.href = x.h;
    el.innerHTML = `On this day ${yrs === 1 ? 'last year' : yrs + ' years ago'}, I ${x.v} <em>${esc(x.t)}</em> →`;
    el.hidden = false;
  }
  document.addEventListener('astro:page-load', onThisDay);
</script>
