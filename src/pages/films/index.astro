---
// Films and TV. With no filters it's a front page: rows of popular and new titles, then ways to browse.
// With filters (genre, year or decade, language, streaming service, order) it's a grid. Every linked year,
// genre and language on a film page comes here.
import Base from '../../layouts/Base.astro';
import PosterTile from '../../components/title/PosterTile.astro';
import Filters from '../../components/title/Filters.astro';
import Pager from '../../components/title/Pager.astro';
import PosterRow from '../../components/title/PosterRow.astro';
import { filmRows, markRows, type Row } from '../../lib/catalog/rows';
import { discover, services, genreBySlug, languageName, FILM_GENRES, TV_GENRES, genreSlug, tmdbReady } from '../../lib/catalog/tmdb';
import ListGrid from '../../components/title/ListGrid.astro';
import { listsOfKind, pickList, listDecades, listBrowseHref } from '../../lib/lists';
import { myMarks } from '../../lib/catalog/onsite';
export const prerender = false;

const q = Astro.url.searchParams;
const kind = q.get('kind') === 'tv' ? 'tv' : 'film';
const genre = q.get('genre') ? genreBySlug(kind, q.get('genre')!) : null;
const yr = Number(q.get('year')); const year = Number.isInteger(yr) && yr > 1870 && yr < 2100 ? yr : undefined;
const dc = parseInt(String(q.get('decade') ?? ''), 10); const decade = !year && Number.isInteger(dc) && dc >= 1900 && dc < 2100 ? dc - (dc % 10) : undefined;
const language = /^[a-z]{2}$/.test(q.get('language') ?? '') ? q.get('language')! : undefined;
const sv = Number(q.get('service')); const service = Number.isInteger(sv) && sv > 0 ? sv : undefined;
const sort = (['popular', 'top', 'new'] as const).find((s) => s === q.get('sort')) ?? 'popular';
const page = Math.max(1, Math.min(500, Number(q.get('page')) || 1));

// the front page is the address with nothing but Films or TV chosen
// a prize or classics list chosen in the filter bar shows in place (films only); the other filters don't apply to it
const picked = kind === 'film' ? pickList(q.get('list'), 'film') : undefined;
const front = [...q.keys()].every((k) => k === 'kind');
const empty = { items: [], pages: 0, total: 0 };
const [list, svc, rowsRaw] = await Promise.all([
  front || picked ? Promise.resolve(empty) : discover({ kind, genre: genre?.id, year, decade, language, service, sort, page }),
  services(),
  front ? filmRows(kind) : Promise.resolve([] as Row[]),
]);
const sb = Astro.locals.supabase;
const [marks, rows] = await Promise.all([
  sb && !front && !picked ? myMarks(sb, Astro.locals.me, list.items.map((c) => ({ kind: c.kind, tmdb: c.id }))) : Promise.resolve(new Map<string, string>()),
  markRows(sb, Astro.locals.me, rowsRaw),
]);
const serviceName = svc.find((s) => s.id === service)?.name;

// the heading says what the list is: "Marathi drama films from the 2010s on Netflix"
const noun = kind === 'tv' ? 'TV' : 'films';
const head = [language && languageName(language), genre && genre.name.toLowerCase(), noun].filter(Boolean).join(' ');
const when = year ? ` from ${year}` : decade ? ` from the ${decade}s` : '';
const where = serviceName ? ` on ${serviceName}` : '';
const title = picked ? picked.title : (head + when + where).replace(/^./, (c) => c.toUpperCase());

const now = new Date().getUTCFullYear();
const decades: [string, string][] = Array.from({ length: Math.floor((now - 1920) / 10) + 1 }, (_, i) => { const d = Math.floor(now / 10) * 10 - i * 10; return [String(d), `${d}s`]; });
const LANGS = ['hi', 'mr', 'ml', 'ta', 'te', 'bn', 'kn', 'gu', 'pa', 'en', 'ko', 'ja', 'fr', 'es', 'it', 'de', 'zh', 'fa'];
const langs: [string, string][] = [...new Set([...(language ? [language] : []), ...LANGS])].map((c) => [c, languageName(c) ?? c]);
const listDec = picked ? listDecades(picked) : [];
const dcPicked = picked && decade && listDec.some(([d]) => d === String(decade)) ? decade : undefined;
const resets = picked ? ['list'] : undefined; // changing any other filter leaves the list
const fields = [
  { name: 'genre', label: 'Genre', value: picked ? '' : genre?.slug ?? '', options: [['', 'Any genre'], ...(kind === 'tv' ? TV_GENRES : FILM_GENRES).map(([, n]) => [genreSlug(n), n])] as [string, string][], clears: resets },
  picked
    ? { name: 'decade', label: 'Decade', value: dcPicked ? String(dcPicked) : '', options: [['', 'Any year'], ...listDec] as [string, string][] }
    : year
      ? { name: 'year', label: 'Year', value: String(year), options: [[String(year), String(year)], ['', 'Any year']] as [string, string][] }
      : { name: 'decade', label: 'Decade', value: decade ? String(decade) : '', options: [['', 'Any year'], ...decades] as [string, string][] },
  { name: 'language', label: 'Language', value: picked ? '' : language ?? '', options: [['', 'Any language'], ...langs] as [string, string][], clears: resets },
  ...(svc.length ? [{ name: 'service', label: 'Service', value: picked ? '' : service ? String(service) : '', options: [['', 'Any service'], ...svc.slice(0, 16).map((s) => [String(s.id), s.name])] as [string, string][], clears: resets }] : []),
  // film lists only: there are none for TV
  ...(kind === 'film' ? [{ name: 'list', label: 'Prizes and classics', value: picked?.slug ?? '', options: [['', 'Prizes and classics'], ...listsOfKind('film').map((l) => [l.slug, l.title] as [string, string])] as [string, string][], clears: ['genre', 'language', 'service', 'decade', 'year', 'sort'] }] : []),
  { name: 'sort', label: 'Order', value: picked ? '' : sort === 'popular' ? '' : sort, options: [['', 'Popular'], ['top', 'Highest rated'], ['new', 'Newest']] as [string, string][], clears: resets },
];

const base = kind === 'tv' ? '/films/?kind=tv&' : '/films/?';
const genreLinks = (kind === 'tv' ? TV_GENRES : FILM_GENRES).map(([, n]) => [`${base}genre=${genreSlug(n)}`, n]);
const langLinks = LANGS.slice(0, 12).map((c) => [`${base}language=${c}`, languageName(c) ?? c]);
const serviceLinks = svc.slice(0, 10).map((s) => [`${base}service=${s.id}`, s.name]);
const decadeLinks = decades.slice(0, 8).map(([d, n]) => [`${base}decade=${d}`, n]);
const switchTo = (k: string) => { const u = new URLSearchParams(); if (k === 'tv') u.set('kind', 'tv'); if (language) u.set('language', language); if (decade) u.set('decade', String(decade)); if (year) u.set('year', String(year)); if (service) u.set('service', String(service)); const s = u.toString(); return `/films/${s ? '?' + s : ''}`; };
---
<Base title={title} active="films" description={`${title} on Granthalaya: browse, save and log.`}>
  <section class="pad head">
    <div class="seg" role="group" aria-label="Films or TV">
      <a href={switchTo('film')} aria-current={kind === 'film' ? 'page' : undefined} class:list={['sw', kind === 'film' && 'on']}>Films</a>
      <a href={switchTo('tv')} aria-current={kind === 'tv' ? 'page' : undefined} class:list={['sw', kind === 'tv' && 'on']}>TV</a>
    </div>
    <h1 class="title">{title}</h1>
    <Filters fields={fields} keep={kind === 'tv' ? { kind: 'tv' } : {}} />
  </section>
  {picked ? (
    <section class="pad">
      <p class="muted lede">{picked.intro}</p>
      <ListGrid list={picked} decade={dcPicked} />
    </section>
  ) : front && tmdbReady() ? (
    <section class="pad rows">
      {rows.map((r) => <PosterRow {...r} />)}
      <div class="browse">
        <div class="bset"><h2 class="eyebrow">By genre</h2><div class="chips">{genreLinks.map(([h, n]) => <a class="gchip" href={h}>{n}</a>)}</div></div>
        <div class="bset"><h2 class="eyebrow">By language</h2><div class="chips">{langLinks.map(([h, n]) => <a class="gchip" href={h}>{n}</a>)}</div></div>
        {serviceLinks.length > 0 && <div class="bset"><h2 class="eyebrow">Streaming in India</h2><div class="chips">{serviceLinks.map(([h, n]) => <a class="gchip" href={h}>{n}</a>)}</div></div>}
        <div class="bset"><h2 class="eyebrow">By decade</h2><div class="chips">{decadeLinks.map(([h, n]) => <a class="gchip" href={h}>{n}</a>)}</div></div>
        {kind === 'film' && <div class="bset"><h2 class="eyebrow">Prizes and classics</h2><div class="chips">{listsOfKind('film').map((l) => <a class="gchip" href={listBrowseHref(l)}>{l.title}</a>)}<a class="gchip" href="/lists/">All lists</a></div></div>}
      </div>
      <p class="credit-line">Data from TMDB. Streaming data from JustWatch.</p>
    </section>
  ) : (
  <section class="pad">
    {!tmdbReady() ? <p class="muted">Film search isn’t set up on this copy of the site yet.</p>
      : list.items.length === 0 ? <p class="muted empty">Nothing matches all of that. Try fewer filters.</p>
      : (
        <div class="grid">
          {list.items.map((c) => <PosterTile href={c.href} title={c.title} year={c.year} poster={c.poster} kind={c.kind} status={marks.get(`${c.kind}:${c.id}`)} save={c.kind === 'film' ? { kind: 'film', tmdbId: c.id, title: c.title, year: c.year, cover: c.poster } : undefined} />)}
        </div>
      )}
    <Pager page={page} pages={list.pages} />
    <p class="credit-line">Data from TMDB. Streaming data from JustWatch.</p>
  </section>
  )}
</Base>
<style>
  .head { padding-top: 44px; padding-bottom: 28px; display: flex; flex-direction: column; align-items: flex-start; gap: 18px; }
  .sw { display: inline-flex; align-items: center; height: 36px; padding: 0 18px; border-radius: 18px; font-size: 13px; font-weight: 600; }
  .sw.on { background: var(--ink); color: var(--bg); }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 28px 20px; }
  .lede { margin: 0 0 28px; max-width: 60ch; font-size: 16px; }
  .empty { font-size: 16px; }
  .rows { display: flex; flex-direction: column; gap: 48px; padding-bottom: 8px; }
  .browse { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px 48px; padding-top: 8px; }
  .bset { display: flex; flex-direction: column; gap: 12px; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .chips .gchip:hover { color: var(--ink); }
  .rows .credit-line { margin-top: -16px; }
  .credit-line { margin: 32px 0 0; font-size: 12px; color: var(--muted); }
  @media (max-width: 780px) { .browse { grid-template-columns: 1fr; } .rows { gap: 36px; } }
  @media (max-width: 780px) { .head { padding-top: 28px; } .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px 12px; } }
</style>
