---
import { ClientRouter } from 'astro:transitions';
import Logo from '../components/Logo.astro';
import Valley from '../components/Valley.astro';
import { site } from '../data/site';
import '../styles/global.css';

interface Props { title?: string; description?: string; active?: 'library' | 'notes' | 'threads' | 'stats' | 'about'; image?: string }
const { title, description = site.description, active, image = '/img/og.jpg' } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} — ${site.owner}'s library`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const nav = [
  { key: 'library', label: 'Library', href: '/library/' },
  { key: 'notes', label: 'Notes', href: '/notes/' },
  { key: 'threads', label: 'Threads', href: '/threads/' },
  { key: 'stats', label: 'Stats', href: '/stats/' },
];
---
<!doctype html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="alternate" type="application/rss+xml" title={site.name} href="/rss.xml" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(image, Astro.site)} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#15171B" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400&family=Instrument+Sans:wght@400;500;600&family=Courier+Prime:wght@400;700&display=swap" />
  <script is:inline>
    (function () {
      function apply() {
        var t = null;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        document.documentElement.dataset.theme = t === 'light' ? 'light' : 'dark';
      }
      apply();
      document.addEventListener('astro:after-swap', apply);
    })();
  </script>
  <ClientRouter />
</head>
<body>
  <a class="sr skip" href="#main">Skip to content</a>
  <div class="site-wrap">
    <header class="site">
      <a href="/" class="brand" aria-label={`${site.name}, home`}><Logo /><span>{site.name}</span></a>
      <nav class="nav" aria-label="Main">
        {nav.map((n) => <a href={n.href} aria-current={active === n.key ? 'page' : undefined}>{n.label}</a>)}
      </nav>
      <div class="actions">
        <button class="iconbtn" data-search-open aria-label="Search everything (⌘K)" title="Search  ⌘K">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg>
        </button>
        <button class="iconbtn" data-theme-toggle aria-label="Switch between light and dark">
          <svg class="theme-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          <svg class="theme-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"/></svg>
        </button>
        <a href="/add/" class="btn primary owner-only" hidden><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>Add</a>
        <a href="/rss.xml" class="btn hide-sm visitor-only">Subscribe</a>
      </div>
    </header>
  </div>

  <main id="main">
    <slot />
  </main>

  <div class="foot-wrap">
    <Valley />
    <footer class="foot">
      <div class="foot-in">
        <span>{site.name} · made slowly, in {site.city}. Paintings © {site.owner}.</span>
        <nav aria-label="Footer"><a href="/about/">About</a><a href="/rss.xml">RSS</a><a href="/library/">Everything</a><a href="/add/" class="visitor-only">Sign in</a><a href="/add/" class="owner-only" hidden>Add something</a></nav>
      </div>
    </footer>
  </div>

  <dialog class="search" id="search" aria-label="Search the library">
    <div class="search-top">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" style="color:var(--muted)"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg>
      <input type="search" placeholder="Search books, films, essays…" aria-label="Search" autocomplete="off" spellcheck="false" aria-controls="search-list" />
      <kbd>esc</kbd>
    </div>
    <ul class="search-list" id="search-list" role="listbox"></ul>
    <div class="search-foot"><span>↑ ↓ to move</span><span>↵ to open</span><span style="margin-left:auto">⌘K anywhere</span></div>
  </dialog>

  <style>
    .skip:focus { position: fixed !important; left: 12px; top: 12px; width: auto; height: auto; clip: auto; z-index: 99; background: var(--ink); color: var(--bg); padding: 10px 14px; border-radius: 10px; }
  </style>

  <script>
    import { navigate } from 'astro:transitions/client';

    // ——— light / dark ———
    document.addEventListener('click', (ev) => {
      const t = (ev.target as Element).closest('[data-theme-toggle]');
      if (!t) return;
      const root = document.documentElement;
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      const flip = () => { root.dataset.theme = next; try { localStorage.setItem('theme', next); } catch (e) {} };
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      // @ts-ignore
      if (document.startViewTransition && !reduce) document.startViewTransition(flip); else flip();
    });

    // ——— show the Add button when you're signed in ———
    function paintOwner() {
      const owner = /(?:^|; )g_owner=1/.test(document.cookie);
      document.querySelectorAll<HTMLElement>('.owner-only').forEach((el) => (el.hidden = !owner));
      document.querySelectorAll<HTMLElement>('.visitor-only').forEach((el) => (el.hidden = owner));
    }
    document.addEventListener('astro:page-load', paintOwner);
    document.addEventListener('owner-changed', paintOwner);

    // ——— the paintings stay on the page: no right-click saving, no dragging ———
    const guarded = (t: EventTarget | null) => !!(t as Element)?.closest?.('.art, .valley, .cover, img');
    document.addEventListener('contextmenu', (ev) => { if (guarded(ev.target)) ev.preventDefault(); });
    document.addEventListener('dragstart', (ev) => { if (guarded(ev.target)) ev.preventDefault(); });

    // ——— copy buttons ———
    document.addEventListener('click', async (ev) => {
      const b = (ev.target as Element).closest<HTMLButtonElement>('[data-copy]');
      if (!b) return;
      try { await navigator.clipboard.writeText(b.dataset.copy!); } catch (e) {}
      const label = b.getAttribute('aria-label');
      b.classList.add('copied');
      if (!b.querySelector('svg')) { const old = b.textContent; b.textContent = 'Copied'; setTimeout(() => (b.textContent = old), 1600); }
      else { b.setAttribute('aria-label', 'Copied'); setTimeout(() => { b.classList.remove('copied'); if (label) b.setAttribute('aria-label', label); }, 1600); }
    });

    // ——— search (⌘K) ———
    type Item = { title: string; creator: string; kind: string; href: string; bg: string; r: string; year: string };
    let items: Item[] | null = null;
    let sel = 0;
    const dialog = () => document.getElementById('search') as HTMLDialogElement;
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
    const hi = (s: string, q: string) => {
      if (!q) return esc(s);
      const i = s.toLowerCase().indexOf(q);
      return i < 0 ? esc(s) : esc(s.slice(0, i)) + '<mark>' + esc(s.slice(i, i + q.length)) + '</mark>' + esc(s.slice(i + q.length));
    };
    async function load() {
      if (!items) items = await fetch('/search.json').then((r) => r.json());
      return items!;
    }
    function render(q: string) {
      const list = document.getElementById('search-list')!;
      const all = items || [];
      q = q.trim().toLowerCase();
      const found = q
        ? all.filter((x) => (x.title + ' ' + x.creator + ' ' + x.kind + ' ' + x.year).toLowerCase().includes(q)).slice(0, 12)
        : all.slice(0, 6);
      sel = 0;
      if (!found.length) { list.innerHTML = `<li class="search-empty">Nothing called “${esc(q)}” yet.</li>`; return; }
      list.innerHTML = (q ? '' : '<li class="eyebrow" style="padding:8px 12px 4px;font-size:11px">Recently</li>') + found.map((x, i) =>
        `<li><a href="${x.href}" role="option" aria-selected="${i === 0}"><span class="wash sw" style="background:${x.bg};border-radius:${x.r}"></span>` +
        `<span style="display:flex;flex-direction:column;gap:2px;min-width:0"><span class="serif" style="font-size:18px">${hi(x.title, q)}</span>` +
        `<span style="font-size:13px;color:var(--muted)">${hi(x.creator, q)} · ${x.year}</span></span>` +
        `<span class="eyebrow" style="margin-left:auto;font-size:11px">${x.kind}</span></a></li>`).join('');
    }
    function move(d: number) {
      const opts = [...document.querySelectorAll<HTMLElement>('#search-list [role=option]')];
      if (!opts.length) return;
      sel = (sel + d + opts.length) % opts.length;
      opts.forEach((o, i) => o.setAttribute('aria-selected', String(i === sel)));
      opts[sel].scrollIntoView({ block: 'nearest' });
    }
    async function open() {
      const d = dialog();
      if (d.open) return;
      const input = d.querySelector('input')!;
      input.value = '';
      d.showModal();
      await load();
      render('');
      input.focus();
    }
    document.addEventListener('click', (ev) => {
      const el = ev.target as Element;
      if (el.closest('[data-search-open]')) { ev.preventDefault(); open(); return; }
      const d = dialog();
      if (d && d.open) {
        if (el === d) d.close(); // click on the backdrop
        else if (el.closest('#search-list a')) d.close();
      }
    });
    document.addEventListener('keydown', (ev) => {
      const d = dialog();
      if ((ev.metaKey || ev.ctrlKey) && ev.key.toLowerCase() === 'k') { ev.preventDefault(); d.open ? d.close() : open(); return; }
      const typing = (ev.target as Element).closest('input, textarea, [contenteditable]');
      if (ev.key === '/' && !typing && !d.open) { ev.preventDefault(); open(); return; }
      if (!d.open) return;
      if (ev.key === 'ArrowDown') { ev.preventDefault(); move(1); }
      if (ev.key === 'ArrowUp') { ev.preventDefault(); move(-1); }
      if (ev.key === 'Enter') {
        const a = document.querySelector<HTMLAnchorElement>('#search-list [aria-selected="true"]');
        if (a) { ev.preventDefault(); d.close(); navigate(a.getAttribute('href')!); }
      }
    });
    document.addEventListener('input', (ev) => {
      if ((ev.target as Element).closest('#search input')) render((ev.target as HTMLInputElement).value);
    });
  </script>
</body>
</html>
