---
import { ClientRouter } from 'astro:transitions';
import Logo from '../components/Logo.astro';
import Valley from '../components/Valley.astro';
import Drawn from '../components/ui/Drawn.astro';
import { site } from '../data/site';
import { initial } from '../lib/data';
import '../styles/starwind.css';
import '../styles/global.css';

interface Props {
  title?: string; description?: string; image?: string;
  /** which top-bar link is the current page (the top bar gets Films, Books and Collections with browse) */
  active?: string;
  /** whose shelf this page belongs to (for the menu and search); defaults to yours */
  shelf?: string;
  /** a line of the week for the shepherd in the footer */
  line?: { text: string; by?: string; source?: string };
  /** keep this page out of search engines */
  noindex?: boolean;
}
const { title, description = site.description, active, image = '/img/og.jpg', line, noindex = false } = Astro.props;
const me = Astro.locals.me;
const shelf = Astro.props.shelf ?? me?.username;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · a shelf for everything you read and watch`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Site-wide links only. A shelf's own pages (Library, Diary, Collections, Stats) live in its tabs.
const nav: { key: string; label: string; href: string }[] = [
  { key: 'films', label: 'Films', href: '/films/' },
  { key: 'books', label: 'Books', href: '/books/' },
];
const avatar = me?.avatar_url;
---
<!doctype html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  {shelf && <link rel="alternate" type="application/rss+xml" title={`@${shelf} on ${site.name}`} href={`/@${shelf}/rss.xml`} />}
  {noindex && <meta name="robots" content="noindex" />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(image, Astro.site)} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#15171B" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400&family=Instrument+Sans:wght@400;500;600&family=Courier+Prime:wght@400;700&display=swap" />
  <script is:inline>
    (function () {
      function apply() {
        var t = null;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        document.documentElement.dataset.theme = t === 'light' ? 'light' : 'dark';
      }
      apply();
      document.addEventListener('astro:after-swap', apply);
    })();
  </script>
  <ClientRouter />
</head>
<body>
  <a class="sr skip" href="#main">Skip to content</a>
  <div class="site-wrap">
    <header class="site">
      <a href="/" class="brand" aria-label={`${site.name}, home`}><Logo /><span>{site.name}</span></a>
      {nav.length > 0 ? (
        <nav class="nav" aria-label="Browse">
          {nav.map((n) => <a href={n.href} aria-current={active === n.key ? 'page' : undefined}>{n.label}</a>)}
        </nav>
      ) : null}
      <div class="actions">
        <button class="iconbtn" data-search-open aria-label="Search films, books and people (⌘K)" title="Search  ⌘K">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg>
        </button>
        <button class="iconbtn" data-theme-toggle aria-label="Switch between light and dark">
          <svg class="theme-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          <svg class="theme-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"/></svg>
        </button>
        {me ? (
          <>
            <a href="/add/" class="btn primary addbtn" aria-label="Add a book, film or essay" data-search-open="add"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg><span>Add</span></a>
            <details class="menu">
              <summary class="avatar" aria-label="Your account">
                {avatar ? <img src={avatar} alt="" referrerpolicy="no-referrer" /> : <span>{initial(me.display_name || me.username)}</span>}
              </summary>
              <div class="menu-list" role="menu">
                <div class="menu-who"><b>{me.display_name || me.username}</b><span>@{me.username}</span></div>
                <a role="menuitem" href={`/@${me.username}/`}>Profile</a>
                <a role="menuitem" href="/settings/">Settings</a>
                {me.is_admin && <a role="menuitem" href="/admin/">Reports</a>}
                <form method="post" action="/auth/signout" data-astro-reload><button role="menuitem" type="submit">Sign out</button></form>
              </div>
            </details>
          </>
        ) : (
          <a href={`/signin/?next=${encodeURIComponent(Astro.url.pathname)}`} class="btn primary" data-astro-prefetch="false">Sign in</a>
        )}
      </div>
    </header>
  </div>

  <main id="main">
    <slot />
  </main>

  <div class="foot-wrap">
    <Valley line={line} />
    <footer class="foot">
      <div class="foot-in">
        <span>Made with ❤️ by {site.maker}</span>
        <nav aria-label="Footer"><a href="/about/">About</a><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a>{me ? <a href="/add/">Add something</a> : <a href="/signin/" data-astro-prefetch="false">Sign in</a>}</nav>
      </div>
    </footer>
  </div>

  <dialog class="search" id="search" aria-label="Search" data-src={me ? `/api/search?u=${me.username}` : ''}>
    <div class="search-top">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" style="color:var(--muted)"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg>
      <input type="search" placeholder="Search films, TV, books and people" aria-label="Search" autocomplete="off" spellcheck="false" aria-controls="search-list" />
      <span class="search-wait" hidden><span class="ink" aria-hidden="true"></span></span>
      <kbd>esc</kbd>
    </div>
    <ul class="search-list" id="search-list" role="listbox" aria-label="Results"></ul>
    <div class="search-foot"><span>↑ ↓ to move</span><span>↵ to open</span>{me ? <a href="/add/" class="search-add">Add something by hand →</a> : <span style="margin-left:auto">⌘K anywhere</span>}</div>
  </dialog>

  <dialog class="box coll" id="coll-box" aria-labelledby="coll-h">
    <h2 id="coll-h">Add to a collection</h2>
    <p id="coll-what"></p>
    <ul class="coll-list" id="coll-list"><li class="muted">Loading…</li></ul>
    <form class="coll-new" id="coll-new"><input class="field" name="name" maxlength="120" placeholder="New collection" aria-label="New collection name" required /><button class="btn" type="submit">Create</button></form>
    <p class="notice bad" id="coll-err" hidden></p>
    <div class="row"><button class="btn primary" type="button" data-close-coll>Done</button></div>
  </dialog>


  <dialog class="box" id="report-box" aria-labelledby="report-h">
    <form method="dialog" id="report-form">
      <h2 id="report-h">Report</h2>
      <p>Tell us what’s wrong. Reports are private: the person isn’t told who sent one.</p>
      <div class="reasons">
        <label><input type="radio" name="reason" value="spam" required /> Spam or a fake account</label>
        <label><input type="radio" name="reason" value="abuse" /> Harassment or bullying</label>
        <label><input type="radio" name="reason" value="hate" /> Hate</label>
        <label><input type="radio" name="reason" value="sexual" /> Sexual content</label>
        <label><input type="radio" name="reason" value="illegal" /> Something illegal</label>
        <label><input type="radio" name="reason" value="other" /> Something else</label>
      </div>
      <textarea class="field" name="details" rows="3" maxlength="1000" placeholder="Anything that helps (optional)"></textarea>
      <div class="row"><button class="btn" value="cancel" formnovalidate>Cancel</button><button class="btn primary" value="send">Send report</button></div>
    </form>
  </dialog>
  <div class="pageload" id="pageload" aria-hidden="true"><Drawn size={44} /></div>

  <dialog class="box" id="confirm-box" aria-labelledby="confirm-h">
    <form method="dialog">
      <h2 id="confirm-h"></h2>
      <p id="confirm-p"></p>
      <div class="row"><button class="btn" value="cancel">Cancel</button><button class="btn primary" value="ok" id="confirm-ok">OK</button></div>
    </form>
  </dialog>

  <style>
    .skip:focus { position: fixed !important; left: 12px; top: 12px; width: auto; height: auto; clip: auto; z-index: 99; background: var(--ink); color: var(--bg); padding: 10px 14px; border-radius: 10px; }
  </style>

  <script>
    import { navigate } from 'astro:transitions/client';

    // ——— light / dark ———
    document.addEventListener('click', (ev) => {
      const t = (ev.target as Element).closest('[data-theme-toggle]');
      if (!t) return;
      const root = document.documentElement;
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      const flip = () => { root.dataset.theme = next; try { localStorage.setItem('theme', next); } catch (e) {} };
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      // @ts-ignore
      if (document.startViewTransition && !reduce) document.startViewTransition(flip); else flip();
    });

    // ——— the account menu closes when you click elsewhere or move to another page ———
    document.addEventListener('click', (ev) => {
      document.querySelectorAll<HTMLDetailsElement>('details.menu[open]').forEach((d) => { if (!d.contains(ev.target as Node)) d.open = false; });
    });
    document.addEventListener('astro:after-swap', () => document.querySelectorAll<HTMLDetailsElement>('details.menu[open]').forEach((d) => (d.open = false)));


    // ——— small actions on shelves: status, favourites, quick add, report, block ———
    const MARK = document.querySelector('#pageload .dr-fill')?.getAttribute('d') ?? '';
    function toast(msg: string, opts: { mark?: boolean; action?: { label: string; run: () => void } } = {}) {
      document.querySelectorAll('.toast').forEach((t) => t.remove());
      const t = document.createElement('div');
      t.className = 'toast'; t.setAttribute('role', 'status');
      if (opts.mark && MARK) t.insertAdjacentHTML('beforeend', `<svg class="mk" viewBox="0 0 100 100" aria-hidden="true"><path class="mk-fill" fill-rule="evenodd" d="${MARK}"/></svg>`);
      const span = document.createElement('span'); span.textContent = msg; t.appendChild(span);
      const close = () => { t.classList.add('out'); setTimeout(() => t.remove(), 160); };
      if (opts.action) {
        const b = document.createElement('button'); b.type = 'button'; b.textContent = opts.action.label;
        b.addEventListener('click', () => { close(); opts.action!.run(); });
        t.appendChild(b);
      }
      document.body.appendChild(t);
      setTimeout(close, opts.action ? 5000 : 3200);
    }
    // a message to show once the page has reloaded (with Undo for something just saved)
    function later(note: { msg: string; undo?: string }) { try { sessionStorage.setItem('toastNext', JSON.stringify(note)); } catch (e) {} }
    document.addEventListener('astro:page-load', () => {
      let note: { msg: string; undo?: string } | null = null;
      try { note = JSON.parse(sessionStorage.getItem('toastNext') || 'null'); sessionStorage.removeItem('toastNext'); } catch (e) {}
      if (!note) return;
      toast(note.msg, { mark: true, action: note.undo ? { label: 'Undo', run: async () => { if (await send('/api/log', 'DELETE', { id: note!.undo })) reload(); } } : undefined });
    });
    // a button that's waiting: its icon becomes the Ink loader
    function busy(b: HTMLElement, on: boolean) {
      if (on) {
        b.setAttribute('aria-busy', 'true');
        if (!b.querySelector(':scope > .ink')) b.insertAdjacentHTML('afterbegin', '<span class="ink" aria-hidden="true"></span>');
      } else {
        b.removeAttribute('aria-busy');
        b.querySelector(':scope > .ink')?.remove();
      }
      (b as HTMLButtonElement).disabled = on;
    }
    async function send(path: string, method: string, data: unknown) {
      try {
        const r = await fetch(path, { method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
        const j = await r.json().catch(() => ({}));
        if (!r.ok) { toast(j.error || 'That didn’t work. Please try again.'); return null; }
        return j;
      } catch { toast('Couldn’t reach the site. Check your connection.'); return null; }
    }
    function ask(title: string, text: string, ok: string): Promise<boolean> {
      const d = document.getElementById('confirm-box') as HTMLDialogElement;
      d.querySelector('#confirm-h')!.textContent = title;
      d.querySelector('#confirm-p')!.textContent = text;
      d.querySelector('#confirm-ok')!.textContent = ok;
      d.returnValue = '';
      d.showModal();
      return new Promise((done) => d.addEventListener('close', () => done(d.returnValue === 'ok'), { once: true }));
    }
    function reportBox(target: { user: string; log: string | null; who: string }): Promise<{ reason: string; details: string } | null> {
      const d = document.getElementById('report-box') as HTMLDialogElement;
      const f = d.querySelector('form') as HTMLFormElement;
      f.reset();
      d.querySelector('#report-h')!.textContent = target.log ? 'Report this entry' : `Report @${target.who}`;
      d.returnValue = '';
      d.showModal();
      return new Promise((done) => d.addEventListener('close', () => {
        if (d.returnValue !== 'send') return done(null);
        const fd = new FormData(f);
        done({ reason: String(fd.get('reason') || 'other'), details: String(fd.get('details') || '') });
      }, { once: true }));
    }
    const reload = () => navigate(location.pathname + location.search, { history: 'replace' });
    document.addEventListener('click', async (ev) => {
      const el = ev.target as Element;
      const st = el.closest<HTMLButtonElement>('[data-set-status]');
      if (st) {
        const v = JSON.parse(st.dataset.setStatus!);
        if (st.getAttribute('aria-pressed') === 'true') return;
        busy(st, true);
        if (await send('/api/log', 'PATCH', v)) reload(); else busy(st, false);
        return;
      }
      // Save (want to read / watch): the bookmark fills in, with a way to take it back
      const qa = el.closest<HTMLButtonElement>('[data-quick-add]');
      if (qa) {
        if (qa.classList.contains('is-saved')) return;
        const label = qa.querySelector<HTMLElement>('[data-label]');
        const before = label?.textContent ?? '';
        qa.classList.add('is-saved'); qa.disabled = true;
        const r = await send('/api/log', 'POST', JSON.parse(qa.dataset.quickAdd!));
        if (!r) { qa.classList.remove('is-saved'); qa.disabled = false; return; }
        if (label) label.textContent = qa.dataset.savedLabel || 'Saved';
        // in a log panel the rest of the panel changes too, so reload it and say so afterwards
        if (qa.closest('.logpanel')) { later({ msg: 'Saved to your shelf', undo: r.id }); reload(); return; }
        toast('Saved to your shelf', { mark: true, action: { label: 'Undo', run: async () => {
          if (await send('/api/log', 'DELETE', { id: r.id })) { qa.classList.remove('is-saved'); qa.disabled = false; if (label) label.textContent = before; }
        } } });
        return;
      }
      const pin = el.closest<HTMLButtonElement>('[data-pin]');
      if (pin) {
        const v = JSON.parse(pin.dataset.pin!);
        busy(pin, true);
        const r = await send('/api/profile', 'POST', { section: 'pin', line: v.on ? v.id : null });
        if (r) { toast(v.on ? 'Pinned to your profile' : 'Unpinned', { mark: v.on }); reload(); } else busy(pin, false);
        return;
      }
      const rep = el.closest<HTMLElement>('[data-report]');
      if (rep) {
        rep.closest('details')?.removeAttribute('open');
        const target = JSON.parse(rep.dataset.report!);
        const r = await reportBox(target);
        if (r && await send('/api/report', 'POST', { user: target.user, log: target.log, ...r })) toast('Thanks. Your report was sent.');
        return;
      }
      const bl = el.closest<HTMLElement>('[data-block]');
      if (bl) {
        bl.closest('details')?.removeAttribute('open');
        const v = JSON.parse(bl.dataset.block!);
        if (!v.blocked && !(await ask(`Block @${v.who}?`, 'You won’t see each other’s profiles or shelves. They aren’t told. You can unblock them in Settings.', 'Block'))) return;
        const r = await send('/api/block', v.blocked ? 'DELETE' : 'POST', { id: v.id });
        if (r) { toast(v.blocked ? `Unblocked @${v.who}.` : `Blocked @${v.who}.`); if (!v.blocked) navigate('/'); else reload(); }
      }
    });

    // ——— the log panel on film, TV and book pages ———
    document.addEventListener('change', (ev) => {
      const pickS = (ev.target as Element).closest<HTMLSelectElement>('[data-season-pick]');
      if (!pickS) return;
      const panel = pickS.closest('.logpanel')!;
      panel.querySelectorAll<HTMLElement>('[data-season-panel]').forEach((p) => (p.hidden = p.dataset.seasonPanel !== pickS.value));
    });
    const paintStars = (box: HTMLElement, v: number) => box.querySelectorAll<HTMLElement>('.st').forEach((s, i) => {
      s.classList.toggle('full', v >= i + 1);
      s.classList.toggle('half', v === i + 0.5);
    });
    document.addEventListener('mouseover', (ev) => {
      const h = (ev.target as Element).closest<HTMLElement>('.stars-in [data-rate]');
      if (h) paintStars(h.closest('.stars-in')!, Number(h.dataset.rate));
    });
    document.addEventListener('mouseout', (ev) => {
      const box = (ev.target as Element).closest<HTMLElement>('.stars-in');
      if (box && !box.contains(ev.relatedTarget as Node)) paintStars(box, Number(box.dataset.rating || 0));
    });
    document.addEventListener('astro:page-load', () => document.querySelectorAll<HTMLElement>('.stars-in').forEach((b) => paintStars(b, Number(b.dataset.rating || 0))));
    document.addEventListener('click', async (ev) => {
      const el = ev.target as Element;
      const rate = el.closest<HTMLButtonElement>('[data-rate]');
      if (rate) {
        const box = (rate.closest('.lp-rate')?.querySelector('.stars-in') ?? null) as HTMLElement | null;
        if (!box) return;
        const v = Number(rate.dataset.rate);
        const src = JSON.parse(box.dataset.rateSrc!);
        if (!v && !src.id) return;
        if (src.id && v === Number(box.dataset.rating)) return;
        box.dataset.rating = String(v); paintStars(box, v);
        const r = src.id ? await send('/api/log', 'PATCH', { id: src.id, rating: v || null }) : await send('/api/log', 'POST', { ...src, status: 'done', rating: v });
        if (r) reload();
        return;
      }
      const lognew = el.closest<HTMLButtonElement>('[data-log-new]');
      if (lognew) {
        busy(lognew, true);
        if (await send('/api/log', 'POST', JSON.parse(lognew.dataset.logNew!))) reload(); else busy(lognew, false);
        return;
      }
      const write = el.closest<HTMLButtonElement>('[data-write]');
      if (write) {
        busy(write, true);
        const r = await send('/api/title', 'POST', JSON.parse(write.dataset.write!));
        if (r?.id) navigate(`/add/?title=${r.id}`); else busy(write, false);
        return;
      }
      const collect = el.closest<HTMLElement>('[data-collect]');
      if (collect) { openCollections(JSON.parse(collect.dataset.collect!)); return; }
      if (el.closest('[data-close-coll]') || el.id === 'coll-box') (document.getElementById('coll-box') as HTMLDialogElement).close();
    });

    // ——— add to a collection ———
    let collecting: { title?: string; hit?: unknown; what?: string } = {};
    const collErr = (m = '') => { const e = document.getElementById('coll-err')!; e.textContent = m; e.hidden = !m; };
    async function openCollections(src: typeof collecting) {
      collecting = src;
      const d = document.getElementById('coll-box') as HTMLDialogElement;
      d.querySelector('#coll-what')!.textContent = src.what ? `Choose where ${src.what} belongs.` : '';
      collErr();
      d.showModal();
      await listCollections();
    }
    async function listCollections() {
      const list = document.getElementById('coll-list')!;
      const r = await fetch(`/api/collection${collecting.title ? `?title=${collecting.title}` : ''}`).then((x) => x.json()).catch(() => null);
      if (!r?.ok) { list.innerHTML = '<li class="muted">Couldn’t load your collections.</li>'; return; }
      list.innerHTML = r.collections.length
        ? r.collections.map((c: any) => `<li><label><input type="checkbox" data-coll="${esc(c.id)}" ${c.has ? 'checked' : ''}/><span>${esc(c.name)}</span><span class="muted num">${c.count}</span></label></li>`).join('')
        : '<li class="muted">No collections yet. Name your first one below.</li>';
    }
    document.addEventListener('change', async (ev) => {
      const box = (ev.target as Element).closest<HTMLInputElement>('[data-coll]');
      if (!box) return;
      collErr();
      box.disabled = true;
      const r = await send('/api/collection', 'POST', { action: box.checked ? 'add' : 'remove', collection: box.dataset.coll, title: collecting.title, hit: collecting.title ? undefined : collecting.hit });
      box.disabled = false;
      if (!r) { box.checked = !box.checked; return; }
      if (r.title) collecting.title = r.title;
      const n = box.parentElement!.querySelector('.num')!;
      n.textContent = String(Math.max(0, Number(n.textContent) + (box.checked ? 1 : -1)));
    });
    document.addEventListener('submit', async (ev) => {
      const f = ev.target as HTMLFormElement;
      if (f.id !== 'coll-new') return;
      ev.preventDefault();
      const name = (f.elements.namedItem('name') as HTMLInputElement).value.trim();
      if (!name) return;
      const b = f.querySelector('button')!;
      busy(b, true);
      const r = await send('/api/collection', 'POST', { action: 'create', name, title: collecting.title, hit: collecting.title ? undefined : collecting.hit });
      busy(b, false);
      if (!r) return;
      if (r.title) collecting.title = r.title;
      f.reset();
      await listCollections();
      toast(`Added to ${name}`);
    }, true); // before the page router, which would otherwise send the form as a page visit

    // ——— a page that takes more than a moment shows the Drawn loader ———
    let loadTimer = 0;
    document.addEventListener('astro:before-preparation', () => {
      clearTimeout(loadTimer);
      loadTimer = window.setTimeout(() => document.getElementById('pageload')?.classList.add('on'), 450);
    });
    const loaded = () => { clearTimeout(loadTimer); document.getElementById('pageload')?.classList.remove('on'); };
    document.addEventListener('astro:after-swap', loaded);
    document.addEventListener('astro:page-load', loaded);

    // ——— the paintings stay on the page: no right-click saving, no dragging ———
    const guarded = (t: EventTarget | null) => !!(t as Element)?.closest?.('.art, .valley, .cover, img');
    document.addEventListener('contextmenu', (ev) => { if (guarded(ev.target)) ev.preventDefault(); });
    document.addEventListener('dragstart', (ev) => { if (guarded(ev.target)) ev.preventDefault(); });

    // ——— copy buttons ———
    document.addEventListener('click', async (ev) => {
      const b = (ev.target as Element).closest<HTMLButtonElement>('[data-copy]');
      if (!b) return;
      try { await navigator.clipboard.writeText(b.dataset.copy!); } catch (e) {}
      const label = b.getAttribute('aria-label');
      if (b.classList.contains('copied')) return;
      b.classList.add('copied');
      const old = b.innerHTML;
      // a tick for a moment, like copying in a chat
      if (b.querySelector('svg')) b.innerHTML = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>';
      else b.textContent = 'Copied';
      b.setAttribute('aria-label', 'Copied');
      setTimeout(() => { b.innerHTML = old; b.classList.remove('copied'); if (label) b.setAttribute('aria-label', label); }, 1500);
    });

    // ——— search (⌘K): your shelf, then films, TV, books, people and members ———
    type Mine = { title: string; creator: string; kind: string; href: string; bg: string; r: string; year: string };
    let mine: Mine[] | null = null;
    let mineFrom = '';
    let sel = 0;
    let timer = 0;
    let asked = '';
    const dialog = () => document.getElementById('search') as HTMLDialogElement;
    const esc = (s: unknown) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
    const hi = (s: string, q: string) => {
      if (!q) return esc(s);
      const i = s.toLowerCase().indexOf(q);
      return i < 0 ? esc(s) : esc(s.slice(0, i)) + '<mark>' + esc(s.slice(i, i + q.length)) + '</mark>' + esc(s.slice(i + q.length));
    };
    async function loadMine() {
      const src = dialog()?.dataset.src || '';
      if (!src) return (mine = []);
      if (!mine || mineFrom !== src) { mine = await fetch(src).then((r) => r.json()).catch(() => []); mineFrom = src; }
      return mine!;
    }
    const thumb = (src: string | undefined, round = false, bg = 'var(--soft)') =>
      `<span class="sthumb${round ? ' round' : ''}" style="background:${bg}">${src ? `<img src="${esc(src)}" alt="" loading="lazy" referrerpolicy="no-referrer" onerror="this.remove()">` : ''}</span>`;
    const row = (href: string, th: string, title: string, sub: string, tag: string, q: string) =>
      `<li><a href="${esc(href)}" role="option" aria-selected="false">${th}<span class="stext"><span class="serif st1">${hi(title, q)}</span><span class="st2">${esc(sub)}</span></span>${tag ? `<span class="eyebrow stag">${esc(tag)}</span>` : ''}</a></li>`;
    const group = (label: string, items: string[]) => (items.length ? `<li class="sgroup eyebrow">${esc(label)}</li>${items.join('')}` : '');
    function paint(html: string) {
      const list = document.getElementById('search-list')!;
      list.innerHTML = html;
      sel = 0;
      const first = list.querySelector('[role=option]');
      first?.setAttribute('aria-selected', 'true');
    }
    function shelfRows(q: string, n: number) {
      const all = mine || [];
      const found = q ? all.filter((x) => (x.title + ' ' + x.creator + ' ' + x.year).toLowerCase().includes(q)) : all;
      return found.slice(0, n).map((x) => row(x.href, `<span class="sthumb" style="background:${x.bg};border-radius:${x.r}"></span>`, x.title, `${x.creator} · ${x.year}`, x.kind, q));
    }
    function renderEmpty() {
      const add = dialog().dataset.mode === 'add';
      const recent = shelfRows('', 6);
      paint(recent.length
        ? group(add ? 'Add something new: start typing. Recently on your shelf' : 'Recently on your shelf', recent)
        : `<li class="search-empty">${add ? 'Find the book, film or show you want to add.' : 'Search films, TV, books and people.'}</li>`);
    }
    async function search(raw: string) {
      const q = raw.trim().toLowerCase();
      if (!q) { renderEmpty(); return; }
      const local = shelfRows(q, 3);
      paint(group('On your shelf', local) + (q.length >= 2 ? '<li class="search-empty small">Looking…</li>' : ''));
      if (q.length < 2) return;
      asked = q;
      const wait = document.querySelector<HTMLElement>('.search-wait');
      if (wait) wait.hidden = false;
      const r = await fetch(`/api/search?q=${encodeURIComponent(q)}`).then((x) => x.json()).catch(() => null);
      if (wait) wait.hidden = true;
      if (asked !== q || !dialog().open) return;
      if (!r) { paint(group('On your shelf', local) + '<li class="search-empty">Search isn’t answering right now. Try again in a moment.</li>'); return; }
      const titles = (r.titles ?? []).map((t: any) => row(t.href, thumb(t.poster), t.title, [t.year, t.kind === 'tv' ? 'TV' : 'Film'].filter(Boolean).join(' · '), '', q));
      const books = (r.books ?? []).map((b: any) => row(b.href, thumb(b.cover), b.title, [b.author, b.year].filter(Boolean).join(' · '), '', q));
      const people = [
        ...(r.people ?? []).map((p: any) => row(p.href, thumb(p.photo, true), p.name, p.known ?? 'Films and TV', '', q)),
        ...(r.authors ?? []).map((a: any) => row(a.href, thumb(undefined, true), a.name, `Author${a.works ? ` · ${a.works} works` : ''}`, '', q)),
      ];
      const members = (r.members ?? []).map((m: any) => row(m.href, thumb(m.avatar, true), m.name, `@${m.username}`, '', q));
      const html = group('On your shelf', local) + group('Films and TV', titles) + group('Books', books) + group('People', people) + group('On Granthalaya', members);
      paint(html || `<li class="search-empty">Nothing called “${esc(raw.trim())}”. ${dialog().dataset.src ? '<a href="/add/">Add it by hand →</a>' : ''}</li>`);
    }
    function move(d: number) {
      const opts = [...document.querySelectorAll<HTMLElement>('#search-list [role=option]')];
      if (!opts.length) return;
      sel = (sel + d + opts.length) % opts.length;
      opts.forEach((o, i) => o.setAttribute('aria-selected', String(i === sel)));
      opts[sel].scrollIntoView({ block: 'nearest' });
    }
    async function open(mode = '') {
      const d = dialog();
      if (d.open) return;
      d.dataset.mode = mode;
      const input = d.querySelector('input')!;
      input.value = '';
      input.placeholder = mode === 'add' ? 'Find a book, film or show to add' : 'Search films, TV, books and people';
      d.showModal();
      input.focus();
      await loadMine();
      renderEmpty();
    }
    document.addEventListener('click', (ev) => {
      const el = ev.target as Element;
      const opener = el.closest<HTMLElement>('[data-search-open]');
      if (opener) { ev.preventDefault(); open(opener.dataset.searchOpen || ''); return; }
      const d = dialog();
      if (d && d.open) {
        if (el === d) d.close(); // click on the backdrop
        else if (el.closest('#search-list a, .search-add')) d.close();
      }
    });
    document.addEventListener('keydown', (ev) => {
      const d = dialog();
      if ((ev.metaKey || ev.ctrlKey) && ev.key.toLowerCase() === 'k') { ev.preventDefault(); d.open ? d.close() : open(); return; }
      const typing = (ev.target as Element).closest('input, textarea, select, [contenteditable]');
      if (ev.key === '/' && !typing && !d.open) { ev.preventDefault(); open(); return; }
      if (!d.open) return;
      if (ev.key === 'ArrowDown') { ev.preventDefault(); move(1); }
      if (ev.key === 'ArrowUp') { ev.preventDefault(); move(-1); }
      if (ev.key === 'Enter') {
        const a = document.querySelector<HTMLAnchorElement>('#search-list [aria-selected="true"]');
        if (a) { ev.preventDefault(); d.close(); navigate(a.getAttribute('href')!); }
      }
    });
    document.addEventListener('input', (ev) => {
      if (!(ev.target as Element).closest('#search input')) return;
      const v = (ev.target as HTMLInputElement).value;
      clearTimeout(timer);
      const q = v.trim().toLowerCase();
      paint(group('On your shelf', shelfRows(q, 3)) || '');
      timer = window.setTimeout(() => search(v), q ? 260 : 0);
    });
  </script>
</body>
</html>
