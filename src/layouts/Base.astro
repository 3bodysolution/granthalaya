---
import { ClientRouter } from 'astro:transitions';
import Logo from '../components/Logo.astro';
import Valley from '../components/Valley.astro';
import { site } from '../data/site';
import { initial } from '../lib/data';
import '../styles/starwind.css';
import '../styles/global.css';

interface Props {
  title?: string; description?: string; image?: string;
  active?: 'library' | 'notes' | 'threads' | 'stats' | 'about' | 'add' | 'profile';
  /** whose shelf this page belongs to (for the menu and search); defaults to yours */
  shelf?: string;
  /** a line of the week for the shepherd in the footer */
  line?: { text: string; by?: string; source?: string };
  /** keep this page out of search engines */
  noindex?: boolean;
}
const { title, description = site.description, active, image = '/img/og.jpg', line, noindex = false } = Astro.props;
const me = Astro.locals.me;
const shelf = Astro.props.shelf ?? me?.username;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · a shelf for everything you read and watch`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const nav = shelf ? [
  { key: 'library', label: 'Library', href: `/@${shelf}/library/` },
  { key: 'notes', label: 'Notes', href: `/@${shelf}/notes/` },
  { key: 'threads', label: 'Threads', href: `/@${shelf}/threads/` },
  { key: 'stats', label: 'Stats', href: `/@${shelf}/stats/` },
] : [];
const avatar = me?.avatar_url;
---
<!doctype html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  {shelf && <link rel="alternate" type="application/rss+xml" title={`@${shelf} on ${site.name}`} href={`/@${shelf}/rss.xml`} />}
  {noindex && <meta name="robots" content="noindex" />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(image, Astro.site)} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#15171B" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400&family=Instrument+Sans:wght@400;500;600&family=Courier+Prime:wght@400;700&display=swap" />
  <script is:inline>
    (function () {
      function apply() {
        var t = null;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        document.documentElement.dataset.theme = t === 'light' ? 'light' : 'dark';
      }
      apply();
      document.addEventListener('astro:after-swap', apply);
    })();
  </script>
  <ClientRouter />
</head>
<body>
  <a class="sr skip" href="#main">Skip to content</a>
  <div class="site-wrap">
    <header class="site">
      <a href="/" class="brand" aria-label={`${site.name}, home`}><Logo /><span>{site.name}</span></a>
      <nav class="nav" aria-label={shelf && shelf !== me?.username ? `@${shelf}’s shelf` : 'Your shelf'}>
        {nav.map((n) => <a href={n.href} aria-current={active === n.key ? 'page' : undefined}>{n.label}</a>)}
      </nav>
      <div class="actions">
        {shelf && (
          <button class="iconbtn" data-search-open aria-label="Search this shelf (⌘K)" title="Search  ⌘K">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg>
          </button>
        )}
        <button class="iconbtn" data-theme-toggle aria-label="Switch between light and dark">
          <svg class="theme-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          <svg class="theme-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"/></svg>
        </button>
        {me ? (
          <>
            <a href="/add/" class="btn primary"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>Add</a>
            <details class="menu">
              <summary class="avatar" aria-label="Your account">
                {avatar ? <img src={avatar} alt="" referrerpolicy="no-referrer" /> : <span>{initial(me.display_name || me.username)}</span>}
              </summary>
              <div class="menu-list" role="menu">
                <div class="menu-who"><b>{me.display_name || me.username}</b><span>@{me.username}</span></div>
                <a role="menuitem" href={`/@${me.username}/`}>Your profile</a>
                <a role="menuitem" href={`/@${me.username}/library/`}>Your library</a>
                <a role="menuitem" href="/settings/">Settings</a>
                {me.is_admin && <a role="menuitem" href="/admin/">Reports</a>}
                <form method="post" action="/auth/signout" data-astro-reload><button role="menuitem" type="submit">Sign out</button></form>
              </div>
            </details>
          </>
        ) : (
          <a href={`/signin/?next=${encodeURIComponent(Astro.url.pathname)}`} class="btn primary" data-astro-prefetch="false">Sign in</a>
        )}
      </div>
    </header>
  </div>

  <main id="main">
    <slot />
  </main>

  <div class="foot-wrap">
    <Valley line={line} />
    <footer class="foot">
      <div class="foot-in">
        <span>Made with ❤️ by {site.maker}</span>
        <nav aria-label="Footer"><a href="/about/">About</a><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a>{me ? <a href="/add/">Add something</a> : <a href="/signin/" data-astro-prefetch="false">Sign in</a>}</nav>
      </div>
    </footer>
  </div>

  <dialog class="search" id="search" aria-label="Search the shelf" data-src={shelf ? `/api/search?u=${shelf}` : ""}>
    <div class="search-top">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" style="color:var(--muted)"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg>
      <input type="search" placeholder="Search books, films, essays…" aria-label="Search" autocomplete="off" spellcheck="false" aria-controls="search-list" />
      <kbd>esc</kbd>
    </div>
    <ul class="search-list" id="search-list" role="listbox"></ul>
    <div class="search-foot"><span>↑ ↓ to move</span><span>↵ to open</span><span style="margin-left:auto">⌘K anywhere</span></div>
  </dialog>


  <dialog class="box" id="report-box" aria-labelledby="report-h">
    <form method="dialog" id="report-form">
      <h2 id="report-h">Report</h2>
      <p>Tell us what’s wrong. Reports are private: the person isn’t told who sent one.</p>
      <div class="reasons">
        <label><input type="radio" name="reason" value="spam" required /> Spam or a fake account</label>
        <label><input type="radio" name="reason" value="abuse" /> Harassment or bullying</label>
        <label><input type="radio" name="reason" value="hate" /> Hate</label>
        <label><input type="radio" name="reason" value="sexual" /> Sexual content</label>
        <label><input type="radio" name="reason" value="illegal" /> Something illegal</label>
        <label><input type="radio" name="reason" value="other" /> Something else</label>
      </div>
      <textarea class="field" name="details" rows="3" maxlength="1000" placeholder="Anything that helps (optional)"></textarea>
      <div class="row"><button class="btn" value="cancel" formnovalidate>Cancel</button><button class="btn primary" value="send">Send report</button></div>
    </form>
  </dialog>
  <dialog class="box" id="confirm-box" aria-labelledby="confirm-h">
    <form method="dialog">
      <h2 id="confirm-h"></h2>
      <p id="confirm-p"></p>
      <div class="row"><button class="btn" value="cancel">Cancel</button><button class="btn primary" value="ok" id="confirm-ok">OK</button></div>
    </form>
  </dialog>

  <style>
    .skip:focus { position: fixed !important; left: 12px; top: 12px; width: auto; height: auto; clip: auto; z-index: 99; background: var(--ink); color: var(--bg); padding: 10px 14px; border-radius: 10px; }
  </style>

  <script>
    import { navigate } from 'astro:transitions/client';

    // ——— light / dark ———
    document.addEventListener('click', (ev) => {
      const t = (ev.target as Element).closest('[data-theme-toggle]');
      if (!t) return;
      const root = document.documentElement;
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      const flip = () => { root.dataset.theme = next; try { localStorage.setItem('theme', next); } catch (e) {} };
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      // @ts-ignore
      if (document.startViewTransition && !reduce) document.startViewTransition(flip); else flip();
    });

    // ——— the account menu closes when you click elsewhere or move to another page ———
    document.addEventListener('click', (ev) => {
      document.querySelectorAll<HTMLDetailsElement>('details.menu[open]').forEach((d) => { if (!d.contains(ev.target as Node)) d.open = false; });
    });
    document.addEventListener('astro:after-swap', () => document.querySelectorAll<HTMLDetailsElement>('details.menu[open]').forEach((d) => (d.open = false)));


    // ——— small actions on shelves: status, favourites, quick add, report, block ———
    function toast(msg: string) {
      document.querySelectorAll('.toast').forEach((t) => t.remove());
      const t = document.createElement('div');
      t.className = 'toast'; t.setAttribute('role', 'status'); t.textContent = msg;
      document.body.appendChild(t);
      setTimeout(() => t.remove(), 3200);
    }
    async function send(path: string, method: string, data: unknown) {
      try {
        const r = await fetch(path, { method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
        const j = await r.json().catch(() => ({}));
        if (!r.ok) { toast(j.error || 'That didn’t work. Please try again.'); return null; }
        return j;
      } catch { toast('Couldn’t reach the site. Check your connection.'); return null; }
    }
    function ask(title: string, text: string, ok: string): Promise<boolean> {
      const d = document.getElementById('confirm-box') as HTMLDialogElement;
      d.querySelector('#confirm-h')!.textContent = title;
      d.querySelector('#confirm-p')!.textContent = text;
      d.querySelector('#confirm-ok')!.textContent = ok;
      d.returnValue = '';
      d.showModal();
      return new Promise((done) => d.addEventListener('close', () => done(d.returnValue === 'ok'), { once: true }));
    }
    function reportBox(target: { user: string; log: string | null; who: string }): Promise<{ reason: string; details: string } | null> {
      const d = document.getElementById('report-box') as HTMLDialogElement;
      const f = d.querySelector('form') as HTMLFormElement;
      f.reset();
      d.querySelector('#report-h')!.textContent = target.log ? 'Report this entry' : `Report @${target.who}`;
      d.returnValue = '';
      d.showModal();
      return new Promise((done) => d.addEventListener('close', () => {
        if (d.returnValue !== 'send') return done(null);
        const fd = new FormData(f);
        done({ reason: String(fd.get('reason') || 'other'), details: String(fd.get('details') || '') });
      }, { once: true }));
    }
    const reload = () => navigate(location.pathname + location.search, { history: 'replace' });
    document.addEventListener('click', async (ev) => {
      const el = ev.target as Element;
      const st = el.closest<HTMLButtonElement>('[data-set-status]');
      if (st) {
        const v = JSON.parse(st.dataset.setStatus!);
        if (st.getAttribute('aria-pressed') === 'true') return;
        st.disabled = true;
        if (await send('/api/log', 'PATCH', v)) reload(); else st.disabled = false;
        return;
      }
      const fav = el.closest<HTMLButtonElement>('[data-fav]');
      if (fav) {
        const v = JSON.parse(fav.dataset.fav!);
        const r = await send('/api/favourite', 'POST', v);
        if (r) { toast(v.on ? 'Pinned to your favourites.' : 'Unpinned.'); reload(); }
        return;
      }
      const qa = el.closest<HTMLButtonElement>('[data-quick-add]');
      if (qa) {
        qa.disabled = true;
        const r = await send('/api/log', 'POST', JSON.parse(qa.dataset.quickAdd!));
        if (r) { toast('Added to your shelf.'); reload(); } else qa.disabled = false;
        return;
      }
      const rep = el.closest<HTMLElement>('[data-report]');
      if (rep) {
        rep.closest('details')?.removeAttribute('open');
        const target = JSON.parse(rep.dataset.report!);
        const r = await reportBox(target);
        if (r && await send('/api/report', 'POST', { user: target.user, log: target.log, ...r })) toast('Thanks. Your report was sent.');
        return;
      }
      const bl = el.closest<HTMLElement>('[data-block]');
      if (bl) {
        bl.closest('details')?.removeAttribute('open');
        const v = JSON.parse(bl.dataset.block!);
        if (!v.blocked && !(await ask(`Block @${v.who}?`, 'You won’t see each other’s profiles or shelves. They aren’t told. You can unblock them in Settings.', 'Block'))) return;
        const r = await send('/api/block', v.blocked ? 'DELETE' : 'POST', { id: v.id });
        if (r) { toast(v.blocked ? `Unblocked @${v.who}.` : `Blocked @${v.who}.`); if (!v.blocked) navigate('/'); else reload(); }
      }
    });

    // ——— the paintings stay on the page: no right-click saving, no dragging ———
    const guarded = (t: EventTarget | null) => !!(t as Element)?.closest?.('.art, .valley, .cover, img');
    document.addEventListener('contextmenu', (ev) => { if (guarded(ev.target)) ev.preventDefault(); });
    document.addEventListener('dragstart', (ev) => { if (guarded(ev.target)) ev.preventDefault(); });

    // ——— copy buttons ———
    document.addEventListener('click', async (ev) => {
      const b = (ev.target as Element).closest<HTMLButtonElement>('[data-copy]');
      if (!b) return;
      try { await navigator.clipboard.writeText(b.dataset.copy!); } catch (e) {}
      const label = b.getAttribute('aria-label');
      if (b.classList.contains('copied')) return;
      b.classList.add('copied');
      const old = b.innerHTML;
      // a tick for a moment, like copying in a chat
      if (b.querySelector('svg')) b.innerHTML = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>';
      else b.textContent = 'Copied';
      b.setAttribute('aria-label', 'Copied');
      setTimeout(() => { b.innerHTML = old; b.classList.remove('copied'); if (label) b.setAttribute('aria-label', label); }, 1500);
    });

    // ——— search (⌘K) ———
    type Item = { title: string; creator: string; kind: string; href: string; bg: string; r: string; year: string };
    let items: Item[] | null = null;
    let itemsFrom = '';
    let sel = 0;
    const dialog = () => document.getElementById('search') as HTMLDialogElement;
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
    const hi = (s: string, q: string) => {
      if (!q) return esc(s);
      const i = s.toLowerCase().indexOf(q);
      return i < 0 ? esc(s) : esc(s.slice(0, i)) + '<mark>' + esc(s.slice(i, i + q.length)) + '</mark>' + esc(s.slice(i + q.length));
    };
    async function load() {
      const src = dialog()?.dataset.src || '';
      if (!src) return (items = []);
      if (!items || itemsFrom !== src) { items = await fetch(src).then((r) => r.json()).catch(() => []); itemsFrom = src; }
      return items!;
    }
    function render(q: string) {
      const list = document.getElementById('search-list')!;
      const all = items || [];
      q = q.trim().toLowerCase();
      const found = q
        ? all.filter((x) => (x.title + ' ' + x.creator + ' ' + x.kind + ' ' + x.year).toLowerCase().includes(q)).slice(0, 12)
        : all.slice(0, 6);
      sel = 0;
      if (!found.length) { list.innerHTML = `<li class="search-empty">Nothing called “${esc(q)}” yet.</li>`; return; }
      list.innerHTML = (q ? '' : '<li class="eyebrow" style="padding:8px 12px 4px;font-size:11px">Recently</li>') + found.map((x, i) =>
        `<li><a href="${x.href}" role="option" aria-selected="${i === 0}"><span class="wash sw" style="background:${x.bg};border-radius:${x.r}"></span>` +
        `<span style="display:flex;flex-direction:column;gap:2px;min-width:0"><span class="serif" style="font-size:18px">${hi(x.title, q)}</span>` +
        `<span style="font-size:13px;color:var(--muted)">${hi(x.creator, q)} · ${x.year}</span></span>` +
        `<span class="eyebrow" style="margin-left:auto;font-size:11px">${x.kind}</span></a></li>`).join('');
    }
    function move(d: number) {
      const opts = [...document.querySelectorAll<HTMLElement>('#search-list [role=option]')];
      if (!opts.length) return;
      sel = (sel + d + opts.length) % opts.length;
      opts.forEach((o, i) => o.setAttribute('aria-selected', String(i === sel)));
      opts[sel].scrollIntoView({ block: 'nearest' });
    }
    async function open() {
      const d = dialog();
      if (d.open || !d.dataset.src) return;
      const input = d.querySelector('input')!;
      input.value = '';
      d.showModal();
      await load();
      render('');
      input.focus();
    }
    document.addEventListener('click', (ev) => {
      const el = ev.target as Element;
      if (el.closest('[data-search-open]')) { ev.preventDefault(); open(); return; }
      const d = dialog();
      if (d && d.open) {
        if (el === d) d.close(); // click on the backdrop
        else if (el.closest('#search-list a')) d.close();
      }
    });
    document.addEventListener('keydown', (ev) => {
      const d = dialog();
      if ((ev.metaKey || ev.ctrlKey) && ev.key.toLowerCase() === 'k') { ev.preventDefault(); d.open ? d.close() : open(); return; }
      const typing = (ev.target as Element).closest('input, textarea, [contenteditable]');
      if (ev.key === '/' && !typing && !d.open) { ev.preventDefault(); open(); return; }
      if (!d.open) return;
      if (ev.key === 'ArrowDown') { ev.preventDefault(); move(1); }
      if (ev.key === 'ArrowUp') { ev.preventDefault(); move(-1); }
      if (ev.key === 'Enter') {
        const a = document.querySelector<HTMLAnchorElement>('#search-list [aria-selected="true"]');
        if (a) { ev.preventDefault(); d.close(); navigate(a.getAttribute('href')!); }
      }
    });
    document.addEventListener('input', (ev) => {
      if ((ev.target as Element).closest('#search input')) render((ev.target as HTMLInputElement).value);
    });
  </script>
</body>
</html>
