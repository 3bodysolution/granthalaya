---
// A plain page of words: Privacy and Terms.
import Base from '../layouts/Base.astro';
interface Props { title: string; updated: string; description: string }
const { title, updated, description } = Astro.props;
---
<Base title={title} description={description}>
  <article class="pad policy">
    <p class="eyebrow rise" style="color: var(--lat)">Last updated {updated}</p>
    <h1 class="title rise d1">{title}</h1>
    <div class="body rise d2"><slot /></div>
  </article>
</Base>
<style>
  .policy { max-width: 820px; margin: 0 auto; padding-top: 64px; display: flex; flex-direction: column; gap: 18px; }
  .body { display: flex; flex-direction: column; gap: 14px; margin-top: 10px; }
  .body :global(h2) { margin: 22px 0 0; font-family: Fraunces, Georgia, serif; font-weight: 500; font-size: 24px; line-height: 1.2; }
  .body :global(p), .body :global(li) { margin: 0; font-size: 16.5px; line-height: 1.7; }
  .body :global(ul) { margin: 0; padding-left: 22px; display: flex; flex-direction: column; gap: 6px; }
  .body :global(a) { color: var(--lat); text-decoration: underline; text-underline-offset: 2px; }
  .body :global(.lead) { font-family: Fraunces, Georgia, serif; font-size: 21px; line-height: 1.55; }
  @media (max-width: 780px) { .policy { padding-top: 36px; } }
</style>
