---
// "Your year as a shelf", drawn in code: everything finished in a year stands on one wooden shelf, in date order, January on the left.
// Books are cloth spines in their cover's main colour, films are black video cases with a paper label, shows are wider box sets,
// essays are thin stapled pamphlets. Sizes come from a hash of the title, so they are the same on every visit.
export interface ShelfItem { kind: 'book' | 'film' | 'tv' | 'essay'; title: string; href: string; color: string; seasons?: string }
interface Props { items: ShelfItem[]; year: number }
const { items, year } = Astro.props;

const hash = (s: string) => { let h = 2166136261; for (let i = 0; i < s.length; i++) { h ^= s.charCodeAt(i); h = Math.imul(h, 16777619); } return h >>> 0; };
const lum = (hex: string) => {
  const c = [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16) / 255).map((v) => (v <= 0.03928 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4));
  return 0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2];
};
const ratio = (a: number, b: number) => (Math.max(a, b) + 0.05) / (Math.min(a, b) + 0.05);
const DARK = '#1B1612', LIGHT = '#F6EEDF';
/** dark or light ink, whichever reads better on this colour */
const inkOn = (bg: string) => (ratio(lum(bg), lum(DARK)) >= ratio(lum(bg), lum(LIGHT)) ? DARK : LIGHT);
const darker = (hex: string, f: number) => '#' + [1, 3, 5].map((i) => Math.round(parseInt(hex.slice(i, i + 2), 16) * f).toString(16).padStart(2, '0')).join('');

// three books lie flat in a small stack in some years: the first run of three books side by side, starting somewhere the year picks
type Slot = { one: ShelfItem; i: number } | { stack: ShelfItem[] };
const runs: number[] = [];
for (let i = 0; i + 2 < items.length; i++) if (items[i].kind === 'book' && items[i + 1].kind === 'book' && items[i + 2].kind === 'book') runs.push(i);
const stackAt = year % 3 !== 0 && runs.length ? runs[(year * 7) % runs.length] : -1;
const lastFilm = items.map((x) => x.kind).lastIndexOf('film');
const slots: Slot[] = [];
for (let i = 0; i < items.length; i++) {
  if (i === stackAt) { slots.push({ stack: items.slice(i, i + 3) }); i += 2; } else slots.push({ one: items[i], i });
}
const book = (it: ShelfItem) => { const h = hash(it.title); return { w: 22 + (h % 6) * 3, h: 118 + ((h >> 4) % 6) * 6 }; };
---
{items.length > 0 && (
  <div class="yshelf-wrap" data-yshelf>
    <svg width="0" height="0" aria-hidden="true" focusable="false" style="position:absolute"><symbol id="reel" viewBox="0 0 20 20"><circle cx="10" cy="10" r="8.6" fill="none" stroke="currentColor" stroke-width="1.6" /><circle cx="10" cy="10" r="1.7" fill="currentColor" /><circle cx="10" cy="4.7" r="1.9" fill="currentColor" /><circle cx="14.6" cy="12.6" r="1.9" fill="currentColor" /><circle cx="5.4" cy="12.6" r="1.9" fill="currentColor" /></symbol></svg>
    <ul class="yshelf" role="list" aria-label={`Everything finished in ${year}, in the order it was finished`}>
      <li class="slot"><span class="bookend" aria-hidden="true"></span></li>
      {slots.map((s) => 'stack' in s ? (
        <li class="slot">
          <div class="flatstack">
            {s.stack.map((b) => (
              <a class="flat" href={b.href} data-name={b.title} aria-label={b.title}
                style={`--c:${b.color};--ink:${inkOn(b.color)};--dx:${(hash(b.title) % 9) - 4}px;--len:${96 + (hash(b.title) % 5) * 5}px`}><span class="ft">{b.title}</span></a>
            ))}
          </div>
        </li>
      ) : (
        <li class:list={['slot', s.one.kind === 'film' && s.i === lastFilm && 'leans']}>
          {s.one.kind === 'book' && (() => { const z = book(s.one); return (
            <a class="sp book" href={s.one.href} data-name={s.one.title} aria-label={s.one.title}
              style={`--c:${s.one.color};--ink:${inkOn(s.one.color)};--w:${z.w}px;--h:${z.h}px`}><span class="vt">{s.one.title}</span></a>
          ); })()}
          {s.one.kind === 'film' && (
            <a class="sp film" href={s.one.href} data-name={s.one.title} aria-label={s.one.title}
              style={`--c:${s.one.color};--ink:${inkOn(s.one.color)}`}>
              <span class="lab"><span class="vt">{s.one.title}</span></span>
              <svg class="reel" aria-hidden="true"><use href="#reel" /></svg>
            </a>
          )}
          {s.one.kind === 'tv' && (
            <a class="sp tv" href={s.one.href} data-name={s.one.title} aria-label={s.one.title + (s.one.seasons ? `, ${s.one.seasons}` : '')}
              style={`--c:${darker(s.one.color, 0.8)};--ink:${inkOn(darker(s.one.color, 0.8))}`}>
              <span class="tvk">TV</span><span class="vt">{s.one.title}</span>{s.one.seasons && <span class="tvs">{s.one.seasons}</span>}
            </a>
          )}
          {s.one.kind === 'essay' && (
            <a class="sp essay" href={s.one.href} data-name={s.one.title} aria-label={s.one.title}
              style={`--h:${92 + (hash(s.one.title) % 4) * 5}px`}><span class="staples" aria-hidden="true"></span></a>
          )}
        </li>
      ))}
    </ul>
    <div class="shelf-tip" role="status" aria-live="polite" hidden></div>
  </div>
)}

<style>
  .yshelf-wrap { --rowh: 172px; --plank: 16px; position: relative; width: 100%; max-width: 900px; margin: 0 auto; }
  .yshelf { list-style: none; margin: 0; padding: 0 14px; display: flex; flex-wrap: wrap; align-content: flex-start; align-items: flex-end; column-gap: 2px;
    background-image:
      linear-gradient(to bottom, transparent var(--rowh), #D8B07C var(--rowh), #B98B57 calc(var(--rowh) + 3px), #8E6339 calc(var(--rowh) + 9px), #6B4524 100%);
    background-size: 100% calc(var(--rowh) + var(--plank)); background-repeat: repeat-y; }
  .slot { height: calc(var(--rowh) + var(--plank)); padding-bottom: var(--plank); display: flex; align-items: flex-end; flex: none; }
  .slot.leans { margin-right: 16px; }
  .sp, .flat { position: relative; display: block; color: var(--ink); text-decoration: none; transition: transform .2s ease; -webkit-tap-highlight-color: transparent; }
  .sp:hover, .sp:focus-visible, .flat:hover, .flat:focus-visible { transform: translateY(-5px); }
  .sp:focus-visible, .flat:focus-visible { outline: 2px solid var(--lat); outline-offset: 2px; }
  .leans .sp { transform-origin: 0 100%; transform: rotate(5deg); }
  .leans .sp:hover, .leans .sp:focus-visible { transform: rotate(5deg) translateY(-5px); }
  .vt { writing-mode: vertical-rl; transform: rotate(180deg); display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  /* a brass bookend at the start */
  .bookend { display: block; width: 26px; height: 92px; margin-right: 4px; background:
      linear-gradient(90deg, #E8CB82, #B88A2E 60%, #8C6620) left bottom / 7px 100% no-repeat,
      linear-gradient(180deg, #E8CB82, #A87B25) left bottom / 100% 7px no-repeat; border-radius: 2px 2px 1px 1px; box-shadow: 1px 1px 3px rgba(0, 0, 0, .3); }

  /* a book: cloth in the cover's colour, two bands, the paper-tooth texture over it, the title running up the spine */
  .book { width: var(--w); height: var(--h); background:
      linear-gradient(90deg, rgba(0, 0, 0, .28), rgba(255, 255, 255, .1) 20%, transparent 55%, rgba(0, 0, 0, .22)),
      linear-gradient(to bottom, transparent 9px, rgba(255, 255, 255, .34) 9px 10px, transparent 10px calc(100% - 10px), rgba(255, 255, 255, .34) calc(100% - 10px) calc(100% - 9px), transparent calc(100% - 9px)),
      var(--c); border-radius: 2px 2px 1px 1px; box-shadow: 1px 0 2px rgba(0, 0, 0, .25); padding: 14px 0; display: flex; justify-content: center; }
  .book::after { content: ''; position: absolute; inset: 0; background: url(/img/paper-tooth.webp) center / 90px; mix-blend-mode: multiply; opacity: .22; pointer-events: none; border-radius: inherit; }
  .book .vt { font-family: 'Fraunces Fix', Fraunces, Georgia, serif; font-size: 11.5px; line-height: 1.1; max-height: 100%; }

  /* a video case: black plastic with ridged ends, a paper label in the poster's colour, a reel at the bottom */
  .film { width: 24px; height: 140px; background: linear-gradient(90deg, #0d0e10, #232529 30%, #17181b 70%, #0b0b0d); border-radius: 2px; box-shadow: 1px 0 2px rgba(0, 0, 0, .35); }
  .film::before { content: ''; position: absolute; inset: 0; border-radius: inherit; pointer-events: none;
    background: repeating-linear-gradient(to bottom, rgba(255, 255, 255, .13) 0 1px, transparent 1px 3px) top / 100% 11px no-repeat, repeating-linear-gradient(to bottom, rgba(255, 255, 255, .13) 0 1px, transparent 1px 3px) bottom / 100% 11px no-repeat; }
  .film .lab { position: absolute; left: 3px; right: 3px; top: 13px; bottom: 25px; background: var(--c); color: var(--ink); display: flex; justify-content: center; padding: 4px 0; overflow: hidden; }
  .film .lab::after { content: ''; position: absolute; inset: 0; background: url(/img/paper-tooth.webp) center / 90px; mix-blend-mode: multiply; opacity: .2; }
  .film .vt { font-family: 'Instrument Sans', system-ui, sans-serif; font-variant-caps: all-small-caps; letter-spacing: .07em; font-size: 10.5px; font-weight: 600; line-height: 1.1; position: relative; z-index: 1; max-height: 100%; }
  .film .reel { position: absolute; left: 50%; bottom: 6px; width: 14px; height: 14px; margin-left: -7px; color: #9a9ca3; }

  /* a box set: wider, "TV" at the top, the title up the middle, the seasons at the bottom */
  .tv { width: 40px; height: 150px; background: linear-gradient(90deg, rgba(0, 0, 0, .3), rgba(255, 255, 255, .08) 25%, transparent 60%, rgba(0, 0, 0, .25)), var(--c); border-radius: 2px; box-shadow: 1px 0 2px rgba(0, 0, 0, .3);
    border-top: 3px solid rgba(255, 255, 255, .25); border-bottom: 3px solid rgba(0, 0, 0, .25); display: flex; flex-direction: column; align-items: center; padding: 6px 0 5px; gap: 5px; box-sizing: border-box; }
  .tv::after { content: ''; position: absolute; inset: 0; background: url(/img/paper-tooth.webp) center / 90px; mix-blend-mode: multiply; opacity: .18; pointer-events: none; }
  .tvk { font-size: 10px; font-weight: 700; letter-spacing: .16em; padding-left: .16em; }
  .tv .vt { flex: 1 1 0; min-height: 0; font-family: 'Fraunces Fix', Fraunces, Georgia, serif; font-size: 12px; line-height: 1.1; }
  .tvs { font-size: 9.5px; font-weight: 600; font-variant-numeric: tabular-nums; white-space: nowrap; }

  /* an essay: a thin stapled pamphlet on pale paper */
  .essay { width: 9px; height: var(--h); background: linear-gradient(90deg, #cfc6b1, #efe8d6 40%, #e4dcc6); border-radius: 1px; box-shadow: 1px 0 1px rgba(0, 0, 0, .22); }
  .staples { position: absolute; left: 1.5px; top: 0; bottom: 0; width: 3px; background:
      linear-gradient(#6e7076, #6e7076) 0 24% / 100% 1.5px no-repeat, linear-gradient(#6e7076, #6e7076) 0 72% / 100% 1.5px no-repeat; }

  /* three books lying flat */
  .flatstack { display: flex; flex-direction: column-reverse; align-items: flex-start; margin: 0 6px; }
  .flat { height: 21px; width: var(--len); margin-left: var(--dx); background:
      linear-gradient(to bottom, rgba(255, 255, 255, .22), transparent 40%, rgba(0, 0, 0, .25)), var(--c); border-radius: 2px 1px 1px 2px; box-shadow: 1px 1px 2px rgba(0, 0, 0, .3), inset -6px 0 0 #EDE3CC; display: flex; align-items: center; padding: 0 12px 0 8px; box-sizing: border-box; }
  .flat::after { content: ''; position: absolute; inset: 0; background: url(/img/paper-tooth.webp) center / 90px; mix-blend-mode: multiply; opacity: .2; pointer-events: none; }
  .ft { font-family: 'Fraunces Fix', Fraunces, Georgia, serif; font-size: 10.5px; line-height: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; position: relative; z-index: 1; }

  .shelf-tip { position: absolute; z-index: 5; max-width: 240px; padding: 6px 10px; border-radius: 8px; background: var(--ink); color: var(--bg); font-size: 12.5px; font-weight: 600; line-height: 1.25; pointer-events: none; transform: translate(-50%, -100%); box-shadow: 0 6px 16px -6px var(--shadow); }
  .shelf-tip[hidden] { display: none; }
  @media (max-width: 780px) { .yshelf { padding: 0 6px; } }
  @media (prefers-reduced-motion: reduce) { .sp, .flat { transition: none; } .sp:hover, .flat:hover, .sp:focus-visible, .flat:focus-visible { transform: none; } .leans .sp:hover { transform: rotate(5deg); } }
</style>

<script>
  // the title shows when a spine is pointed at or focused; on a touch screen the first tap shows it and the second opens the page
  function start() {
    document.querySelectorAll<HTMLElement>('[data-yshelf]').forEach((wrap) => {
      if (wrap.dataset.ready) return;
      wrap.dataset.ready = '1';
      const tip = wrap.querySelector<HTMLElement>('.shelf-tip')!;
      let shown: HTMLElement | null = null;
      const show = (a: HTMLElement) => {
        const w = wrap.getBoundingClientRect(), r = a.getBoundingClientRect();
        tip.textContent = a.dataset.name ?? '';
        tip.hidden = false;
        const half = tip.offsetWidth / 2;
        tip.style.left = Math.min(w.width - half, Math.max(half, r.left - w.left + r.width / 2)) + 'px';
        tip.style.top = Math.max(0, r.top - w.top - 8) + 'px';
        shown = a;
      };
      const hide = () => { tip.hidden = true; shown = null; };
      const item = (e: Event) => (e.target as Element).closest<HTMLElement>('.sp, .flat');
      wrap.addEventListener('pointerover', (e) => { const a = item(e); if (a && (e as PointerEvent).pointerType === 'mouse') show(a); });
      wrap.addEventListener('pointerout', (e) => { if ((e as PointerEvent).pointerType === 'mouse' && !item(e)?.contains(e.relatedTarget as Node)) hide(); });
      wrap.addEventListener('focusin', (e) => { const a = item(e); if (a) show(a); });
      wrap.addEventListener('focusout', hide);
      wrap.addEventListener('click', (e) => {
        const a = item(e);
        if (!a) { hide(); return; }
        if ((e as PointerEvent).pointerType === 'touch' && shown !== a) { e.preventDefault(); show(a); }
      });
      document.addEventListener('click', (e) => { if (!wrap.contains(e.target as Node)) hide(); });
    });
  }
  document.addEventListener('astro:page-load', start);
</script>
