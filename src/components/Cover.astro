---
// A cover: the real book cover or film poster when there is one (see coverSrc), otherwise one painted from the title.
// Every cover is a 2:3 frame and the picture fills it (object-fit: cover): no mat, no border, only the hairline outline from
// global.css. A painted placeholder is for a title that truly has no cover.
// variant: tile (library grid) | poster | mini (Sits well next to, favourites) | swatch (small thumbnails, sized by w and h)
import { palette, radius, kind, excerpt, coverSrc, type Entry } from '../lib/data';

interface Props {
  entry: Entry;
  variant?: 'tile' | 'poster' | 'mini' | 'swatch';
  n?: string;
  w?: number;
  h?: number;
  vt?: boolean; // give it a view-transition name so it flies into the entry page
}
const { entry, variant = 'tile', n, w = 34, h = 48, vt = false } = Astro.props;
const p = palette(entry);
const d = entry.data;
const vars = `--c-bg:${p.bg};--c-accent:${p.accent};--c-hill:${p.hill};--c-r:${radius(entry)}`;
const tname = vt ? `cover-${entry.id.replace(/[^a-z0-9-]/gi, '')}` : undefined;
const src = coverSrc(entry);
const isEssay = d.type === 'essay';
---
{variant === 'tile' && isEssay ? (
  <div class="essay" transition:name={tname}>
    <span class="type src">{(d.source ?? d.creator).toUpperCase()}</span>
    <span class="serif et">{d.title}</span>
    <span class="serif ex">{excerpt(entry, 96)}</span>
    <span class="go">{d.status === 'want' ? 'Saved for later ↗' : 'Review + link ↗'}</span>
  </div>
) : (
  <span class:list={['cv', variant, src ? 'real' : 'wash']} style={variant === 'swatch' ? `${vars};width:${w}px;height:${h}px` : vars} transition:name={tname} aria-hidden={variant === 'swatch' ? 'true' : undefined}>
    {src && <img class="pic" src={src} alt="" loading="lazy" decoding="async" draggable="false" referrerpolicy="no-referrer" onerror="this.closest('.real')?.classList.replace('real','wash');this.remove()" />}
    {variant !== 'swatch' && <><i class="sun" /><i class="hill" /></>}
    {variant === 'poster' && <span class="serif pn">{n}</span>}
    {variant !== 'swatch' && (
      <span class="tt">
        <span class="serif">{d.title}</span>
        {variant === 'tile' && d.creator && <span class="by">{d.creator}</span>}
      </span>
    )}
  </span>
)}

<style>
  /* the frame: 2:3, the picture fills it. (A rule like `.cv > *` that makes children position: relative would pull the picture
     back into the flow and leave a coloured mat around it: the picture is always absolutely placed.) */
  .cv { position: relative; display: block; overflow: hidden; background: var(--c-bg); border-radius: var(--c-r); color: #F6EEDF; box-shadow: 0 10px 16px -12px var(--shadow); }
  .tile, .poster, .mini { width: 100%; aspect-ratio: 2 / 3; }
  .sw { flex-shrink: 0; }
  .pic { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center; display: block; -webkit-user-select: none; user-select: none; }

  /* the painted placeholder (no cover at all) */
  .sun, .hill { position: absolute; display: block; }
  .sun { width: 56%; aspect-ratio: 1; border-radius: 50%; right: -12%; top: 22%; background: var(--c-accent); opacity: .78; }
  .hill { left: -20%; width: 140%; bottom: -8px; height: 32%; border-radius: 50% 50% 0 0; background: var(--c-hill); }
  .tt { position: absolute; left: 12px; right: 12px; bottom: 12px; display: flex; flex-direction: column; gap: 4px; }
  .tt .serif { font-size: 18px; line-height: 1.12; overflow-wrap: anywhere; }
  .mini .tt .serif { font-size: 15px; }
  .by { font-size: 11px; opacity: .85; }
  .pn { position: absolute; left: 14px; top: 12px; font-size: 40px; line-height: 1; opacity: .9; }
  .real > :not(.pic) { display: none; }

  .essay { height: 250px; background: var(--card); padding: 20px 16px; display: flex; flex-direction: column; gap: 10px; border: 1px solid var(--line); border-top: 4px solid var(--sky); border-radius: 6px; box-shadow: 0 14px 22px -10px var(--shadow); overflow: hidden; }
  .src { font-size: 11px; letter-spacing: .08em; color: var(--sky); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .et { font-size: 20px; line-height: 1.15; }
  .ex { font-size: 13px; line-height: 1.5; color: var(--muted); overflow: hidden; display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; }
  .go { margin-top: auto; font-size: 12px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: var(--lat); }
  @media (max-width: 780px) { .essay { height: 230px; } }
</style>
