---
// The top of the home page: a wall of film posters and book covers (picked once a day, /api/wall) with the words on the left.
// The words and the button are plain HTML and show at once; the wall is filled in afterwards by the script below and fades in as
// each picture arrives. If it can't be filled, the hero is a plain background.
interface Props { mine?: boolean }
const { mine = false } = Astro.props;
// On a phone the words are either above the wall (the default, it reads better) or on a stronger fade over it: add ?wall=fade to look at that one.
const phone = Astro.url.searchParams.get('wall') === 'fade' ? 'fade' : 'above';
---
<section class:list={['hero bleed', { mine }]} data-wall data-phone={phone}>
  <div class="stage">
    <div class="wall" aria-hidden="true"><div class="drift" data-wall-drift></div></div>
    <div class="veil" aria-hidden="true"></div>
    <div class="pad words">
      <slot />
    </div>
  </div>
  <p class="credit pad" data-wall-credit hidden>Covers from Akshardhara and BookGanga, with their permission.</p>
</section>

<style>
  /* tile size follows the width of the window; a poster is 2 by 3 */
  .hero { --tw: clamp(84px, 6.4vw, 104px); --th: calc(var(--tw) * 1.5); --gap: 6px; --rows: 4; --drift: 200px; --wallh: calc(var(--rows) * var(--th) + (var(--rows) - 1) * var(--gap)); }
  .stage { position: relative; overflow: hidden; min-height: var(--wallh); display: flex; align-items: center; }
  .wall { position: absolute; inset: 0; overflow: hidden; }
  .drift { display: flex; flex-direction: column; gap: var(--gap); width: max-content; will-change: transform; animation: drift 90s ease-in-out infinite alternate; }
  .drift :global(.wr) { display: flex; gap: var(--gap); }
  /* bricks: every other row is moved along by half a tile */
  .drift :global(.wr:nth-child(even)) { margin-left: calc((var(--tw) + var(--gap)) / 2); }
  .drift :global(.wt) { flex: none; width: var(--tw); height: var(--th); border-radius: 6px; overflow: hidden; background: var(--soft); box-shadow: 0 0 0 1px color-mix(in srgb, var(--ink) 12%, transparent) inset; }
  .drift :global(.wt.book) { border-radius: 2px 6px 6px 2px; }
  .drift :global(.wt img) { display: block; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity .7s ease; }
  .drift :global(.wt img.in) { opacity: 1; }
  @keyframes drift { from { transform: translate3d(0, 0, 0); } to { transform: translate3d(calc(var(--drift) * -1), 0, 0); } }
  @media (prefers-reduced-motion: reduce) {
    .drift { animation: none; }
    .drift :global(.wt img) { transition: none; }
  }

  /* the page's own colour over the left of the wall, so the words are easy to read (dark in dark mode, light in light mode) */
  .veil { position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(90deg, var(--bg) 0, color-mix(in srgb, var(--bg) 94%, transparent) 40%, color-mix(in srgb, var(--bg) 70%, transparent) 54%, color-mix(in srgb, var(--bg) 22%, transparent) 70%, transparent 86%); }
  .words { position: relative; width: 100%; max-width: var(--max); margin: 0 auto; box-sizing: border-box; display: flex; flex-direction: column; align-items: flex-start; gap: 16px; text-align: left; padding-top: 40px; padding-bottom: 40px; }
  .words > :global(*) { max-width: min(560px, 100%); }
  .words :global(.title) { color: var(--ink); }
  .words :global(.sub) { margin: 0; font-size: 18px; line-height: 1.5; color: var(--ink); }
  .words :global(.cta) { width: 100%; max-width: 320px; margin-top: 8px; }
  .words :global(.free) { font-size: 13px; color: var(--ink); }
  /* the credit sits under the wall, never over a picture */
  .credit { margin: 0 auto; max-width: var(--max); box-sizing: border-box; padding-top: 8px; padding-bottom: 4px; text-align: right; font-size: 12px; line-height: 1.4; color: var(--ink); }
  .credit[hidden] { display: none; }

  /* a phone: three rows, the words above the wall on the page's own colour */
  @media (max-width: 780px) {
    .hero { --tw: 76px; --rows: 3; --drift: 120px; }
    .stage { display: flex; flex-direction: column; align-items: stretch; min-height: 0; }
    .words { padding-top: 28px; padding-bottom: 24px; }
    .words :global(.cta) { max-width: none; }
    .wall { position: relative; inset: auto; order: 1; height: var(--wallh); }
    .veil { display: none; }
    .hero[data-empty] .wall { display: none; }
    .credit { text-align: left; }
    /* the other choice: the words over the top of the wall, on a fade that is strongest at the top */
    .hero[data-phone="fade"] .stage { flex-direction: row; align-items: flex-start; min-height: calc(var(--wallh) + 170px); }
    .hero[data-phone="fade"] .wall { position: absolute; inset: auto 0 0 0; }
    .hero[data-phone="fade"] .veil { display: block; background: linear-gradient(180deg, var(--bg) 0, color-mix(in srgb, var(--bg) 94%, transparent) 62%, color-mix(in srgb, var(--bg) 45%, transparent) 100%); }
    .hero[data-phone="fade"] .words { padding-bottom: 0; }
  }
</style>

<script>
  // Fill the wall once the page is quiet. Tiles are made for this window's width (plus the drift); a wider window later adds more.
  type Tile = ['f' | 'b', string, string | null];
  let tiles: Tile[] | null = null;
  let asked: Promise<Tile[]> | null = null;
  const load = () => (asked ??= fetch('/api/wall').then((r) => (r.ok ? r.json() : { tiles: [] })).then((j) => (tiles = j.tiles ?? [])).catch(() => (tiles = [])));

  function fill(hero: HTMLElement) {
    const drift = hero.querySelector<HTMLElement>('[data-wall-drift]');
    if (!drift || !tiles?.length) return;
    const css = getComputedStyle(hero);
    const rowsN = Number(css.getPropertyValue('--rows')) || 4;
    const probe = document.createElement('span');
    probe.className = 'wt';
    drift.append(probe);
    const step = probe.getBoundingClientRect().width + (parseFloat(getComputedStyle(drift).rowGap) || 6);
    probe.remove();
    const cols = Math.ceil((innerWidth + parseFloat(css.getPropertyValue('--drift')) + step / 2) / step) + 1;
    const key = rowsN + 'x' + cols;
    if (drift.dataset.built === key || (drift.dataset.built && drift.dataset.built.startsWith(rowsN + 'x') && Number(drift.dataset.built.split('x')[1]) >= cols)) return;
    drift.dataset.built = key;
    const n = tiles.length, shift = Math.floor(n / rowsN);
    const frag = document.createDocumentFragment();
    for (let r = 0; r < rowsN; r++) {
      const row = document.createElement('div');
      row.className = 'wr';
      for (let c = 0; c < cols; c++) {
        const [kind, src, srcset] = tiles[(c + r * shift) % n];
        const t = document.createElement('span');
        t.className = kind === 'b' ? 'wt book' : 'wt';
        const img = new Image();
        img.alt = '';
        img.decoding = 'async';
        img.loading = 'lazy';
        if (srcset) img.srcset = srcset;
        img.src = src;
        const show = () => img.classList.add('in');
        img.addEventListener('load', show, { once: true });
        img.addEventListener('error', () => t.remove(), { once: true });
        t.append(img);
        row.append(t);
      }
      frag.append(row);
    }
    drift.replaceChildren(frag);
    hero.querySelector<HTMLElement>('[data-wall-credit]')!.hidden = !tiles.some((t) => t[0] === 'b');
  }

  function start() {
    const hero = document.querySelector<HTMLElement>('[data-wall]');
    if (!hero) return;
    const go = () => load().then(() => { if (!document.contains(hero)) return; if (tiles?.length) fill(hero); else hero.dataset.empty = ''; });
    if ('requestIdleCallback' in window) requestIdleCallback(go, { timeout: 2000 });
    else setTimeout(go, 300);
  }
  let timer: number | undefined;
  addEventListener('resize', () => {
    clearTimeout(timer);
    timer = window.setTimeout(() => { const hero = document.querySelector<HTMLElement>('[data-wall]'); if (hero && tiles) fill(hero); }, 250);
  });
  document.addEventListener('astro:page-load', start);
</script>
