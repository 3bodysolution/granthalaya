---
// The share window. Any button with `data-share` opens it. A bottom sheet on a phone, a small dialog on a computer.
// Top: the card that will be shared (a half-size preview; the full-size picture is fetched for sharing and saving).
// Below: one row of round app buttons. The card starts drawing as soon as Share is pressed (or hovered with a mouse), and the
// full-size picture is kept as a File so the phone's share sheet can be opened straight from the tap.
// A card that takes longer than about 8 seconds stops the loader and offers Retry.
import { siInstagram, siWhatsapp, siX } from 'simple-icons';
import Link from '@tabler/icons/outline/link.svg';
import Download from '@tabler/icons/outline/download.svg';
import Dots from '@tabler/icons/outline/dots.svg';
const brand = (i: { path: string; hex: string }) => ({ path: i.path, color: `#${i.hex}` });
const apps = { ig: brand(siInstagram), wa: brand(siWhatsapp), x: brand(siX) };
---
<dialog class="sheet" id="share-box" aria-label="Share">
  <div class="sh-in">
    <div class="sh-grab" id="sh-grab" aria-hidden="true"><i></i></div>
    <div class="sh-stage" id="sh-stage" data-wide="0" data-state="busy">
      <img id="sh-img" alt="The card you are sharing" draggable="false" />
      <div class="sh-fail" id="sh-fail" hidden><span>Couldn’t draw the card</span><button class="btn" type="button" id="sh-retry">Retry</button></div>
      <span class="sh-bar" aria-hidden="true"></span>
    </div>
    <div class="sh-apps">
      <button class="sh-app" type="button" id="sh-ig"><span class="ic" style={`background:${apps.ig.color}`}><svg viewBox="0 0 24 24" aria-hidden="true"><path d={apps.ig.path} /></svg></span><span>Instagram</span></button>
      <a class="sh-app" id="sh-wa" target="_blank" rel="noopener" aria-disabled="true"><span class="ic" style={`background:${apps.wa.color}`}><svg viewBox="0 0 24 24" aria-hidden="true"><path d={apps.wa.path} /></svg></span><span>WhatsApp</span></a>
      <a class="sh-app" id="sh-x" target="_blank" rel="noopener" aria-disabled="true"><span class="ic x" style={`background:${apps.x.color}`}><svg viewBox="0 0 24 24" aria-hidden="true"><path d={apps.x.path} /></svg></span><span>X</span></a>
      <button class="sh-app" type="button" id="sh-copy"><span class="ic plain"><Link aria-hidden="true" /></span><span>Copy link</span></button>
      <button class="sh-app" type="button" id="sh-save"><span class="ic plain"><Download aria-hidden="true" /></span><span>Save image</span></button>
      <button class="sh-app" type="button" id="sh-more" hidden><span class="ic plain"><Dots aria-hidden="true" /></span><span>More</span></button>
    </div>
    <div class="sh-toast" id="sh-toast" role="status" aria-live="polite"></div>
  </div>
</dialog>

<style is:global>
  dialog.sheet { padding: 0; border: 1px solid var(--line); background: var(--card); color: var(--ink); overflow: hidden;
    width: min(420px, calc(100vw - 32px)); max-height: calc(100dvh - 32px); border-radius: 22px; box-shadow: 0 30px 60px -20px var(--shadow); }
  dialog.sheet::backdrop { background: var(--scrim); }
  dialog.sheet[open] { animation: pop .22s var(--spring); }
  dialog.sheet[open]::backdrop { animation: fade .2s ease; }
  .sh-in { position: relative; padding: 18px 16px 18px; }
  .sh-grab { display: none; justify-content: center; padding: 0 0 10px; touch-action: none; }
  .sh-grab i { width: 38px; height: 4px; border-radius: 2px; background: var(--line); }

  /* the card */
  .sh-stage { position: relative; height: min(52dvh, 430px); margin-bottom: 16px; border-radius: 14px; overflow: hidden; background: var(--soft); display: grid; place-items: center; padding: 12px; box-sizing: border-box; grid-template-rows: minmax(0, 1fr); }
  .sh-stage[data-wide="1"] { height: 230px; }
  .sh-stage img { display: block; max-width: 100%; width: auto; height: 100%; object-fit: contain; min-height: 0; border-radius: 8px; -webkit-user-drag: none; user-select: none; opacity: 0; transition: opacity .3s ease; }
  .sh-stage img:not([src]) { visibility: hidden; }
  .sh-stage[data-state="ready"] img { opacity: 1; }
  .sh-fail { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; font-size: 14px; color: var(--muted); }
  .sh-fail[hidden] { display: none; }
  .sh-fail .btn { height: 38px; }

  /* while a card is drawing: a thin glowing teal line moves along the bottom edge of the card area */
  .sh-bar { position: absolute; left: 0; right: 0; bottom: 0; height: 3px; overflow: hidden; opacity: 0; transition: opacity .2s ease; pointer-events: none; }
  .sh-bar::before { content: ''; position: absolute; top: 0; bottom: 0; width: 38%; left: -38%; border-radius: 2px; background: linear-gradient(90deg, transparent, var(--lat), transparent); box-shadow: 0 0 12px 1px var(--lat); animation: shbar 1.3s ease-in-out infinite; }
  .sh-stage[data-state="busy"] .sh-bar { opacity: 1; }
  @keyframes shbar { to { left: 100%; } }
  @media (prefers-reduced-motion: reduce) {
    .sh-bar::before { animation: none; left: 0; width: 100%; background: var(--lat); box-shadow: 0 0 8px var(--lat); }
    .sh-stage img { transition: none; }
    dialog.sheet[open], dialog.sheet[open]::backdrop { animation: none; }
  }

  /* one row of round app buttons */
  .sh-apps { display: flex; justify-content: space-between; gap: 4px; }
  .sh-app { flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; align-items: center; gap: 7px; padding: 4px 0; border: 0; background: transparent; color: var(--ink); font: inherit; font-size: 11.5px; line-height: 1.2; text-align: center; text-decoration: none; cursor: pointer; transition: transform .2s ease, opacity .2s ease; }
  .sh-app[hidden] { display: none; }
  .sh-app:active { transform: scale(.94); }
  .sh-app:focus-visible { outline: 2px solid var(--lat); outline-offset: 2px; border-radius: 12px; }
  .sh-app[aria-disabled="true"] { opacity: .5; }
  .sh-app .ic { display: grid; place-items: center; width: 54px; height: 54px; border-radius: 50%; transition: transform .2s ease, box-shadow .2s ease; }
  .sh-app:hover .ic { transform: translateY(-2px); }
  .sh-app .ic svg { width: 26px; height: 26px; fill: #fff; }
  .sh-app .ic.x { box-shadow: inset 0 0 0 1px rgba(255,255,255,.22); }
  .sh-app .ic.plain { background: var(--soft); border: 1px solid var(--line); color: var(--ink); }
  .sh-app .ic.plain svg { fill: none; stroke: currentColor; width: 24px; height: 24px; }

  .sh-toast { position: absolute; left: 50%; bottom: 100px; translate: -50% 6px; padding: 9px 16px; border-radius: 999px; background: var(--ink); color: var(--bg); font-size: 13.5px; font-weight: 500; white-space: nowrap; opacity: 0; pointer-events: none; transition: opacity .18s ease, translate .18s ease; }
  .sh-toast.on { opacity: 1; translate: -50% 0; }

  /* on a phone it is a sheet that slides up from the bottom */
  @media (max-width: 640px) {
    dialog.sheet { width: 100%; max-width: none; margin: auto 0 0; border-radius: 22px 22px 0 0; border-width: 1px 0 0; max-height: 94dvh; }
    dialog.sheet[open] { animation: sheetup .3s cubic-bezier(.2, .8, .2, 1); }
    .sh-in { padding: 8px 16px calc(18px + env(safe-area-inset-bottom)); }
    .sh-grab { display: flex; padding-top: 4px; }
    .sh-toast { bottom: calc(100px + env(safe-area-inset-bottom)); }
  }
  @keyframes sheetup { from { transform: translateY(100%); } }
</style>

<script>
  // A button with data-share carries JSON: { title, ref?, card?, wide?, stories? }
  //   ref      what /api/share asks about: "title=film:123-name", "entry=user/slug", "year=user/2026", "col=<id>"
  //   card     the card's address (the link preview, or the year card)
  //   stories  { key: { user, slug } } your entries on this page; the visible season's key is used on TV pages
  type Stories = Record<string, { user: string; slug: string }>;
  type Opts = { title: string; ref?: string; card?: string; wide?: boolean; stories?: Stories };
  type Meta = { link: string; text: string };
  type Job = {
    key: string; base: string; wide: boolean; at: number;
    meta: Promise<Meta | null>;          // the card never waits for this
    preview: Promise<Blob | null>;       // the half-size picture shown in the window
    full?: Promise<File | null>;         // the full-size picture, fetched for sharing and saving
    file?: File;
  };

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const mouse = () => matchMedia('(hover: hover) and (pointer: fine)').matches;
  const phone = () => typeof navigator.share === 'function' && (matchMedia('(pointer: coarse)').matches || /Android|iPhone|iPad|iPod/i.test(navigator.userAgent));
  const LIMIT = 8000;                     // a card slower than this stops the loader and offers Retry

  const warm = new Map<string, Job>();    // started by a hover or a press, reused when the window opens
  let job: Job | null = null;
  let opts: Opts | null = null;
  let epoch = 0;                          // a newer opening cancels the older one's updates

  const half = (base: string, wide: boolean) => (wide ? base : `${base}${base.includes('?') ? '&' : '?'}w=540`);
  const fileName = (b: Blob) => `granthalaya-${(opts?.title ?? 'card').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '') || 'card'}.${b.type === 'image/png' ? 'png' : 'jpg'}`;

  /** fetch a card picture, giving up after `ms` */
  async function draw(address: string, ms: number): Promise<Blob | null> {
    const ctl = new AbortController();
    const timer = setTimeout(() => ctl.abort(), ms);
    try {
      const r = await fetch(address, { credentials: 'same-origin', signal: ctl.signal });
      if (!r.ok) return null;
      const b = await r.blob();
      return b.type.startsWith('image/') ? b : new Blob([b], { type: 'image/jpeg' });   // a File for the phone's share sheet must say what it is
    } catch { return null; } finally { clearTimeout(timer); }
  }

  /** what to draw and ask for: your own entry's story card, else the page's own card */
  function plan(o: Opts): { key: string; base: string; ref: string; wide: boolean } | null {
    const keys = Object.keys(o.stories ?? {});
    const pick = document.querySelector<HTMLSelectElement>('[data-season-pick]')?.value;
    const mine = o.stories?.[pick && o.stories[pick] ? pick : keys[0]];
    if (mine) return { key: `entry:${mine.user}/${mine.slug}`, base: `/@${mine.user}/library/${mine.slug}/story.png`, ref: `entry=${mine.user}/${mine.slug}`, wide: false };
    if (o.card) return { key: `${o.ref ?? ''}|${o.card}`, base: o.card, ref: o.ref ?? '', wide: !!o.wide };
    return null;
  }

  /** start drawing the card and asking for its link and text; used by a hover, a press and the window itself */
  function start(o: Opts, fresh = false): Job | null {
    const p = plan(o);
    if (!p) return null;
    const old = warm.get(p.key);
    if (old && !fresh && Date.now() - old.at < 60_000) return old;
    const meta: Promise<Meta | null> = p.ref
      ? Promise.race([
        fetch(`/api/share?${p.ref}`, { credentials: 'same-origin' }).then((r) => (r.ok ? (r.json() as Promise<Meta>) : null)),
        new Promise<null>((res) => setTimeout(() => res(null), 6000)),
      ]).catch(() => null)
      : Promise.resolve(null);
    const j: Job = { key: p.key, base: p.base, wide: p.wide, meta, preview: draw(half(p.base, p.wide), LIMIT), at: Date.now() };
    warm.set(p.key, j);
    if (warm.size > 8) warm.delete(warm.keys().next().value!);
    return j;
  }

  /** the full-size picture as a File, started once the preview is shown (or at once if sharing is pressed first) */
  function fullOf(j: Job): Promise<File | null> {
    if (!j.full) {
      j.full = (j.wide ? j.preview : draw(j.base, 20000)).then((b) => {
        if (!b) return null;
        j.file = new File([b], fileName(b), { type: b.type });
        return j.file;
      });
    }
    return j.full;
  }

  /* ——— the window ——— */
  const toastTimer: { t?: ReturnType<typeof setTimeout> } = {};
  function say(msg: string) {
    const t = $('sh-toast');
    t.textContent = msg; t.classList.add('on');
    clearTimeout(toastTimer.t); toastTimer.t = setTimeout(() => t.classList.remove('on'), 2200);
  }
  const state = (s: 'busy' | 'ready' | 'failed') => { $('sh-stage').dataset.state = s; $('sh-fail').hidden = s !== 'failed'; };

  function show(j: Job, n: number) {
    state('busy');
    void j.preview.then((b) => {
      if (n !== epoch) return;
      if (!b) { state('failed'); return; }
      const img = $<HTMLImageElement>('sh-img');
      img.src = URL.createObjectURL(b);
      void img.decode().catch(() => {}).then(() => { if (n === epoch) state('ready'); });
      void fullOf(j);                     // the picture to share, while the person looks at the preview
    });
  }

  async function open(o: Opts) {
    const dlg = $<HTMLDialogElement>('share-box');
    const j = start(o);
    if (!j) {   // nothing to draw: just copy the page's address
      try { await navigator.clipboard.writeText(location.href); } catch { /* nothing to do */ }
      return;
    }
    opts = o; job = j; epoch++;
    const n = epoch;
    $('sh-stage').dataset.wide = j.wide ? '1' : '0';
    $<HTMLImageElement>('sh-img').removeAttribute('src');
    $('sh-more').hidden = !phone();
    const wa = $<HTMLAnchorElement>('sh-wa'), x = $<HTMLAnchorElement>('sh-x');
    for (const a of [wa, x]) { a.removeAttribute('href'); a.setAttribute('aria-disabled', 'true'); }
    if (!dlg.open) dlg.showModal();
    show(j, n);

    // the text for WhatsApp and X comes separately and never holds the card back; without it, the title and this page's address
    const m = await j.meta;
    if (n !== epoch) return;
    const text = encodeURIComponent(m?.text ?? `${o.title} ${location.href}`);
    wa.href = `https://wa.me/?text=${text}`; wa.removeAttribute('aria-disabled');
    x.href = `https://x.com/intent/post?text=${text}`; x.removeAttribute('aria-disabled');
  }

  function retry() {
    if (!opts) return;
    warm.delete(job?.key ?? '');
    const j = start(opts, true);
    if (!j) return;
    job = j; epoch++;
    show(j, epoch);
  }

  /* ——— the buttons ——— */
  const link = async () => (await job?.meta)?.link ?? location.href;
  async function copy(text: string) { try { await navigator.clipboard.writeText(text); return true; } catch { return false; } }
  function save(f: File) {
    const a = document.createElement('a');
    a.href = URL.createObjectURL(f); a.download = f.name;
    document.body.appendChild(a); a.click(); a.remove();
  }

  /** the phone's own share sheet with the card as a picture and nothing else; null when this browser can't do it */
  function sheet(file: File) {
    if (typeof navigator.share !== 'function' || !navigator.canShare?.({ files: [file] })) return null;
    return navigator.share({ files: [file] }).then(() => true, (e) => (e?.name === 'AbortError' ? true : false));
  }

  async function onApp(id: string) {
    if (id === 'sh-copy') { say((await copy(await link())) ? 'Link copied' : 'Could not copy'); return; }
    const j = job;
    if (!j) return;
    // the full-size picture is normally ready by now; if not, it is fetched now (still within the tap)
    let file = j.file ?? null;
    if (!file) { say('Preparing the picture'); file = await fullOf(j); }
    if (!file) { say('Couldn’t draw the card'); return; }
    if (id === 'sh-save') { save(file); say('Image saved'); return; }
    if (id === 'sh-more') {
      const r = sheet(file);
      if (!r || !(await r)) { save(file); say('Image saved'); }
      return;
    }
    if (id === 'sh-ig') {
      // a website can't open Instagram Stories. On a phone: copy the page's short link, then offer the picture alone, so
      // Instagram is offered right away (and the Link sticker can paste the link). On a computer: save the picture and copy the link.
      const known = await Promise.race([j.meta, Promise.resolve(undefined)]);
      const copied = known?.link ? navigator.clipboard.writeText(known.link).then(() => true, () => false) : link().then(copy);   // started in the tap, not waited for
      const r = phone() ? sheet(file) : null;
      if (r) { say('Link copied'); if (!(await r)) save(file); }
      else { save(file); say((await copied) ? 'Image saved, link copied' : 'Image saved'); }
    }
  }

  document.addEventListener('click', (ev) => {
    const t = ev.target as Element;
    const b = t.closest<HTMLElement>('[data-share]');
    if (b) { try { void open(JSON.parse(b.dataset.share!)); } catch { /* bad data: do nothing */ } return; }
    const dlg = document.getElementById('share-box') as HTMLDialogElement | null;
    if (!dlg?.open) return;
    if (t === dlg) { dlg.close(); return; }                       // a tap outside
    if (!t.closest('#share-box')) return;
    if (t.closest('#sh-retry')) { retry(); return; }
    const app = t.closest<HTMLElement>('.sh-app');
    if (!app) return;
    if (app.getAttribute('aria-disabled') === 'true') { ev.preventDefault(); say('One moment'); return; }
    if (app.tagName === 'BUTTON') void onApp(app.id);
  });
  // a mouse over a Share button starts the drawing early; a press does too (the click follows a moment later)
  document.addEventListener('pointerover', (ev) => {
    if (!mouse()) return;
    const b = (ev.target as Element).closest<HTMLElement>('[data-share]');
    if (b) { try { start(JSON.parse(b.dataset.share!)); } catch { /* bad data */ } }
  });
  document.addEventListener('pointerdown', (ev) => {
    const b = (ev.target as Element).closest<HTMLElement>('[data-share]');
    if (b) { try { start(JSON.parse(b.dataset.share!)); } catch { /* bad data */ } }
  });
  document.addEventListener('close', (ev) => { if ((ev.target as HTMLElement).id === 'share-box') { epoch++; opts = null; job = null; } }, true);

  // a swipe down closes the sheet on a phone (from the handle, the card or the app row)
  const reduced = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
  let drag: { y: number; id: number } | null = null;
  document.addEventListener('pointerdown', (ev) => {
    const dlg = document.getElementById('share-box') as HTMLDialogElement | null;
    if (!dlg?.open || ev.pointerType === 'mouse' || !matchMedia('(max-width: 640px)').matches) return;
    if (!(ev.target as Element).closest('#share-box')) return;
    drag = { y: ev.clientY, id: ev.pointerId };
  });
  document.addEventListener('pointermove', (ev) => {
    if (!drag || ev.pointerId !== drag.id) return;
    const dlg = document.getElementById('share-box') as HTMLDialogElement;
    const dy = Math.max(0, ev.clientY - drag.y);
    dlg.style.transition = 'none'; dlg.style.transform = `translateY(${dy}px)`;
  });
  const endDrag = (ev: PointerEvent) => {
    if (!drag || ev.pointerId !== drag.id) return;
    const dlg = document.getElementById('share-box') as HTMLDialogElement;
    const dy = Math.max(0, ev.clientY - drag.y);
    drag = null;
    dlg.style.transition = reduced() ? 'none' : 'transform .18s ease';
    if (dy > 90) { dlg.style.transform = 'translateY(100%)'; setTimeout(() => { dlg.close(); dlg.style.transform = ''; dlg.style.transition = ''; }, reduced() ? 0 : 170); }
    else { dlg.style.transform = ''; setTimeout(() => { dlg.style.transition = ''; }, 200); }
  };
  document.addEventListener('pointerup', endDrag);
  document.addEventListener('pointercancel', endDrag);
</script>
