---
// The share window. Any button with `data-share` opens it (see the script below for the JSON it carries).
// It shows the card that will be shared: your story card for a title on your shelf, your year card, or the
// link preview for any other page. On a phone "Share" opens the phone's own share sheet with the picture.
---
<dialog class="box share" id="share-box" aria-labelledby="share-h">
  <h2 id="share-h">Share</h2>
  <div class="share-pic" id="share-pic" data-wide="0">
    <img id="share-img" alt="The card you are sharing" hidden />
    <span class="share-wait" id="share-wait">Drawing the card…</span>
  </div>
  <div class="share-line" id="share-line" hidden>
    <label class="share-k" for="share-text">Line on the card</label>
    <input class="field" id="share-text" maxlength="140" autocomplete="off" />
    <select class="field" id="share-saved" aria-label="Or pick one of your saved Lines" hidden></select>
  </div>
  <div class="share-go">
    <button class="btn primary" type="button" id="share-ig">Instagram</button>
    <button class="btn" type="button" id="share-sheet" hidden>Share…</button>
    <a class="btn" id="share-wa" target="_blank" rel="noopener">WhatsApp</a>
    <a class="btn" id="share-x" target="_blank" rel="noopener">X</a>
    <button class="btn" type="button" id="share-save">Download image</button>
    <button class="btn" type="button" id="share-copy">Copy link</button>
  </div>
  <p class="share-note" id="share-note" role="status">Instagram can’t link a story to a website, so the page’s address is copied for you to paste with the Link sticker.</p>
  <div class="row"><button class="btn" type="button" id="share-close">Close</button></div>
</dialog>

<style>
  dialog.share { width: min(520px, calc(100vw - 32px)); }
  .share-pic { display: grid; place-items: center; min-height: 160px; margin: 6px 0 14px; border-radius: 12px; background: var(--soft); overflow: hidden; }
  .share-pic img { display: block; max-width: 100%; max-height: min(52vh, 460px); height: auto; width: auto; border-radius: 8px; box-shadow: 0 12px 30px -14px var(--shadow); }
  .share-pic[data-wide="1"] img { max-height: 260px; }
  .share-wait { font-size: 14px; color: var(--muted); padding: 40px 0; }
  .share-line { display: flex; flex-direction: column; gap: 8px; margin-bottom: 14px; }
  .share-k { font-size: 12px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
  .share-line .field { height: 44px; font-size: 15px; }
  .share-go { display: flex; flex-wrap: wrap; gap: 8px; }
  .share-go .btn { height: 42px; text-decoration: none; }
  .share-go [hidden] { display: none; }
  dialog.box p.share-note { margin: 14px 0 0; font-size: 13.5px; min-height: 2.9em; }
  dialog.box p.share-note.ok { color: var(--lat); }
</style>

<script>
  // A button with data-share carries JSON: { url, title, preview?, stories?, year? }
  //   url      the public page's address (what gets copied and sent as a link; never your entry or your shelf)
  //   preview  the link-preview picture, shown when there is no card of your own
  //   stories  { key: { user, slug } } your entries on this page; the visible season's key is used on TV pages
  //   year     { user, year } for the My year card
  type Opts = { url: string; title: string; preview?: string; stories?: Record<string, { user: string; slug: string }>; year?: { user: string; year: number } };
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  let opts: Opts | null = null;
  let src = '';                          // the picture's address, without a ?line=
  let blob: Promise<Blob | null> = Promise.resolve(null);
  let story: { user: string; slug: string; v: string } | null = null;
  let asked = 0;                         // newest request wins

  const phone = () => typeof navigator.canShare === 'function' && /Android|iPhone|iPad|iPod/i.test(navigator.userAgent);
  const fileName = () => `granthalaya-${(opts?.title ?? 'card').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '') || 'card'}.png`;
  const say = (msg: string, ok = false) => { const n = $('share-note'); n.textContent = msg; n.classList.toggle('ok', ok); };
  const DEFAULT_NOTE = 'Instagram can’t link a story to a website, so the page’s address is copied for you to paste with the Link sticker.';

  async function copy(text: string) {
    try { await navigator.clipboard.writeText(text); return true; } catch { return false; }
  }

  function draw(address: string, wide: boolean) {
    const n = ++asked;
    const img = $<HTMLImageElement>('share-img'), wait = $('share-wait');
    img.hidden = true; wait.hidden = false; wait.textContent = 'Drawing the card…';
    $('share-pic').dataset.wide = wide ? '1' : '0';
    blob = fetch(address, { credentials: 'same-origin' }).then(async (r) => {
      if (!r.ok) throw new Error(String(r.status));
      const b = await r.blob();
      if (n !== asked) return b;
      img.src = URL.createObjectURL(b);
      img.hidden = false; wait.hidden = true;
      return b;
    }).catch(() => { if (n === asked) { wait.hidden = false; wait.textContent = 'The card could not be drawn just now.'; } return null; });
  }

  function storyAddress(line: string) {
    if (!story) return '';
    return `/@${story.user}/library/${story.slug}/story.png?v=${story.v}${line ? `&line=${encodeURIComponent(line)}` : ''}`;
  }

  async function open(o: Opts) {
    opts = o; story = null; src = '';
    $('share-h').textContent = o.title ? `Share ${o.title}` : 'Share';
    $('share-line').hidden = true; ($<HTMLSelectElement>('share-saved')).hidden = true;
    say(DEFAULT_NOTE);
    ($<HTMLAnchorElement>('share-wa')).href = `https://wa.me/?text=${encodeURIComponent(`${o.title} ${o.url}`)}`;
    ($<HTMLAnchorElement>('share-x')).href = `https://x.com/intent/post?text=${encodeURIComponent(o.title)}&url=${encodeURIComponent(o.url)}`;
    $('share-sheet').hidden = !phone();
    const dlg = $<HTMLDialogElement>('share-box');
    if (!dlg.open) dlg.showModal();

    const keys = Object.keys(o.stories ?? {});
    const pick = document.querySelector<HTMLSelectElement>('[data-season-pick]')?.value;
    const mine = o.stories?.[pick && o.stories[pick] ? pick : keys[0]];
    if (o.year) {
      src = `/@${o.year.user}/year.png?year=${o.year.year}`;
      draw(src, false);
    } else if (mine) {
      try {
        const r = await fetch(`/@${mine.user}/library/${mine.slug}/story.json`, { credentials: 'same-origin' });
        if (!r.ok) throw new Error();
        const j = await r.json() as { v: string; line: string; lines: string[] };
        story = { ...mine, v: j.v };
        const input = $<HTMLInputElement>('share-text'), saved = $<HTMLSelectElement>('share-saved');
        input.value = j.line;
        $('share-line').hidden = false;
        saved.replaceChildren(new Option('Or pick one of your saved Lines', ''), ...j.lines.map((t) => new Option(t.length > 70 ? t.slice(0, 69) + '…' : t, t)));
        saved.hidden = j.lines.length === 0;
        src = storyAddress('');
        draw(src, false);
      } catch { story = null; }
    }
    if (!src && o.preview) { src = o.preview; draw(src, true); }
    if (!src) { $('share-wait').textContent = 'No card for this page.'; }
  }

  // changing the line draws the card again after a short pause
  let t: ReturnType<typeof setTimeout>;
  function lineChanged() {
    clearTimeout(t);
    t = setTimeout(() => {
      if (!story) return;
      const text = $<HTMLInputElement>('share-text').value.replace(/\s+/g, ' ').trim();
      draw(storyAddress(text), false);
    }, 600);
  }

  async function asFile() {
    const b = await blob;
    return b ? new File([b], fileName(), { type: 'image/png' }) : null;
  }
  function download(b: Blob) {
    const a = document.createElement('a');
    a.href = URL.createObjectURL(b); a.download = fileName();
    document.body.appendChild(a); a.click(); a.remove();
  }
  async function sheet(file: File) {
    try { await navigator.share({ files: [file] }); } catch { /* closed without sharing */ }
  }

  document.addEventListener('click', async (ev) => {
    const b = (ev.target as Element).closest<HTMLElement>('[data-share]');
    if (b) {
      try { await open(JSON.parse(b.dataset.share!)); } catch { /* bad data: do nothing */ }
      return;
    }
    if (!opts || !(ev.target as Element).closest('#share-box')) return;
    const id = (ev.target as Element).closest('button')?.id;
    if (id === 'share-close') $<HTMLDialogElement>('share-box').close();
    else if (id === 'share-copy') say((await copy(opts.url)) ? 'Link copied.' : 'Could not copy. Select the address and copy it by hand.', true);
    else if (id === 'share-save') { const f = await blob; if (f) download(f); }
    else if (id === 'share-sheet') { const f = await asFile(); if (f && navigator.canShare({ files: [f] })) await sheet(f); else say('This phone can’t share a picture from here. Use Download image.'); }
    else if (id === 'share-ig') {
      // Instagram can't link a story back to a website: copy the public page's address for the Link sticker
      const copied = await copy(opts.url);
      const f = await asFile();
      const msg = copied ? 'Link copied. In Instagram, add the Link sticker and paste it.' : `Copy this address for the Link sticker: ${opts.url}`;
      if (f && phone() && navigator.canShare({ files: [f] })) { say(msg, copied); await sheet(f); }
      else if (f) { download(f); say(`${msg} Instagram needs the phone, so the picture was downloaded to send there.`, copied); }
      else say(msg, copied);
    }
  });
  document.addEventListener('input', (ev) => {
    const el = ev.target as HTMLElement;
    if (el.id === 'share-text') lineChanged();
    if (el.id === 'share-saved') {
      const v = (el as HTMLSelectElement).value;
      if (v) { $<HTMLInputElement>('share-text').value = v; lineChanged(); }
    }
  });
  document.addEventListener('close', (ev) => { if ((ev.target as HTMLElement).id === 'share-box') { asked++; opts = null; } }, true);
</script>
