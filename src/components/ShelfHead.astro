---
// The top of every page of a person's: the tabs (Shelf, Collections) and the "View profile" button, which opens the profile panel in place.
// `heading` is a hidden page title for screen readers, only on pages that have no visible h1 of their own.
import ShelfTabs, { type ShelfTab } from './ShelfTabs.astro';
import ProfilePanel from './ProfilePanel.astro';
import type { Shelf } from '../lib/shelfpage';
import type { Entry, LatestReview } from '../lib/data';
interface Props { shelf: Shelf; current?: ShelfTab; heading?: string; favs?: Entry[]; latest?: LatestReview | null; tabs?: boolean }
const { shelf, current, heading, favs = [], latest = null, tabs = true } = Astro.props;
const p = shelf.profile;
---
{heading && <h1 class="sr">{heading}</h1>}
<div class="shead">
  {tabs ? <ShelfTabs username={p.username} current={current} /> : <span></span>}
  <button type="button" class="btn vp" aria-expanded="false" aria-controls="profile" data-profile-btn>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="8" r="4" /><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6" /></svg>
    <span data-profile-label>View profile</span>
  </button>
</div>
<ProfilePanel shelf={shelf} favs={favs} latest={latest} />
<style>
  .shead { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; border-bottom: 1px solid var(--line); }
  .vp { height: 40px; margin-bottom: 4px; }
</style>
<script>
  function setup() {
    const btn = document.querySelector<HTMLButtonElement>('[data-profile-btn]');
    const panel = document.getElementById('profile');
    if (!btn || !panel || btn.dataset.ready) return;
    btn.dataset.ready = '1';
    const label = btn.querySelector<HTMLElement>('[data-profile-label]')!;
    const set = (open: boolean, focusBack = false) => {
      panel.classList.toggle('is-open', open);
      btn.setAttribute('aria-expanded', String(open));
      label.textContent = open ? 'Hide profile' : 'View profile';
      if (!open && focusBack) btn.focus({ preventScroll: true });
    };
    btn.addEventListener('click', () => set(!panel.classList.contains('is-open')));
    panel.addEventListener('keydown', (ev) => { if (ev.key === 'Escape' && panel.classList.contains('is-open')) { ev.stopPropagation(); set(false, true); } });
    if (location.hash === '#profile') set(true);
  }
  document.addEventListener('astro:page-load', setup);
</script>
