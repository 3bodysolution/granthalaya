---
// The footer: a painted Sahyadri valley, by day and by night.
// The painting is shown exactly as painted. It's cut into four solid layers (sky, mesas, valley, near hill)
// that slide a few pixels with the cursor, and a few small things move: the flag, a banyan leaf,
// the waterfalls and the river. When it's raining in Pune, it rains here too.
import { site } from '../data/site';
import overlay from '../data/valley.json';
const line = site.lineOfTheWeek;
const layers = [0, 1, 2, 3];
---
<div class="valley" data-overlay={JSON.stringify(overlay)}>
  <div class="frame">
    <div class="set skyL" data-set="day">
      {layers.map((k) => <img class="layer" data-k={k} src={`/img/valley-day-${k}.webp`} alt="" width="2172" height="629" loading="lazy" decoding="async" />)}
    </div>
    <div class="set skyD" data-set="night">
      {layers.map((k) => <img class="layer" data-k={k} src={`/img/valley-night-${k}.webp`} alt="" width="2172" height="629" loading="lazy" decoding="async" />)}
    </div>
    <canvas class="fx" aria-hidden="true"></canvas>
    <button class="shepherd" type="button" aria-label="The shepherd has something to say"
            data-line={`“${line.text}” — ${line.by}, ${line.source}`}></button>
  </div>
  <div class="tip" aria-live="polite"></div>
</div>

<style>
  .valley { position: relative; overflow: hidden; }
  .frame {
    position: relative; width: max(100%, 760px); max-width: 2172px; margin: 0 auto; aspect-ratio: 2172 / 629;
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 6%);
    mask-image: linear-gradient(to bottom, transparent 0, #000 6%);
  }
  /* very wide screens: let the sides melt away too */
  @media (min-width: 2172px) {
    .frame { -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 6%), linear-gradient(to right, transparent, #000 4%, #000 96%, transparent); -webkit-mask-composite: source-in;
             mask-image: linear-gradient(to bottom, transparent 0, #000 6%), linear-gradient(to right, transparent, #000 4%, #000 96%, transparent); mask-composite: intersect; }
  }
  /* on small screens, show the part with the banyan and the shepherd */
  @media (max-width: 760px) { .frame { margin-left: calc((100vw - 760px) * 0.32); } }
  .set { position: absolute; inset: 0; }
  .layer { position: absolute; inset: 0; width: 100%; height: 100%; display: block; will-change: transform; image-rendering: auto; }
  .fx { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .shepherd { position: absolute; left: 28.8%; top: 71%; width: 2.6%; height: 9%; border: 0; padding: 0; background: transparent; cursor: pointer; border-radius: 8px; }
  .shepherd:focus-visible { outline: 2px solid var(--lat); }
  .tip { position: absolute; left: 0; top: 0; max-width: min(380px, 84vw); pointer-events: none; background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 9px 13px;
         font-family: Fraunces, Georgia, serif; font-size: 14px; line-height: 1.45; color: var(--ink); box-shadow: 0 14px 28px -14px rgba(0,0,0,.45);
         opacity: 0; transform: translate(-50%, calc(-100% + 6px)); transition: opacity .3s ease, transform .4s cubic-bezier(.2,.8,.2,1); z-index: 3; }
  .tip.on { opacity: 1; transform: translate(-50%, -100%); }
</style>

<script>
  type Overlay = { falls: number[][][]; glintsDay: number[][]; glintsNight: number[][] };
  const IW = 2172, IH = 629;
  const SHIFT = [0, 2, 4, 7];              // how far each layer slides, in painting pixels, at full cursor travel
  const FLAG = { day: { x: 1440, y: 257, src: '/img/valley-day-flag.png' }, night: { x: 1440, y: 258, src: '/img/valley-night-flag.png' } };

  function wake() {
    const root = document.querySelector<HTMLElement>('.valley');
    if (!root || root.dataset.alive) return;
    root.dataset.alive = '1';
    const frame = root.querySelector<HTMLElement>('.frame')!;
    const fx = root.querySelector<HTMLCanvasElement>('.fx')!;
    const tip = root.querySelector<HTMLElement>('.tip')!;
    const ov: Overlay = JSON.parse(root.dataset.overlay!);
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isNight = () => document.documentElement.dataset.theme === 'dark';
    const ctx = fx.getContext('2d')!;

    let S = 1, dpr = 1;
    const resize = () => { const r = frame.getBoundingClientRect(); dpr = Math.min(2, devicePixelRatio || 1); S = r.width / IW; fx.width = Math.round(r.width * dpr); fx.height = Math.round(r.height * dpr); };

    // flags (cut out of the painting so they can move)
    const flags: Record<string, HTMLImageElement> = {};
    for (const k of ['day', 'night'] as const) { const i = new Image(); i.src = FLAG[k].src; i.onload = () => kick(); flags[k] = i; }

    /* ——— the shepherd's secret ——— */
    root.querySelector<HTMLButtonElement>('.shepherd')!.addEventListener('click', (ev) => {
      const b = ev.currentTarget as HTMLElement, r = b.getBoundingClientRect(), o = root!.getBoundingClientRect();
      tip.textContent = b.dataset.line!;
      tip.style.left = Math.max(190, Math.min(o.width - 190, r.left - o.left + r.width / 2)) + 'px';
      tip.style.top = (r.top - o.top - 6) + 'px';
      tip.classList.add('on'); clearTimeout((tip as any)._t); (tip as any)._t = setTimeout(() => tip.classList.remove('on'), 6500);
    });
    document.addEventListener('pointerdown', (ev) => { if (!(ev.target as Element).closest?.('.shepherd')) tip.classList.remove('on'); });

    /* ——— is it raining in Pune right now? ——— */
    let rain: { x: number; y: number; l: number; s: number }[] = [];
    (async () => {
      let wet = new URLSearchParams(location.search).has('rain');
      try {
        const cached = JSON.parse(sessionStorage.getItem('puneRain') || 'null');
        if (cached && Date.now() - cached.t < 30 * 60 * 1000) wet ||= cached.wet;
        else {
          const j = await fetch('https://api.open-meteo.com/v1/forecast?latitude=18.52&longitude=73.86&current=precipitation,weather_code').then((r) => r.json());
          const code = j.current?.weather_code ?? 0, mm = j.current?.precipitation ?? 0;
          const now = mm > 0.05 || (code >= 51 && code <= 67) || (code >= 80 && code <= 99);
          sessionStorage.setItem('puneRain', JSON.stringify({ t: Date.now(), wet: now })); wet ||= now;
        }
      } catch {}
      if (wet && !reduce) { rain = Array.from({ length: 150 }, () => ({ x: Math.random() * IW, y: Math.random() * IH, l: 12 + Math.random() * 14, s: 0.9 + Math.random() * 0.6 })); kick(); }
    })();

    /* ——— parallax: four solid layers, a few pixels each ——— */
    let mx = 0, tx = 0, hasMouse = false;
    const onMove = (ev: PointerEvent) => { if (ev.pointerType !== 'mouse') return; hasMouse = true; tx = Math.max(-1, Math.min(1, (ev.clientX / innerWidth) * 2 - 1)); kick(); };
    addEventListener('pointermove', onMove, { passive: true });
    const layerEls = [...root.querySelectorAll<HTMLImageElement>('.layer')];
    const offset = (k: number) => -mx * SHIFT[k];    // painting px

    let leaf: { x: number; y: number; vx: number; vy: number; rot: number; life: number } | null = null, nextLeaf = 5000;
    const flowPhase = Math.random() * 100;

    function draw(t: number, dt: number) {
      const night = isNight();
      ctx.setTransform(dpr * S, 0, 0, dpr * S, 0, 0);
      ctx.clearRect(0, 0, IW, IH);
      const o1 = offset(1), o2 = offset(2), o3 = offset(3);

      // the fort's flag: a slow, lazy flutter
      const f = FLAG[night ? 'night' : 'day'], img = flags[night ? 'night' : 'day'];
      if (img.complete && img.naturalWidth) {
        const w = img.naturalWidth, h = img.naturalHeight, ts = reduce ? 0 : t / 1000;
        for (let i = 0; i < w; i++) {
          const amp = 1.5 * (i / w), dy = Math.sin(ts * 1.25 - i * 0.22) * amp;
          ctx.drawImage(img, i, 0, 1, h, f.x + o1 + i, f.y + dy, 1.02, h);
        }
      }
      if (reduce) return;

      // waterfalls: a faint, slow flow
      ctx.lineCap = 'round'; ctx.lineWidth = 1.3;
      ctx.strokeStyle = night ? 'rgba(225,235,255,0.22)' : 'rgba(255,255,255,0.28)';
      for (const fall of ov.falls) {
        if (fall.length < 2) continue;
        const len = fall.length;
        for (let d = 0; d < 3; d++) {
          const p = ((t / 2600 + d / 3 + flowPhase) % 1) * (len - 1), i = Math.floor(p);
          const a = fall[i], b = fall[Math.min(i + 1, len - 1)], q = p - i;
          const x = a[0] + (b[0] - a[0]) * q + o1, y = a[1] + (b[1] - a[1]) * q;
          ctx.beginPath(); ctx.moveTo(x, y); ctx.lineTo(x - (b[0] - a[0]) * 0.6, y + 5); ctx.stroke();
        }
      }
      // the river: soft glints that come and go
      const gl = night ? ov.glintsNight : ov.glintsDay;
      for (let i = 0; i < gl.length; i++) {
        const [x, y] = gl[i], a = Math.max(0, Math.sin(t / 1300 + i * 2.3)) ** 6 * (night ? 0.4 : 0.5);
        if (a < 0.02) continue;
        ctx.fillStyle = night ? `rgba(236,242,255,${a.toFixed(3)})` : `rgba(255,250,232,${a.toFixed(3)})`;
        ctx.beginPath(); ctx.ellipse(x + o2, y, 3.2, 0.9, 0, 0, 7); ctx.fill();
      }
      // a banyan leaf, now and then
      nextLeaf -= dt;
      if (!leaf && nextLeaf < 0) { leaf = { x: 90 + Math.random() * 480, y: 240 + Math.random() * 110, vx: 0.012 + Math.random() * 0.02, vy: 0, rot: Math.random() * 6, life: 0 }; nextLeaf = 9000 + Math.random() * 6000; }
      if (leaf) {
        leaf.life += dt; leaf.vy = Math.min(0.035, leaf.vy + 0.00003 * dt);
        leaf.x += (leaf.vx + Math.sin(leaf.life / 340) * 0.025) * dt; leaf.y += leaf.vy * dt; leaf.rot += dt * 0.003;
        const fade = Math.min(1, leaf.life / 400, (560 - leaf.y) / 60);
        ctx.save(); ctx.translate(leaf.x + o3, leaf.y); ctx.rotate(leaf.rot); ctx.scale(1, 0.4 + 0.6 * Math.abs(Math.sin(leaf.life / 300)));
        ctx.fillStyle = night ? `rgba(46,72,52,${fade})` : `rgba(70,110,40,${fade})`;
        ctx.beginPath(); ctx.ellipse(0, 0, 7.5, 3.4, 0, 0, 7); ctx.fill();
        ctx.strokeStyle = night ? `rgba(30,48,36,${fade})` : `rgba(48,80,28,${fade})`; ctx.lineWidth = 0.8; ctx.beginPath(); ctx.moveTo(-7, 0); ctx.lineTo(7, 0); ctx.stroke();
        ctx.restore();
        if (leaf.y > 560) leaf = null;
      }
      // monsoon rain, when it's raining in Pune
      if (rain.length) {
        ctx.strokeStyle = night ? 'rgba(205,216,236,.26)' : 'rgba(80,100,124,.3)'; ctx.lineWidth = 1.2; ctx.beginPath();
        for (const d of rain) { d.y += d.s * dt; d.x -= d.s * dt * 0.16; if (d.y > IH) { d.y = -20; d.x = Math.random() * (IW + 100); } ctx.moveTo(d.x, d.y); ctx.lineTo(d.x + d.l * 0.16, d.y - d.l); }
        ctx.stroke();
      }
    }

    /* ——— the loop: only while the footer is on screen ——— */
    let visible = false, raf = 0, last = performance.now();
    const start = performance.now();
    function frameFn(now: number) {
      raf = 0;
      if (!root!.isConnected) { removeEventListener('pointermove', onMove); return; }
      const dt = Math.min(48, now - last); last = now;
      if (!reduce) {
        mx += (tx - mx) * 0.035;
        for (const el of layerEls) { const k = +el.dataset.k!; el.style.transform = k ? `translate3d(${(offset(k) * S).toFixed(2)}px,0,0)` : ''; }
      }
      draw(now - start, dt);
      if (visible && !reduce) raf = requestAnimationFrame(frameFn);
    }
    function kick() { if (!raf) { last = performance.now(); raf = requestAnimationFrame(frameFn); } }

    new ResizeObserver(() => { resize(); kick(); }).observe(frame);
    new IntersectionObserver((es) => { visible = es[0].isIntersecting; if (visible) kick(); }, { rootMargin: '120px' }).observe(root);
    new MutationObserver(() => kick()).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    resize();
  }
  document.addEventListener('astro:page-load', wake);
</script>
