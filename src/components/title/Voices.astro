---
// What people on Granthalaya wrote about this title (only shelves the visitor may see), and the collections it's in.
import Face from '../Face.astro';
import Stars from '../ui/Stars.astro';
import type { OnSite } from '../../lib/catalog/onsite';
import { excerpt } from '../../lib/data';
interface Props { site: OnSite; facts?: { list: string[]; source?: string | null; label: string } }
const { site, facts } = Astro.props;
---
{facts && facts.list.length > 0 && (
  <section class="pad block">
    <div class="rule"><h2 class="eyebrow">{facts.label}</h2>{facts.source && <a href={facts.source} class="more" target="_blank" rel="noopener">From Wikipedia ↗</a>}</div>
    <ol class="facts">{facts.list.map((t, i) => <li class="card"><span class="serif num fn">{String(i + 1).padStart(2, '0')}</span><p>{t}</p></li>)}</ol>
  </section>
)}
{site.voices.length > 0 && (
  <section class="pad block">
    <div class="rule"><h2 class="eyebrow">From people on Granthalaya</h2></div>
    <div class="voices">
      {site.voices.map((v) => (
        <a href={v.href} class="card voice">
          <span class="who"><Face name={v.name} src={v.avatar} size={30} /><b>{v.name}</b>{v.rating != null && <span class="vst"><Stars rating={v.rating} /></span>}{v.again && <span class="muted vs">again</span>}</span>
          <span class="vt">{excerpt({ body: v.notes }, 260)}</span>
        </a>
      ))}
    </div>
  </section>
)}
{site.collections.length > 0 && (
  <section class="pad block">
    <div class="rule"><h2 class="eyebrow">In collections</h2></div>
    <div class="cols">{site.collections.map((c) => <a href={c.href} class="chip">{c.name} <span class="muted">· {c.by}</span></a>)}</div>
  </section>
)}
<style>
  .block { padding-top: 56px; display: flex; flex-direction: column; gap: 22px; }
  .facts { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  .facts li { padding: 22px; display: flex; flex-direction: column; gap: 10px; }
  .fn { font-size: 28px; line-height: 1; color: var(--haldi); }
  .facts p { margin: 0; font-size: 15.5px; line-height: 1.6; }
  .voices { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
  .voice { padding: 20px 22px; display: flex; flex-direction: column; gap: 12px; transition: border-color .2s ease; }
  .voice:hover { border-color: var(--lat); color: inherit; }
  .who { display: flex; align-items: center; gap: 10px; font-size: 14px; }
  .vst { color: var(--haldi); letter-spacing: .04em; }
  .vs { font-size: 12px; }
  .vt { font-family: Fraunces, Georgia, serif; font-size: 17px; line-height: 1.55; }
  .cols { display: flex; flex-wrap: wrap; gap: 10px; }
  @media (max-width: 1100px) { .facts { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 780px) { .facts, .voices { grid-template-columns: 1fr; } .block { padding-top: 40px; } }
</style>
