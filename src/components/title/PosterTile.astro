---
// One title in a grid (lists, a person's films, an author's books): poster, title, year.
// Signed in, a bookmark in the corner saves it to your shelf; if it's already there, its status shows instead.
import Mark from '../ui/Mark.astro';
import Bars from '../ui/Bars.astro';
import StatusIcon from '../ui/StatusIcon.astro';
import { paletteFor } from '../../lib/data';
import { tileImage } from '../../lib/images';
import { statusLabel, type Kind, type Status } from '../../lib/kinds';
interface Props {
  href: string; // empty for a title with no page title: string; year?: number; poster?: string; kind: 'film' | 'tv' | 'book'; sub?: string | (string | undefined)[];
  status?: string; save?: Record<string, unknown>; search?: string;
  /** the log behind a plain save: its filled bookmark takes the save back */
  logId?: string;
  /** poster only (the dense grids): the name shows when you point at it; a tile with no cover still shows its title and author on the placeholder */
  bare?: boolean;
  /** a bigger picture, for the large posters in the Popular this week row */
  large?: boolean;
}
const { href, title, year, poster, kind, sub, status, save, search, logId, bare, large } = Astro.props;
const by = (Array.isArray(sub) ? sub[0] : sub) || '';
const me = Astro.locals.me;
const p = paletteFor(title);
const pic = poster ? tileImage(poster, large) : null;
// list items we couldn't match have no page of their own: the tile opens the search with the title in it
const Link = href || search ? 'a' : 'span';
const to = href || (search ? (kind === 'book' ? '/books/' : '/films/') : undefined);
---
<div class:list={['pt', bare && 'bare']}>
  <Link href={to} class="pt-link" data-search-open={search ? '' : undefined} data-search-q={search}>
    <span class:list={['pt-cover', kind === 'book' ? 'book' : 'film', poster ? 'real' : 'wash']} style={`--bg:${p.bg};--accent:${p.accent};--hill:${p.hill}`}>
      {pic && <img src={pic.src} srcset={pic.srcset} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" onerror="this.closest('.real')?.classList.replace('real','wash');this.remove()" />}
      <i class="sun"></i><i class="hill"></i><span class="serif pt-w">{title}{kind === 'book' && by && <small class="pt-wa">{by}</small>}</span>
    </span>
    {bare && <span class="pt-tip" aria-hidden="true"><b>{title}</b>{(year || by) && <span>{[year, by].filter(Boolean).join(' | ')}</span>}</span>}
    <span class="pt-t">{title}</span>
    <span class="pt-s"><Bars parts={[year, ...(Array.isArray(sub) ? sub : [sub])]} /></span>
  </Link>
  {me && logId && status === 'want' ? (
    <button type="button" class="pt-save is-saved" data-unsave={logId} data-quick-add={save ? JSON.stringify({ hit: save, status: 'want' }) : undefined} aria-label={`Saved: ${title}. Tap to remove`} title="Saved. Tap to remove"><Mark size={16} /></button>
  ) : status ? (
    <StatusIcon status={(status === 'done' ? 'done' : status) as any} label={statusLabel(kind as Kind, status as Status)} class="pt-badge" />
  ) : me && save ? (
    <button type="button" class="pt-save" data-quick-add={JSON.stringify({ hit: save, status: 'want' })} aria-label={`Save ${title}`} title="Save to your shelf"><Mark size={16} /></button>
  ) : null}
</div>
<style>
  .pt { position: relative; min-width: 0; }
  .pt-link { display: flex; flex-direction: column; gap: 8px; }
  .pt-link:hover { color: inherit; }
  .pt-cover { position: relative; display: block; width: 100%; aspect-ratio: 2 / 3; overflow: hidden; background: var(--bg); color: #F6EEDF; box-shadow: 0 10px 18px -12px var(--shadow); transition: transform .35s var(--spring), box-shadow .35s ease; }
  .pt-cover.film { border-radius: 6px; }
  .pt-cover.book { border-radius: 2px 6px 6px 2px; }
  .pt-link:hover .pt-cover { transform: translateY(-4px); box-shadow: 0 0 0 2px var(--lat), 0 18px 24px -14px var(--shadow); }
  .pt-cover img { position: absolute; inset: 0; z-index: 1; width: 100%; height: 100%; object-fit: cover; outline: 1px solid rgba(0,0,0,.1); outline-offset: -1px; }
  .sun, .hill { position: absolute; display: block; }
  .sun { width: 56%; aspect-ratio: 1; border-radius: 50%; right: -12%; top: 22%; background: var(--accent); opacity: .78; }
  .hill { left: -20%; width: 140%; bottom: -8px; height: 32%; border-radius: 50% 50% 0 0; background: var(--hill); }
  .pt-w { position: absolute; left: 10px; right: 10px; bottom: 12px; font-size: 15px; line-height: 1.15; overflow-wrap: anywhere; }
  .real .sun, .real .hill, .real .pt-w { visibility: hidden; }
  .pt-t { font-size: 14px; font-weight: 600; line-height: 1.25; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .pt-s { margin-top: -4px; font-size: 12.5px; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .pt :global(.pt-badge) { position: absolute; top: 8px; right: 8px; z-index: 2; }
  .pt-save { position: absolute; top: 6px; right: 6px; z-index: 2; width: 36px; height: 36px; border-radius: 50%; border: 0; display: grid; place-items: center; background: rgba(12, 14, 18, .55); color: #fff; cursor: pointer; opacity: 0; transition: opacity .2s ease, transform .25s var(--spring); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); }
  .pt:hover .pt-save, .pt-save:focus-visible, .pt-save:global(.is-saved) { opacity: 1; }
  .pt-save:active { transform: scale(.92); }
  .pt-save:global(.is-saved) :global(.mk-edge) { stroke: #fff; }
  @media (hover: none) { .pt-save { opacity: 1; } }
  .pt-wa { display: none; margin-top: 4px; font-family: 'Instrument Sans', system-ui, sans-serif; font-size: 11px; font-weight: 500; opacity: .85; }
  /* poster only: the text under it stays for screen readers, and the name shows over the foot of the poster on hover or focus */
  .bare .pt-link { gap: 0; }
  .bare .pt-t, .bare .pt-s { position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .bare .pt-w { font-size: 13px; left: 8px; right: 8px; bottom: 10px; }
  .bare.pt .pt-wa, .bare .pt-wa { display: block; }
  .bare .real .pt-wa { display: none; }
  .bare .pt-save { width: 28px; height: 28px; top: 5px; right: 5px; }
  .bare :global(.pt-badge) { top: 5px; right: 5px; }
  .pt-tip { position: absolute; z-index: 3; left: 6px; right: 6px; bottom: 6px; display: flex; flex-direction: column; gap: 1px; padding: 7px 9px; border-radius: 5px; background: rgba(12, 14, 18, .86); color: #F6EEDF; font-size: 12.5px; line-height: 1.25; pointer-events: none; opacity: 0; transform: translateY(4px); transition: opacity .15s ease, transform .2s var(--spring); }
  .pt-tip b { font-weight: 600; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .pt-tip span { font-size: 11.5px; opacity: .8; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-variant-numeric: tabular-nums; }
  @media (hover: hover) { .pt:hover .pt-tip { opacity: 1; transform: none; } }
  .pt-link:focus-visible .pt-tip { opacity: 1; transform: none; }
  @media (max-width: 780px) { .bare .pt-save { width: 24px; height: 24px; top: 4px; right: 4px; } .bare .pt-w { font-size: 11px; left: 6px; right: 6px; bottom: 8px; } }
  @media (prefers-reduced-motion: reduce) { .pt-tip { transition: opacity .15s ease; transform: none; } }
</style>
