---
// The frame shared by film, TV and book pages: a still from the film (or one of our paintings) across the top,
// the poster on the left, the facts in the middle, your log on the right, and fuller sections below.
// On a phone the order is: poster, title and summary, your log, where to watch (or find it), then cast and details.
import { stillImage } from '../../lib/images';
interface Props { backdrop?: string; painting?: 'library' | 'home' }
const { backdrop, painting = 'library' } = Astro.props;
const still = backdrop ? stillImage(backdrop) : null;
---
{backdrop ? (
  <div class="still bleed" aria-hidden="true"><img src={still!.src} srcset={still!.srcset} sizes={still!.sizes} alt="" decoding="async" fetchpriority="high" referrerpolicy="no-referrer" onerror="this.parentElement.classList.add('gone')" /></div>
) : (
  <div class="art melt under-header settle banner bleed" style={`--day: url(/art/${painting}-day.webp); --night: url(/art/${painting}-night.webp)`} aria-hidden="true"></div>
)}
<section class:list={['pad top', backdrop ? 'over-still' : 'over-art']}>
  <div class="side"><div class="tl-pz"><slot name="poster" /></div><div class="tl-sd"><slot name="side" /></div></div>
  <div class="main"><div class="tl-lead"><slot /></div><div class="tl-more"><slot name="more" /></div></div>
  <div class="panel"><slot name="panel" /></div>
</section>
<slot name="below" />

<style>
  /* the still keeps its own colours; it only fades into the page at the edges */
  /* the header floats over the top of the still (see global.css), so the still is that much taller and starts at the very top */
  .still { position: relative; height: calc(clamp(260px, 36vw, 520px) + var(--hh)); overflow: hidden; background: var(--bg);
    -webkit-mask-image: linear-gradient(to bottom, #000 55%, transparent), linear-gradient(to right, transparent, #000 12%, #000 88%, transparent);
    -webkit-mask-composite: source-in; mask-image: linear-gradient(to bottom, #000 55%, transparent), linear-gradient(to right, transparent, #000 12%, #000 88%, transparent); mask-composite: intersect; }
  .still img { width: 100%; height: 100%; object-fit: cover; object-position: center 25%; display: block; animation: fade .8s ease backwards; }
  .still:global(.gone) { height: 0; margin-top: 0; }
  .still:global(.gone) + .over-still { margin-top: 0; }
  .still:global(.gone) + .over-still .main, .still:global(.gone) + .over-still .panel { padding-top: 24px; }
  .banner { height: 260px; background-position: center 62%; }
  .top { position: relative; display: grid; grid-template-columns: 240px minmax(0, 1fr) 270px; gap: 44px; align-items: start; }
  .over-still { margin-top: clamp(-200px, -14vw, -110px); }
  .over-art { margin-top: -150px; }
  .side, .tl-sd { display: flex; flex-direction: column; gap: 16px; }
  .main { min-width: 0; display: flex; flex-direction: column; gap: 18px; padding-top: clamp(110px, 12vw, 190px); }
  .tl-lead, .tl-more { min-width: 0; display: flex; flex-direction: column; gap: 18px; }
  .tl-sd:empty, .tl-more:empty { display: none; }
  .panel { padding-top: clamp(110px, 12vw, 190px); display: flex; flex-direction: column; gap: 16px; }
  @media (max-width: 1100px) {
    .top { grid-template-columns: 200px minmax(0, 1fr); gap: 32px; }
    .panel { grid-column: 1 / -1; padding-top: 0; max-width: 520px; }
  }
  @media (max-width: 780px) {
    .top { display: flex; flex-direction: column; align-items: stretch; gap: 24px; }
    .over-still { margin-top: -120px; }
    .over-art { margin-top: -140px; }
    .side, .main { display: contents; }
    .tl-pz { order: 0; align-self: center; }
    .tl-lead { order: 1; }
    .panel { order: 2; }
    .tl-sd { order: 3; }
    .tl-more { order: 4; }
    .panel { padding-top: 0; width: 100%; max-width: none; }
  }
</style>
