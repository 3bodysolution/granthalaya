---
// A poster or book cover for a title page, with the painted cover as a fallback when there's no image.
import { paletteFor } from '../../lib/data';
interface Props { src?: string; title: string; by?: string; kind: 'film' | 'tv' | 'book'; year?: number }
const { src, title, by, kind, year } = Astro.props;
const p = paletteFor(title);
---
<div class:list={['poster', kind === 'book' ? 'book' : 'film', src ? 'real' : 'wash']} style={`--bg:${p.bg};--accent:${p.accent};--hill:${p.hill}`}>
  {src && <img src={src} alt={`${title} ${kind === 'book' ? 'cover' : 'poster'}`} decoding="async" draggable="false" referrerpolicy="no-referrer" onerror="this.closest('.real')?.classList.replace('real','wash');this.remove()" />}
  <i class="sun"></i><i class="hill"></i>
  <span class="k">{kind === 'book' ? 'Book' : kind === 'tv' ? 'TV' : 'Film'}{year ? ` · ${year}` : ''}</span>
  <span class="t"><span class="serif">{title}</span>{by && <span class="by">{by}</span>}</span>
</div>
<style>
  .poster { position: relative; width: 100%; aspect-ratio: 2 / 3; overflow: hidden; color: #F6EEDF; background: var(--bg); display: flex; flex-direction: column; justify-content: space-between; padding: 18px; box-shadow: 0 22px 34px -18px var(--shadow); animation: rise .8s var(--spring) backwards; }
  .film { border-radius: 8px; }
  .book { border-radius: 3px 8px 8px 3px; }
  .poster img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 1; outline: 1px solid rgba(0,0,0,.1); outline-offset: -1px; }
  .real > :not(img) { visibility: hidden; }
  .sun, .hill { position: absolute; display: block; }
  .sun { width: 60%; aspect-ratio: 1; border-radius: 50%; right: -14%; top: 26%; background: var(--accent); opacity: .78; }
  .hill { left: -20%; width: 140%; bottom: -12px; height: 36%; border-radius: 50% 50% 0 0; background: var(--hill); }
  .k { position: relative; font-size: 11px; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; opacity: .85; }
  .t { position: relative; display: flex; flex-direction: column; gap: 6px; }
  .t .serif { font-size: 28px; line-height: 1.05; overflow-wrap: anywhere; }
  .by { font-size: 12px; opacity: .85; }
  @media (max-width: 780px) { .poster { width: 200px; } }
</style>
