---
// A row of posters that scrolls sideways: a heading, an optional "See all" link, and arrows on screens with a mouse.
// Used on the home page and the Films and Books front pages. Rows with nothing in them are left out.
import PosterTile from './PosterTile.astro';
import type { RowItem } from '../../lib/catalog/rows';
// Poster tiles come from `items`; a row of something else (the Essays cards) passes its own <li>s in the slot, with `col` as the card width.
interface Props { title: string; items?: RowItem[]; href?: string; all?: string; tone?: 'film' | 'book' | 'essay'; id?: string; col?: string; big?: boolean }
const { title, items = [], href, all = 'See all', tone, id = 'row-' + title.toLowerCase().replace(/[^a-z0-9]+/g, '-'), col, big } = Astro.props;
const filled = items.length > 0 || Astro.slots.has('default');
---
{filled && (
  <section class:list={['prow', big && 'big']} aria-labelledby={id} style={col ? `--prow-col:${col}` : undefined} data-prow data-kind={big ? 'big' : col ? 'text' : 'poster'}>
    <div class="prow-head">
      <h2 class="prow-t" id={id} data-tone={tone}>{title}</h2>
      {href && <a class="prow-all" href={href}>{all} <span aria-hidden="true">→</span></a>}
    </div>
    <div class="prow-body">
      <button type="button" class="prow-btn prev" data-row="-1" tabindex="-1" aria-label="Scroll back" aria-hidden="true" disabled>
        <svg viewBox="0 0 24 24"><path d="M15 6l-6 6 6 6" /></svg>
      </button>
      <ul class="prow-list" data-row-list>
        {items.map((i) => <li><PosterTile {...i} large={big} /></li>)}
        <slot />
      </ul>
      <button type="button" class="prow-btn next" data-row="1" tabindex="-1" aria-label="Scroll forward" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M9 6l6 6-6 6" /></svg>
      </button>
    </div>
  </section>
)}

<style>
  .prow { display: flex; flex-direction: column; gap: 14px; min-width: 0; }
  .prow-head { display: flex; align-items: center; gap: 16px; border-bottom: 1px solid var(--line); padding-bottom: 10px; }
  .prow-t { margin: 0; font-size: 12px; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; color: var(--muted); }
  .prow-t[data-tone="film"] { color: var(--sky); }
  .prow-t[data-tone="book"] { color: var(--book); }
  .prow-t[data-tone="essay"] { color: var(--moss); }
  .prow-all { font-size: 13px; font-weight: 600; color: var(--muted); white-space: nowrap; transition: color .2s ease; }
  .prow-all:hover { color: var(--lat); }
  .prow-all span { display: inline-block; margin-left: 3px; transition: transform .2s var(--spring); }
  .prow-all:hover span { transform: translateX(2px); }
  .prow-body { position: relative; min-width: 0; }
  /* the arrows sit in the page margin at each side, level with the middle of the posters, and show when the pointer is on the row */
  .prow-btn { position: absolute; top: calc(50% - 40px); z-index: 2; width: 36px; height: 36px; border-radius: 50%; border: 1px solid var(--line); background: var(--card); color: var(--ink); display: grid; place-items: center; cursor: pointer; opacity: 0; transition: border-color .2s ease, color .2s ease, opacity .2s ease, transform .2s var(--spring); }
  .prow-btn.prev { left: -46px; }
  .prow-btn.next { right: -46px; }
  .prow-body:hover .prow-btn:not(:disabled) { opacity: 1; }
  .prow-btn:hover:not(:disabled) { border-color: var(--lat); color: var(--lat); }
  .prow-btn:active:not(:disabled) { transform: scale(.94); }
  .prow-btn:disabled { opacity: 0; cursor: default; pointer-events: none; }
  .prow-btn svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  /* room above and below so a poster can lift on hover without being cut off.
     The list shows whole posters only: the script below works out how many fit and sets --col and --gap so they fill the row exactly
     (the fallback sizes are only for the moment before it runs). The 2px at each side is smaller than any gap, so no neighbour peeks in. */
  .prow-list { list-style: none; margin: -8px 0 -14px; padding: 8px 2px 14px; display: grid; grid-auto-flow: column; grid-auto-columns: var(--col, var(--prow-col, 152px)); gap: var(--gap, 20px);
    overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory; scroll-padding-inline: 2px; scrollbar-width: none; }
  .prow-list::-webkit-scrollbar { display: none; }
  .prow-list > li { scroll-snap-align: start; min-width: 0; }
  /* the large row: four across, three on a tablet, two on a phone (before the script runs) */
  .big { --prow-col: calc((100% - 64px) / 4); }
  .big .prow-t { font-size: 13px; }
  @media (max-width: 1000px) { .big { --prow-col: calc((100% - 44px) / 3); } }
  @media (max-width: 1100px) { .prow-btn.prev { left: -34px; } .prow-btn.next { right: -34px; } .prow-btn { width: 30px; height: 30px; } }
  @media (hover: none), (max-width: 780px) { .prow-btn { display: none; } }
  @media (max-width: 780px) {
    .big { --prow-col: calc((100% - 16px) / 2); }
    .prow-list { grid-auto-columns: var(--col, var(--prow-col, 108px)); gap: var(--gap, 12px); }
  }
</style>

<script>
  // Whole posters only. For each row: how many fit across (n), then --col and --gap so those n fill the row exactly.
  // Every poster then starts at a multiple of one step (poster + gap), so snapping, the arrows and the last set all land on whole posters.
  const reduce = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const PAD = 4; // 2px of padding at each side of the list
  type Fit = { n: number; step: number };
  const fits = new WeakMap<Element, Fit>();
  function layout(list: HTMLElement) {
    const row = list.closest<HTMLElement>('[data-prow]');
    if (!row) return;
    const W = list.clientWidth - PAD;
    if (W <= 0) return;
    const phone = window.matchMedia('(max-width: 780px)').matches;
    const kind = row.dataset.kind;
    const count = list.children.length;
    let n: number, gap: number, col: number;
    if (kind === 'big') {
      n = window.innerWidth <= 780 ? 2 : window.innerWidth <= 1000 ? 3 : 4;
      gap = phone ? 12 : 20;
    } else {
      const min = kind === 'text' ? 290 : phone ? (W < 480 ? 104 : 132) : 152;
      const gmin = phone ? 12 : 20, gmax = phone ? 18 : 32;
      n = Math.max(1, Math.floor((W + gmin) / (min + gmin)));
      gap = n > 1 ? Math.min(gmax, Math.max(gmin, (W - n * min) / (n - 1))) : gmin;
    }
    n = Math.max(1, Math.min(n, count || 1));
    col = Math.floor(((W - (n - 1) * gap) / n) * 100) / 100;
    gap = n > 1 ? Math.floor(((W - n * col) / (n - 1)) * 100) / 100 : gap;
    list.style.setProperty('--col', col + 'px');
    list.style.setProperty('--gap', gap + 'px');
    fits.set(list, { n, step: col + gap });
    sync(list);
  }
  function sync(list: Element) {
    const row = list.closest('.prow');
    if (!row) return;
    const [back, fwd] = row.querySelectorAll<HTMLButtonElement>('[data-row]');
    const el = list as HTMLElement;
    if (back) back.disabled = el.scrollLeft <= 4;
    if (fwd) fwd.disabled = el.scrollLeft + el.clientWidth >= el.scrollWidth - 4;
  }
  const maxScroll = (el: HTMLElement) => el.scrollWidth - el.clientWidth;
  // scroll to a whole-poster position (a multiple of the step, or the very end)
  function goTo(list: HTMLElement, left: number) {
    list.scrollTo({ left: Math.max(0, Math.min(left, maxScroll(list))), behavior: reduce() ? 'auto' : 'smooth' });
  }
  document.addEventListener('click', (ev) => {
    const btn = (ev.target as Element).closest<HTMLButtonElement>('[data-row]');
    if (!btn) return;
    const list = btn.closest('.prow')?.querySelector<HTMLElement>('[data-row-list]');
    const f = list && fits.get(list);
    if (!list || !f) return;
    const at = Math.round(list.scrollLeft / f.step) * f.step;
    goTo(list, at + Number(btn.dataset.row) * f.n * f.step);
  });
  // tabbing to a poster that is off to the side brings its whole set into view
  document.addEventListener('focusin', (ev) => {
    const li = (ev.target as Element).closest?.('[data-row-list] > li');
    const list = li?.parentElement as HTMLElement | null;
    const f = list && fits.get(list);
    if (!li || !list || !f) return;
    const i = [...list.children].indexOf(li);
    const first = Math.round(list.scrollLeft / f.step);
    if (i < first || i >= first + f.n) goTo(list, Math.floor(i / f.n) * f.n * f.step);
  });
  document.addEventListener('scroll', (ev) => { const t = ev.target as Element; if (t instanceof Element && t.matches('[data-row-list]')) sync(t); }, true);
  const all = () => document.querySelectorAll<HTMLElement>('[data-row-list]').forEach(layout);
  document.addEventListener('astro:page-load', () => {
    all();
    // rows can appear later (they stream in), and a row can change width without the window resizing
    const ro = ((window as any).__prowRO ??= new ResizeObserver((es) => es.forEach((e) => layout(e.target as HTMLElement))));
    document.querySelectorAll('[data-row-list]').forEach((l) => ro.observe(l));
  });
  window.addEventListener('resize', all);
</script>
