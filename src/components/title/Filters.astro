---
// The filter bar on Films and Books: each choice reloads the list, and the address keeps them all.
// A field with `clears` resets the named fields to Any when it changes (choosing a list resets the filters that don't apply to it).
// A change keeps the page where it is: no jump to the top and no loader flash (see Base.astro).
interface Props { fields: { name: string; label: string; value: string; options: [string, string][]; clears?: string[] }[]; keep?: Record<string, string> }
const { fields, keep = {} } = Astro.props;
---
<form class="filters" method="get" data-filters>
  {Object.entries(keep).map(([k, v]) => <input type="hidden" name={k} value={v} />)}
  {fields.map((f) => (
    <label class:list={['fl', f.value && 'on']}>
      <span class="sr">{f.label}</span>
      <select name={f.name} data-clears={f.clears?.join(',')}>
        {f.options.map(([v, t]) => <option value={v} selected={v === f.value}>{t}</option>)}
      </select>
    </label>
  ))}
  <noscript><button class="btn" type="submit">Show</button></noscript>
  <a href={Astro.url.pathname + (keep.kind ? `?kind=${keep.kind}` : '')} class="clear" hidden={!fields.some((f) => f.value && f.name !== 'sort')}>Clear</a>
</form>
<style>
  .filters { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .fl select { height: 38px; padding: 0 34px 0 14px; border-radius: 19px; border: 1px solid var(--line); background-color: var(--card); color: var(--ink); font: inherit; font-size: 13.5px; font-weight: 600; cursor: pointer; transition: border-color .2s ease; }
  .fl select:hover { border-color: var(--lat); }
  .fl.on select { border-color: var(--lat); color: var(--lat); }
  .clear { font-size: 13px; font-weight: 600; color: var(--muted); padding: 0 6px; }
  .clear:hover { color: var(--lat); }
  /* on a phone the choices sit in one line that scrolls sideways, so the list starts sooner */
  @media (max-width: 780px) {
    .filters { position: relative; flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; margin-inline: calc(var(--gut, 20px) * -1); padding: 2px var(--gut, 20px); width: calc(100% + var(--gut, 20px) * 2); }
    .filters::-webkit-scrollbar { display: none; }
    .fl, .clear { flex: none; }
  }
</style>
<script>
  document.addEventListener('change', (ev) => {
    const sel = (ev.target as Element).closest('select');
    const form = sel?.closest<HTMLFormElement>('[data-filters]');
    if (!sel || !form) return;
    for (const n of (sel.dataset.clears ?? '').split(',').filter(Boolean)) {
      const el = form.elements.namedItem(n);
      if (el instanceof HTMLSelectElement) el.value = '';
    }
    (window as any).__keepPlace = scrollY; // Base.astro puts the page back where it was
    setTimeout(() => { (window as any).__keepPlace = null; }, 15000); // in case the visit never happens
    form.requestSubmit();
  });
  // drop empty choices from the address, so it stays short
  document.addEventListener('submit', (ev) => {
    const f = ev.target as HTMLFormElement;
    if (!f.matches('[data-filters]')) return;
    f.querySelectorAll<HTMLSelectElement | HTMLInputElement>('select, input[type=hidden]').forEach((el) => { el.disabled = !el.value; });
    setTimeout(() => f.querySelectorAll<HTMLSelectElement | HTMLInputElement>('select, input').forEach((el) => (el.disabled = false)), 0);
  }, true);
</script>
