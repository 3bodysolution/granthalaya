---
// The log panel on a film, TV or book page: save it, mark it, rate it, write about it, put it in a collection.
// Works before the title is in our catalogue: the first action sends `hit` and the server adds it.
// For TV, each season is logged on its own, so there's one panel body per season and a picker.
import Mark from './ui/Mark.astro';
import BookOpen from '@tabler/icons/outline/book-2.svg';
import Play from '@tabler/icons/outline/player-play.svg';
import Pause from '@tabler/icons/outline/player-pause.svg';
import Check from '@tabler/icons/outline/circle-check.svg';
import XIcon from '@tabler/icons/outline/circle-x.svg';
import Notes from '@tabler/icons/outline/notes.svg';
import Repeat from '@tabler/icons/outline/repeat.svg';
import Share from '@tabler/icons/outline/share.svg';
import Stack from '@tabler/icons/outline/stack-2.svg';
import Eye from '@tabler/icons/outline/eye.svg';
import { STATUSES, statusLabel, type Kind, type Status } from '../lib/kinds';
import type { OnSite } from '../lib/catalog/onsite';

type Part = { key: string; label?: string; hit: Record<string, unknown>; titleId?: string; mine?: OnSite['mine'][number] };
interface Props { kind: Exclude<Kind, 'essay'>; parts: Part[]; selected?: string; share: string; what: string }
const { kind, parts, selected, share, what } = Astro.props;
const me = Astro.locals.me;
const ICON: Record<Status, any> = { want: null, reading: BookOpen, watching: Play, done: Check, paused: Pause, dnf: XIcon, dropped: XIcon };
const pick = selected ?? parts[0]?.key;
const next = `/signin/?next=${encodeURIComponent(Astro.url.pathname)}`;
const film = kind !== 'book';
// the share window: the public page's address and picture, and (signed in) your entry's story card
const preview = new URL(share).pathname.replace(/^\/(film|tv|book)\/([^/]+)\/?$/, '/og/$1/$2.png');
const stories = me ? Object.fromEntries(parts.filter((p) => p.mine).map((p) => [p.key, { user: me.username, slug: p.mine!.slug }])) : undefined;
const shareData = JSON.stringify({ url: share, title: what, preview, stories });
---
<aside class="logpanel" aria-label={me ? 'Your log' : 'Keep your own shelf'}>
  {!me ? (
    <>
      <a class="lp-row lp-signin" href={next} data-astro-prefetch="false"><span>Sign in to log, rate or save</span></a>
      <button class="lp-row" type="button" data-share={shareData}><Share aria-hidden="true" /><span>Share</span></button>
    </>
  ) : (
    <>
      {parts.length > 1 && (
        <label class="lp-season">
          <span class="sr">Season</span>
          <select data-season-pick>{parts.map((p) => <option value={p.key} selected={p.key === pick}>{p.label}</option>)}</select>
        </label>
      )}
      {parts.map((p) => {
        const m = p.mine;
        const src = p.titleId ? { title: p.titleId } : { hit: p.hit };
        const rating = m?.rating ?? 0;
        return (
          <div class="lp-body" data-season-panel={p.key} hidden={p.key !== pick}>
            <div class="lp-status" role="group" aria-label="Status">
              {STATUSES[kind].map(([k, label]) => {
                const I = ICON[k];
                const on = m?.status === k;
                const attrs = m
                  ? { 'data-set-status': JSON.stringify({ id: m.id, status: k }), 'data-bare': m.bare ? '1' : '0' }
                  : k === 'want' ? { 'data-quick-add': JSON.stringify({ ...src, status: 'want' }), 'data-saved-label': 'Saved' } : { 'data-log-new': JSON.stringify({ ...src, status: k }) };
                return <button class="tg" type="button" aria-pressed={on ? 'true' : 'false'} {...attrs}>{I ? <I aria-hidden="true" /> : <Mark size={24} />}<span data-label>{label}</span></button>;
              })}
            </div>
            <div class="lp-rate">
              <span class="lp-k">{rating ? 'Rated' : 'Rate'}</span>
              <div class="stars-in" role="radiogroup" aria-label="Your rating" data-rating={rating} data-rate-src={JSON.stringify(m ? { id: m.id } : src)}>
                {[1, 2, 3, 4, 5].map((n) => (
                  <span class="st">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path class="bg" d="M12 2.8l2.8 5.9 6.4.8-4.7 4.4 1.2 6.4L12 17.2l-5.7 3.1 1.2-6.4-4.7-4.4 6.4-.8z" /><path class="fg" d="M12 2.8l2.8 5.9 6.4.8-4.7 4.4 1.2 6.4L12 17.2l-5.7 3.1 1.2-6.4-4.7-4.4 6.4-.8z" /></svg>
                    <button type="button" class="half l" role="radio" aria-checked={rating === n - 0.5 ? 'true' : 'false'} aria-label={`${n - 0.5} stars`} data-rate={n - 0.5}></button>
                    <button type="button" class="half r" role="radio" aria-checked={rating === n ? 'true' : 'false'} aria-label={`${n} star${n > 1 ? 's' : ''}`} data-rate={n}></button>
                  </span>
                ))}
              </div>
              {rating > 0 && <button type="button" class="lp-clear" data-rate="0" data-rate-for aria-label="Remove rating">×</button>}
            </div>
            {m ? (
              <>
                <a class="lp-row" href={`/@${me.username}/library/${m.slug}/`}><Eye aria-hidden="true" /><span>Your entry | {statusLabel(kind, m.status as Status)}</span></a>
                <a class="lp-row" href={`/add/?log=${m.id}`}><Notes aria-hidden="true" /><span>Notes, lines and dates</span></a>
                {m.status === 'done' && <a class="lp-row" href={`/add/?title=${m.titleId}&again=1`}><Repeat aria-hidden="true" /><span>{film ? 'Watch it again' : 'Read it again'}</span></a>}
              </>
            ) : (
              <button class="lp-row" type="button" data-write={JSON.stringify(src)}><Notes aria-hidden="true" /><span>Log with a note or a line</span></button>
            )}
            <button class="lp-row" type="button" data-collect={JSON.stringify({ ...src, what })}><Stack aria-hidden="true" /><span>Add to a collection</span></button>
          </div>
        );
      })}
      <button class="lp-row" type="button" data-share={shareData}><Share aria-hidden="true" /><span>Share</span></button>
    </>
  )}
</aside>

<style>
  .logpanel { border-radius: 14px; background: var(--card); border: 1px solid var(--line); overflow: hidden; align-self: stretch; box-shadow: 0 12px 24px -16px var(--shadow); }
  .lp-season { display: block; padding: 12px 12px 0; }
  .lp-season select { width: 100%; height: 40px; padding: 0 12px; border-radius: 10px; border: 1px solid var(--line); background-color: var(--soft); color: var(--ink); font: inherit; font-size: 14px; font-weight: 600; }
  .lp-status { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 6px 2px; padding: 12px 6px; border-bottom: 1px solid var(--line); }
  .tg { display: flex; flex-direction: column; align-items: center; gap: 6px; min-height: 64px; padding: 6px 4px; border: 0; border-radius: 10px; background: none; color: var(--muted); font-size: 12px; font-weight: 600; line-height: 1.2; text-align: center; cursor: pointer; transition: background-color .2s ease, color .2s ease, transform .25s var(--spring); }
  .tg:hover { background: var(--soft); color: var(--ink); }
  .tg:active { transform: scale(.96); }
  .tg :global(svg) { width: 24px; height: 24px; stroke-width: 1.8; }
  .tg[aria-pressed="true"], .tg:global(.is-saved) { color: var(--lat); }
  .tg:disabled { cursor: default; }
  .lp-rate { display: flex; align-items: center; gap: 10px; padding: 12px 16px; border-bottom: 1px solid var(--line); }
  .lp-k { font-size: 11px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); width: 44px; }
  .stars-in { display: flex; gap: 2px; }
  .st { position: relative; width: 26px; height: 26px; }
  .st svg { width: 26px; height: 26px; display: block; }
  .st .bg { fill: none; stroke: var(--muted); stroke-width: 1.3; opacity: .6; }
  .st .fg { fill: var(--haldi); clip-path: inset(0 100% 0 0); transition: clip-path .15s ease; }
  .st:global(.half) .fg { clip-path: inset(0 50% 0 0); }
  .st:global(.full) .fg { clip-path: inset(0); }
  .st button.half { position: absolute; top: 0; bottom: 0; width: 50%; padding: 0; border: 0; background: transparent; cursor: pointer; }
  .st button.half.l { left: 0; } .st button.half.r { right: 0; }
  .st button.half:focus-visible { outline-offset: 0; }
  .lp-clear { margin-left: auto; width: 28px; height: 28px; border-radius: 50%; border: 0; background: transparent; color: var(--muted); font-size: 17px; cursor: pointer; }
  .lp-clear:hover { background: var(--soft); color: var(--ink); }
  .lp-row { display: flex; align-items: center; gap: 10px; width: 100%; min-height: 46px; padding: 12px 16px; font: inherit; font-size: 14px; color: var(--ink); border: 0; border-bottom: 1px solid var(--line); background: none; text-align: left; cursor: pointer; transition: background-color .2s ease; }
  .logpanel > .lp-row:last-child { border-bottom: 0; }
  .lp-row:hover { background: var(--soft); color: var(--ink); }
  .lp-row :global(svg) { width: 17px; height: 17px; color: var(--muted); flex: none; }
  .lp-signin { justify-content: center; font-weight: 600; background: var(--ink); color: var(--bg); }
  .lp-signin:hover { background: var(--lat); color: var(--bg); }
</style>
