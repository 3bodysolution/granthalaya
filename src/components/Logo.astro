---
// The mark: a bookmark that is also a strip of film. Drawn in the accent colour; the holes are cut through.
import { MARK_PATH } from '../lib/mark';
interface Props { size?: number }
const { size = 30 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 100 100" aria-hidden="true" class="mark">
  <path fill-rule="evenodd" style="fill: var(--lat)" d={MARK_PATH} />
</svg>
