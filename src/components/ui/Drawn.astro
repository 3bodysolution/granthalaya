---
// The "Drawn" loader: the outline traces itself, fills in with its holes, fades, and starts again.
// Still (just the mark) when someone prefers reduced motion.
import { MARK_BODY, MARK_PATH } from '../../lib/mark';
interface Props { size?: number; class?: string }
const { size = 48, class: cls } = Astro.props;
---
<svg class:list={['drawn', cls]} width={size} height={size} viewBox="0 0 100 100" aria-hidden="true">
  <path class="dr-fill" fill-rule="evenodd" d={MARK_PATH} />
  <path class="dr-edge" d={MARK_BODY} pathLength="100" />
</svg>
