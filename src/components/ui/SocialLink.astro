---
import { siInstagram, siX, siLetterboxd, siGoodreads, siSubstack } from 'simple-icons';
import World from '@tabler/icons/outline/world.svg';
interface Props { kind: 'instagram' | 'x' | 'letterboxd' | 'goodreads' | 'substack' | 'website'; href?: string; label?: string; bare?: boolean }
const { kind, href = '#', label, bare = false } = Astro.props;
const icons: Record<string, { path: string; title: string }> = { instagram: siInstagram, x: siX, letterboxd: siLetterboxd, goodreads: siGoodreads, substack: siSubstack };
const ic = icons[kind];
const name = label ?? (ic ? ic.title : 'Website');
---
<a href={href} class:list={[bare ? "inline-flex items-center gap-1.5 text-[14px] text-muted-foreground hover:text-primary transition-colors" : "inline-flex items-center gap-1.5 h-8 px-3 rounded-full border border-border bg-card/80 backdrop-blur text-[13px] font-medium text-foreground hover:border-primary hover:text-primary transition-colors"]} aria-label={name}>
  {ic ? <svg viewBox="0 0 24 24" class="size-3.5" fill="currentColor" aria-hidden="true"><path d={ic.path} /></svg> : <World class="size-3.5" />}
  <span>{name}</span>
</a>
